def search_reminders(paths, list_name=None, text=None, open_only=False, limit=DEFAULT_LIMIT) -> List[dict]:
    if not (list_name or text or open_only):
        raise UsageError("reminders needs at least one of --list, --text, --open-only")
    sql = ("SELECT r.Z_PK AS id, r.ZTITLE, r.ZNOTES, r.ZCOMPLETED, r.ZCOMPLETIONDATE, r.ZDUEDATE, r.ZALLDAY, "
           "r.ZPRIORITY, r.ZFLAGGED, l.ZNAME AS list_name "
           "FROM ZREMCDREMINDER r LEFT JOIN ZREMCDBASELIST l ON l.Z_PK=r.ZLIST "
           "WHERE COALESCE(r.ZMARKEDFORDELETION,0)=0")
    args: list = []
    if open_only:
        sql += " AND COALESCE(r.ZCOMPLETED,0)=0"
    if list_name:
        sql += " AND l.ZNAME LIKE ? ESCAPE '\\'"
        args.append("%" + list_name.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%")
    rows: List[dict] = []
    for path in paths:
        con = open_ro(path)
        try:
            if "ZREMCDREMINDER" not in _tables(con):
                continue
            for r in con.execute(sql, args):
                rows.append({
                    "id": r["id"],
                    "title": r["ZTITLE"],
                    "list": r["list_name"],
                    "done": bool(r["ZCOMPLETED"]),
                    "due": fmt_when(r["ZDUEDATE"], bool(r["ZALLDAY"])) if r["ZDUEDATE"] is not None else None,
                    "completed_on": fmt_when(r["ZCOMPLETIONDATE"]) if r["ZCOMPLETIONDATE"] is not None else None,
                    "priority": r["ZPRIORITY"] or 0,
                    "flagged": bool(r["ZFLAGGED"]),
                    "notes": clip(r["ZNOTES"]),
                    "_due": r["ZDUEDATE"],
                })
        finally:
            con.close()
    if text:
        n = fold(text)
        rows = [x for x in rows if n in fold(x["title"]) or n in fold(x["notes"])]
    # open ones by due date (undated last); completed after
    rows.sort(key=lambda x: (x["done"], x["_due"] is None, x["_due"] or 0))
    for x in rows:
        x.pop("_due")
    return rows[:limit]


