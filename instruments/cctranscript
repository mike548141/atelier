#!/usr/bin/env node
/*
 * cctranscript — render a timestamped transcript of a Claude Code session.
 *
 * The VS Code chat panel (and the terminal UI) don't show per-message
 * timestamps, but every message is timestamped in the session's raw .jsonl log
 * under ~/.claude/projects/<encoded-repo-path>/<session-uuid>.jsonl. This reads
 * that log and prints who said what and when — your prompts and Claude's
 * replies — with elapsed deltas between turns.
 *
 * The human view is iMessage-style: your prompts mirror to the right, Claude's
 * replies sit on the left with a per-message model tag (coloured by model, so a
 * mid-session switch is visible). A full-width numbered rule opens each exchange
 * (one of your prompts + all the replies to it), so a long transcript scans as
 * sections, and each of Claude's text replies to prompt N carries a citable
 * reference N.M (M resets per prompt; thinking/tool turns aren't numbered —
 * the citable unit is what a human quotes). --json carries the same refs. Each turn's body is grouped under a coloured bar, word-wrapped to
 * the terminal, with light markdown (bold, inline code, headings, lists, links).
 * Colour auto-disables when piped; --json is the machine format, never styled.
 *
 * The summary line under the header also reports how big the context grew —
 * the peak of (input + cache_creation + cache_read) across the session's
 * requests, since a cached prefix still occupies the window. --json carries the
 * peak and the final size separately; they diverge when a session was compacted.
 * Sessions that spawned subagents carry a count of them too, read from the spawn
 * tool calls (so it's a ceiling: agents started, not agents finished).
 *
 * By default it reads the live logs, which Claude Code prunes after
 * `cleanupPeriodDays`. --from-archive points every view at the compressed mirror
 * ccarchive(1) maintains instead — same discovery, same rendering, reading
 * <dest>/<encoded-repo>/<uuid>.jsonl.gz — so a session the cleanup has already
 * deleted can still be listed and rendered. An explicit path to a .jsonl.gz
 * needs no flag at all. Listing never reads an iCloud-evicted mirror (that
 * would fault the bytes back down); rendering one chosen session may.
 *
 * The .jsonl schema is internal to Claude Code and can shift between releases;
 * if a field moves this may need a nudge.
 */
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const zlib = require('node:zlib');
const { execFileSync } = require('node:child_process');

const argv = process.argv.slice(2);

const HELP = `cctranscript — timestamped transcript of a Claude Code session

USAGE
  cctranscript [options] [session]

  session   A UUID, a .jsonl or .jsonl.gz path, or omitted (latest for this repo).

OPTIONS
  --from-archive   Read from the ccarchive archive; --dest <dir> sets where.
  --repo <name>    Use sessions from the named repo (its folder basename).
  --list           List sessions for the repo and exit (with --repo or --all).
  --all            With --list, list sessions across all repos.
  -n, --last <k>   Use the k-th most recent session (1 = latest, the default).
  --tools          Include tool calls and their results (summarised).
  --think          Include Claude's thinking blocks.
  --full           Everything: prompts, replies, thinking, tools.
  --utc            Timestamps in UTC (default: your local timezone).
  --no-delta       Hide the elapsed-time deltas between messages.
  --width <n>      Wrap width (default: terminal width, capped at 100).
  --color          Force ANSI colour; --no-color disables it (auto by default).
  --json           Machine-readable array of turns (never styled).
  -h, --help       Show this help.

Each turn timestamped, from the live logs or ccarchive's mirror.  man cctranscript`;

function takeValue(flag) {
  const i = argv.indexOf(flag);
  return i !== -1 ? argv[i + 1] : null;
}

const asJson = argv.includes('--json');
const doList = argv.includes('--list');
const listAll = argv.includes('--all');
const showTools = argv.includes('--tools') || argv.includes('--full');
const showThink = argv.includes('--think') || argv.includes('--full');
const useUtc = argv.includes('--utc');
const showDelta = !argv.includes('--no-delta');
const repoArg = takeValue('--repo');
const lastArg = argv.includes('-n') ? takeValue('-n') : takeValue('--last');
const lastK = lastArg ? Math.max(1, parseInt(lastArg, 10) || 1) : 1;
// --from-archive reads the compressed mirror ccarchive maintains instead of the
// live logs. --dest names that archive, so it implies --from-archive on its own.
const destArg = takeValue('--dest');
const archiveMode = argv.includes('--from-archive') || destArg !== null;

// Colour: explicit flag wins; else on when stdout is a TTY and NO_COLOR is
// unset. FORCE_COLOR forces it on. Never colour --json (it's a data format).
const colorFlag = argv.includes('--no-color') ? false : argv.includes('--color') ? true : null;
const useColor = asJson ? false : colorFlag !== null ? colorFlag
  : (!!process.env.FORCE_COLOR || (process.stdout.isTTY && !process.env.NO_COLOR));

// Wrap width: explicit --width, else the terminal's, capped to a readable 100.
const widthArg = takeValue('--width');
const termCols = widthArg ? parseInt(widthArg, 10) : (process.stdout.columns || 100);
const TW = Math.max(40, Math.min(termCols || 100, 100)); // total column budget
const CW = TW - 4;                                       // body width inside the bar

// Flags that consume the following token, so we don't mistake a value for the
// positional session argument.
const OWN_WITH_VALUE = new Set(['--repo', '-n', '--last', '--width', '--dest']);
const OWN_BARE = new Set([
  '--json', '--list', '--all', '--tools', '--think', '--full', '--from-archive',
  '--utc', '--no-delta', '--color', '--no-color', '-h', '--help',
]);
let positional = null;
for (let i = 0; i < argv.length; i++) {
  if (OWN_WITH_VALUE.has(argv[i])) { i++; continue; }
  if (OWN_BARE.has(argv[i])) continue;
  if (positional === null) positional = argv[i];
}

const projectsDir = path.join(os.homedir(), '.claude', 'projects');

// Where the ccarchive mirror lives. Resolution mirrors ccarchive exactly
// (--dest, then $CCARCHIVE_DEST, then the iCloud Drive default) so the same
// words point both tools at the same archive.
function defaultArchiveDest(home) {
  return path.join(home, 'Library', 'Mobile Documents', 'com~apple~CloudDocs', 'cc-transcripts');
}
function archiveRoot() {
  return destArg || process.env.CCARCHIVE_DEST || defaultArchiveDest(os.homedir());
}

// iCloud's "Optimise Mac Storage" can evict an archived .gz to a dataless
// placeholder; *reading* one faults the bytes back down. Rendering one chosen
// transcript may deliberately do that; a --list sweep (which peeks inside every
// candidate for its cwd and first prompt) must not bulk-download the archive,
// so listing skips reading any dataless file. Ported from ccarchive — same
// SF_DATALESS signal, same CCARCHIVE_SIMULATE_DATALESS test seam; its comments
// hold the full why (stat is metadata-only and never faults a file back).
const SF_DATALESS = 0x40000000;
function isDatalessFlags(flags) {
  return Number.isFinite(flags) && (flags & SF_DATALESS) !== 0;
}
function statFlags(p) {
  if (process.platform !== 'darwin') return null;
  try {
    const n = Number(execFileSync('stat', ['-f', '%f', p], { encoding: 'utf8' }).trim());
    return Number.isFinite(n) ? n : null;
  } catch { return null; }
}
function isDataless(p) {
  const sim = process.env.CCARCHIVE_SIMULATE_DATALESS;
  if (sim) return sim.split(',').some((s) => s !== '' && p.includes(s));
  const flags = statFlags(p);
  return flags === null ? false : isDatalessFlags(flags);
}

// Read a log's full text, transparently gunzipping an archived .gz mirror —
// every parser above this line stays blind to which store the bytes came from.
function readLogText(file) {
  const raw = fs.readFileSync(file);
  return file.endsWith('.gz') ? zlib.gunzipSync(raw).toString('utf8') : raw.toString('utf8');
}

// Read the true cwd from the first log line that records one. Claude's folder
// names dash-mangle every separator alike and can't be reversed, so we recover
// the exact repo path (and hence basename) from inside the log. Mirrors ccrepo.
function cwdFromLog(file) {
  let chunk;
  try {
    if (file.endsWith('.gz')) {
      // gzip has no cheap partial read; these logs are small enough that a
      // full gunzip for the 64 KB cwd sniff is fine.
      chunk = zlib.gunzipSync(fs.readFileSync(file)).toString('utf8', 0, 65536);
    } else {
      const fd = fs.openSync(file, 'r');
      const buf = Buffer.alloc(65536);
      const n = fs.readSync(fd, buf, 0, buf.length, 0);
      fs.closeSync(fd);
      chunk = buf.toString('utf8', 0, n);
    }
  } catch { return null; }
  const m = chunk.match(/"cwd"\s*:\s*"((?:[^"\\]|\\.)*)"/);
  if (!m) return null;
  try { return JSON.parse(`"${m[1]}"`); } catch { return null; }
}

// Encode a filesystem path the way Claude names its project folders: every run
// of non-alphanumerics collapses to single dashes. Used to find the current
// repo's folder directly from process.cwd().
function encodePath(p) {
  return p.replace(/[^A-Za-z0-9]+/g, '-');
}

function isDir(p) {
  try { return fs.statSync(p).isDirectory(); } catch { return false; }
}

// The one session record constructor: { file, id, repoDir, cwd, label, mtime }.
// Used for walked logs and explicitly-pathed ones alike, so the label fallback
// and the mtime stat can't diverge between routes. repoDir is null for an
// explicit path (it may live outside ~/.claude/projects/).
function sessionRecord(full, repoDir) {
  let mtime = 0;
  try { mtime = fs.statSync(full).mtimeMs; } catch {}
  // An evicted archive mirror is never read just to label a listing — that
  // would fault its bytes back from iCloud. The label falls back to the last
  // dash-segment of the folder name (lossy, but honest about what's local).
  const evicted = full.endsWith('.gz') && isDataless(full);
  const cwd = evicted ? null : cwdFromLog(full);
  return {
    file: full,
    id: path.basename(full).replace(/\.jsonl(\.gz)?$/, ''),
    repoDir,
    cwd,
    label: cwd ? path.basename(cwd)
      : repoDir ? repoDir.split('-').filter(Boolean).pop() || repoDir : '',
    mtime,
    evicted,
  };
}

// All session logs across all repos — one shape, from whichever store is live
// for this invocation.
function allSessions() {
  return archiveMode ? archiveSessions() : liveSessions();
}

function liveSessions() {
  const out = [];
  let repos;
  try { repos = fs.readdirSync(projectsDir); } catch { return out; }
  for (const repoDir of repos) {
    const dir = path.join(projectsDir, repoDir);
    if (!isDir(dir)) continue;
    for (const file of fs.readdirSync(dir)) {
      if (!file.endsWith('.jsonl')) continue;
      out.push(sessionRecord(path.join(dir, file), repoDir));
    }
  }
  return out;
}

// Sessions in a ccarchive mirror: <dest>/<repoDir>/<uuid>.jsonl.gz — the same
// one-level shape as the live store (nested subagent logs and tool-result
// sidecars aren't sessions in either). _external/ is ccarchive's reserved home
// for the archived history.jsonl, not a repo folder — skipped.
function archiveSessions() {
  const out = [];
  const root = archiveRoot();
  let repos;
  try { repos = fs.readdirSync(root); } catch { return out; }
  for (const repoDir of repos) {
    if (repoDir === '_external') continue;
    const dir = path.join(root, repoDir);
    if (!isDir(dir)) continue;
    for (const file of fs.readdirSync(dir)) {
      if (!file.endsWith('.jsonl.gz')) continue;
      out.push(sessionRecord(path.join(dir, file), repoDir));
    }
  }
  return out;
}

// Resolve which repo folder the current directory maps to. Prefer the direct
// path encoding; fall back to matching a log's recorded cwd to process.cwd().
function currentRepoDir() {
  const guess = encodePath(process.cwd());
  if (isDir(path.join(archiveMode ? archiveRoot() : projectsDir, guess))) return guess;
  const here = process.cwd();
  for (const s of allSessions()) {
    if (s.cwd === here) return s.repoDir;
  }
  return null;
}

// The header for a real user prompt vs a tool-result carrier: prompts have no
// toolUseResult and carry actual authored text.
function firstUserPromptText(file) {
  const lines = readLogText(file).split('\n');
  for (const ln of lines) {
    if (!ln.trim()) continue;
    let o; try { o = JSON.parse(ln); } catch { continue; }
    if (o.type === 'user' && !o.toolUseResult) {
      const t = extractText(o.message && o.message.content);
      if (t) return t.replace(/\s+/g, ' ').trim();
    }
  }
  return '';
}

// Pull concatenated text from a message.content that may be a string or an
// array of typed blocks.
function extractText(content) {
  if (typeof content === 'string') return content;
  if (!Array.isArray(content)) return '';
  return content.filter((b) => b && b.type === 'text').map((b) => b.text).join('\n');
}

// `utc` defaults to the --utc global; passed explicitly by tests. Same output
// as before for every real caller (which relies on the default).
const fmtTime = (iso, utc = useUtc) => {
  if (!iso) return '        ';
  const d = new Date(iso);
  if (isNaN(d)) return '        ';
  if (utc) return d.toISOString().slice(11, 19);
  return d.toLocaleTimeString('en-NZ', { hour12: false });
};
const dateOf = (iso, utc = useUtc) => {
  if (!iso) return '';
  const d = new Date(iso);
  if (isNaN(d)) return '';
  return utc ? d.toISOString().slice(0, 10) : d.toLocaleDateString('en-CA');
};
// Compact human duration; `signed` prefixes a '+' (for inter-turn deltas).
function humanDelta(ms, signed = true) {
  const sign = signed ? '+' : '';
  if (ms < 1000) return `${sign}${ms}ms`;
  const s = Math.round(ms / 1000);
  if (s < 60) return `${sign}${s}s`;
  const m = Math.floor(s / 60), rs = s % 60;
  if (m < 60) return rs ? `${sign}${m}m${rs}s` : `${sign}${m}m`;
  const h = Math.floor(m / 60), rm = m % 60;
  return rm ? `${sign}${h}h${rm}m` : `${sign}${h}h`;
}

// Token counts for a header chip: abbreviated so the magnitude lands at a
// glance (8.5k, 477k, 1.2M) rather than as a wall of digits. Whole thousands
// from 10k up — at that size the hundreds digit tells you nothing.
function fmtTokens(n) {
  if (!Number.isFinite(n) || n <= 0) return null;
  if (n >= 1e6) return `${(n / 1e6).toFixed(1)}M`;
  if (n >= 1e4) return `${Math.round(n / 1e3)}k`;
  if (n >= 1e3) return `${(n / 1e3).toFixed(1)}k`;
  return String(n);
}

// Summarise a tool_use block's input to a single short line.
function toolSummary(name, input) {
  if (!input || typeof input !== 'object') return name;
  const keys = ['command', 'file_path', 'path', 'pattern', 'query', 'prompt', 'description', 'url'];
  for (const k of keys) {
    if (typeof input[k] === 'string' && input[k].trim()) {
      let v = input[k].replace(/\s+/g, ' ').trim();
      if (v.length > 80) v = v.slice(0, 77) + '…';
      return `${name}  ${v}`;
    }
  }
  return name;
}

// Context size at the moment of one request: everything the model was sent,
// however it was billed. Cached prefix (cache_read) and freshly-cached blocks
// (cache_creation) are *in* the window — counting input_tokens alone reads a
// long session as tiny, because almost all of it is served from cache.
function contextOf(usage) {
  if (!usage) return null;
  return (usage.input_tokens || 0)
    + (usage.cache_creation_input_tokens || 0)
    + (usage.cache_read_input_tokens || 0);
}

// Spawning a subagent is a tool call like any other, under whichever name the
// harness of the day used (Agent now, Task in older logs).
const AGENT_TOOLS = new Set(['Agent', 'Task']);

// Build the ordered list of turns from a session log, plus how big the context
// grew and how many subagents were started.
//
// `context.peak` is the high-water mark and `context.final` the last request's
// size; they differ when the session was compacted, where the honest headline
// is the peak (how much the session actually held) rather than what survived
// the compact. Sidechains aren't filtered out: subagents log to their own
// files, so every usage record in one log belongs to the thread that log *is*.
//
// `agents.spawned` counts the spawn *calls*, which is a ceiling on the agents
// that finished — a run the principal skipped or a TaskStop'd one still counts
// here. The stricter count (one log per agent that actually ran) lives in a
// sibling <session-uuid>/subagents/ directory this tool never opens, and
// couldn't: --from-archive resolves a single file, so a directory-sourced count
// would silently read zero there. A ceiling that works in both modes beats an
// exact figure that's honest in only one.
function readTurns(file) {
  const turns = [];
  const context = { peak: 0, final: 0 };
  const agents = { spawned: 0, byType: {} };
  const lines = readLogText(file).split('\n');
  for (const ln of lines) {
    if (!ln.trim()) continue;
    let o; try { o = JSON.parse(ln); } catch { continue; }
    const ts = o.timestamp;

    // Session-level tallies, taken before the view gating below: what the
    // session cost and how wide it ran are facts about the session, not about
    // whether you asked to *see* its thinking or its tool calls.
    if (o.type === 'assistant') {
      const ctx = contextOf(o.message && o.message.usage);
      if (ctx) { context.peak = Math.max(context.peak, ctx); context.final = ctx; }
      for (const b of (o.message && Array.isArray(o.message.content) ? o.message.content : [])) {
        if (b.type !== 'tool_use' || !AGENT_TOOLS.has(b.name)) continue;
        agents.spawned++;
        const kind = (b.input && b.input.subagent_type) || 'unspecified';
        agents.byType[kind] = (agents.byType[kind] || 0) + 1;
      }
    }

    if (o.type === 'user' && !o.toolUseResult) {
      const text = extractText(o.message && o.message.content).trim();
      if (text) turns.push({ role: 'you', ts, text });
    } else if (o.type === 'user' && o.toolUseResult && showTools) {
      let r = o.toolUseResult;
      if (typeof r !== 'string') { try { r = JSON.stringify(r); } catch { r = String(r); } }
      r = r.replace(/\s+/g, ' ').trim();
      if (r.length > 120) r = r.slice(0, 117) + '…';
      turns.push({ role: 'result', ts, text: r });
    } else if (o.type === 'assistant') {
      const content = (o.message && o.message.content) || [];
      const model = friendlyModel(o.message && o.message.model);
      for (const b of Array.isArray(content) ? content : []) {
        if (b.type === 'text' && b.text.trim()) {
          turns.push({ role: 'claude', ts, text: b.text.trim(), model });
        } else if (b.type === 'thinking' && showThink && (b.thinking || '').trim()) {
          turns.push({ role: 'think', ts, text: b.thinking.trim(), model });
        } else if (b.type === 'tool_use' && showTools) {
          turns.push({ role: 'tool', ts, text: toolSummary(b.name, b.input), model });
        }
      }
    }
  }
  return { turns, context, agents };
}

// Number the citable turns in place: each prompt is exchange N (the ▸ N rule),
// each of Claude's *text* replies to it is N.M (M resets per prompt). Thinking
// and tool turns stay unnumbered — the citable unit is what a human quotes.
// A reply arriving before any prompt (e.g. a resumed session) numbers under
// exchange 0, honestly marking that its prompt isn't in this log.
function numberTurns(turns) {
  let n = 0, m = 0;
  for (const t of turns) {
    if (t.role === 'you') { n++; m = 0; t.ref = String(n); }
    else if (t.role === 'claude') { m++; t.ref = `${n}.${m}`; }
  }
  return turns;
}

// --- styling ------------------------------------------------------------

const ESC = {
  reset: '\x1b[0m', bold: '\x1b[1m', dim: '\x1b[2m', italic: '\x1b[3m', ul: '\x1b[4m',
  cyan: '\x1b[96m', green: '\x1b[32m', yellow: '\x1b[33m',
  grey: '\x1b[90m', red: '\x1b[91m', blue: '\x1b[94m', magenta: '\x1b[95m',
};
// Wrap s in ANSI codes, but only when colour is on and codes are non-empty.
// `on` defaults to the resolved global; styleInline passes its own so the
// whole styling path stays colour-pure for the tests.
const paint = (codes, s, on = useColor) => (on && codes) ? codes + s + ESC.reset : s;
// Visible length (ANSI stripped) and right-justify to a column.
const visLen = (s) => s.replace(/\x1b\[[0-9;]*m/g, '').length;
const padLeftTo = (s, width) => { const p = width - visLen(s); return (p > 0 ? ' '.repeat(p) : '') + s; };

// Map a raw model id to a friendly name; null for none/synthetic (no tag shown).
// e.g. claude-opus-4-8 → "Opus 4.8", claude-fable-5 → "Fable 5", fable → "Fable".
function friendlyModel(m) {
  if (!m || m === '<synthetic>') return null;
  const s = m.replace(/^claude-/, '').replace(/-\d{8}$/, ''); // drop prefix + trailing date
  const fam = { opus: 'Opus', sonnet: 'Sonnet', haiku: 'Haiku', fable: 'Fable' };
  const g = s.match(/^(opus|sonnet|haiku|fable)(?:-(\d+))?(?:-(\d+))?/);
  if (!g) return s;
  return fam[g[1]] + (g[2] ? ' ' + g[2] + (g[3] ? '.' + g[3] : '') : '');
}
// Colour the model tag by family, so a mid-session model switch is visible.
function modelColor(friendly) {
  const w = (friendly || '').split(' ')[0].toLowerCase();
  return { opus: ESC.magenta, fable: ESC.blue, sonnet: ESC.cyan, haiku: ESC.yellow }[w] || ESC.grey;
}

const ROLE = {
  you:    { icon: '▸', label: 'You',      color: ESC.cyan },
  claude: { icon: '◂', label: 'Claude',   color: ESC.green },
  think:  { icon: '✱', label: 'thinking', color: ESC.grey },
  tool:   { icon: '⚙', label: 'tool',     color: ESC.blue },
  result: { icon: '⤷', label: 'result',   color: ESC.grey },
};

// Colour an inter-turn delta by magnitude so time sinks are easy to spot.
function deltaStr(ms) {
  const h = humanDelta(ms);
  if (ms >= 600000) return paint(ESC.red, h);    // >= 10m
  if (ms >= 60000) return paint(ESC.yellow, h);  // >= 1m
  return paint(ESC.dim, h);
}

// Light inline markdown: inline code, bold, links. Applied per wrapped line, so
// a span split across a wrap boundary just renders literally (rare, harmless).
// With colour off, markers are cleaned (bold/link) but code keeps its backticks
// so it stays recognisable.
// `color` defaults to the resolved useColor global; tests pass it explicitly.
function styleInline(s, color = useColor) {
  s = s.replace(/`([^`]+)`/g, (_, x) => color ? paint(ESC.yellow, x, color) : '`' + x + '`');
  s = s.replace(/\*\*([^*]+)\*\*/g, (_, x) => paint(ESC.bold, x, color));
  // single-asterisk emphasis, but not a leftover half of a ** pair
  s = s.replace(/\*([^*\s](?:[^*]*[^*\s])?)\*/g, (_, x) => paint(ESC.italic, x, color));
  s = s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_, t, u) => paint(ESC.ul, t, color) + paint(ESC.dim, ' (' + u + ')', color));
  return s;
}

// Word-wrap plain text to width, hard-breaking any token longer than width.
function wrap(s, width) {
  if (width < 8) width = 8;
  const words = s.split(/\s+/).filter(Boolean);
  if (!words.length) return [''];
  const lines = [];
  let cur = '';
  for (let w of words) {
    while (w.length > width) {
      if (cur) { lines.push(cur); cur = ''; }
      lines.push(w.slice(0, width));
      w = w.slice(width);
    }
    if (!cur) cur = w;
    else if (cur.length + 1 + w.length <= width) cur += ' ' + w;
    else { lines.push(cur); cur = w; }
  }
  if (cur) lines.push(cur);
  return lines;
}

// Render a turn's body into output lines. Left turns (Claude, tools) get a
// coloured left bar; right turns (You) are right-justified with the bar on the
// right edge, iMessage-style. Fenced code is kept verbatim (dimmed, unwrapped);
// prose is wrapped; headings, list items and inline markdown are styled.
function renderBody(text, role, width, side) {
  const out = [];
  const barCh = paint(role.color, '│');
  // Emit one body line given its already-styled inner content.
  const emit = (inner) => out.push(
    side === 'right' ? padLeftTo(inner + ' ' + barCh, TW - 1) : ' ' + barCh + ' ' + inner
  );
  const emitEmpty = () => out.push(side === 'right' ? padLeftTo(barCh, TW - 1) : ' ' + barCh);
  let inCode = false;
  for (const raw of text.split('\n')) {
    if (/^\s*```/.test(raw)) {
      inCode = !inCode;
      emit(paint(ESC.grey, raw.trim()));
      continue;
    }
    if (inCode) { emit(paint(ESC.grey, raw)); continue; }
    if (raw.trim() === '') { emitEmpty(); continue; }

    const h = raw.match(/^(#{1,6})\s+(.*)$/);
    if (h) {
      for (const wl of wrap(h[2], width)) emit(paint(ESC.bold, styleInline(wl)));
      continue;
    }
    const li = raw.match(/^(\s*)([-*+]|\d+[.)])\s+(.*)$/);
    if (li) {
      const marker = li[1] + li[2] + ' ';
      const pad = ' '.repeat(marker.length);
      wrap(li[3], width - marker.length).forEach((line, i) => {
        emit((i === 0 ? paint(ESC.dim, marker) : pad) + styleInline(line));
      });
      continue;
    }
    for (const wl of wrap(raw, width)) emit(styleInline(wl));
  }
  return out;
}

// A full-width rule marking the start of an exchange (one of your prompts and
// everything Claude replies to it). Placed only before your turns, so the
// transcript reads as scannable sections; the counter orients you in a long
// scroll and gives each ask a reference number. The label sits on the right,
// tying it to the right-aligned prompt below it.
function exchangeRule(n) {
  const lab = `▸ ${n}`;
  const tail = '──';
  const dashes = Math.max(0, TW - lab.length - tail.length - 2);
  return paint(ESC.dim, '─'.repeat(dashes) + ' ') + paint(ESC.cyan, lab) + paint(ESC.dim, ' ' + tail);
}

// Build a turn's header line: role label (+ N.M ref and model tag for Claude)
// and the timestamp/delta. Right-side turns (You) are mirrored to the right
// margin (their ref is the ▸ N on the exchange rule, not repeated here).
function turnHeader(role, model, time, deltaMs, side, ref) {
  const meta = paint(ESC.dim, time) + (deltaMs != null ? '  ' + deltaStr(deltaMs) : '');
  if (side === 'right') {
    const label = paint(role.color + ESC.bold, `${role.label} ${role.icon}`);
    return padLeftTo(meta + '  ' + label, TW - 1);
  }
  const label = paint(role.color + ESC.bold, `${role.icon} ${role.label}`);
  const refTag = ref ? ' ' + paint(ESC.dim, ref) : '';
  const tag = model ? ' ' + paint(modelColor(model), `(${model})`) : '';
  return ' ' + label + refTag + tag + '  ' + meta;
}

// --- session selection --------------------------------------------------

function pickSessions() {
  // Explicit path? A .jsonl.gz (an archive mirror) routes here with no flag.
  if (positional && (positional.includes('/') || positional.endsWith('.jsonl') || positional.endsWith('.jsonl.gz'))) {
    const p = path.resolve(positional);
    if (!fs.existsSync(p)) { console.error(`No such file: ${p}`); process.exit(1); }
    // Same constructor as the walked routes — recovers cwd/label from the log
    // and stats the real mtime, so an explicit path loses nothing.
    return [sessionRecord(p, null)];
  }
  const sessions = allSessions();
  // Explicit UUID (or prefix)?
  if (positional) {
    const hits = sessions.filter((s) => s.id === positional || s.id.startsWith(positional));
    if (!hits.length) { console.error(`No session matching '${positional}'.`); process.exit(1); }
    hits.sort((a, b) => b.mtime - a.mtime);
    return [hits[0]];
  }
  // By repo (named or current).
  let pool = sessions;
  if (repoArg) {
    // An evicted mirror has no recovered cwd, so its label is the lossy folder
    // tail — match those on the folder name's dash-encoded suffix instead, so
    // eviction never hides a session from --repo. Confined to evicted records:
    // readable logs keep the exact label match.
    pool = sessions.filter((s) => s.label === repoArg || s.repoDir === repoArg
      || (s.evicted && s.repoDir && s.repoDir.endsWith('-' + encodePath(repoArg))));
    if (!pool.length) { console.error(`No sessions for repo '${repoArg}'.`); process.exit(1); }
  } else if (!listAll) {
    const rd = currentRepoDir();
    if (!rd) {
      console.error(archiveMode
        ? `No archived sessions for this directory under ${archiveRoot()}. Pass --repo <name>, a session id, or run ccarchive first.`
        : 'No Claude sessions found for this directory. Pass --repo <name>, a session id, or run from a repo you\'ve used Claude in.');
      process.exit(1);
    }
    pool = sessions.filter((s) => s.repoDir === rd);
  }
  pool.sort((a, b) => b.mtime - a.mtime);
  return pool;
}

// --- output -------------------------------------------------------------

function runList() {
  const pool = pickSessions();
  if (asJson) {
    console.log(JSON.stringify(pool.map((s) => ({
      id: s.id, repo: s.label, cwd: s.cwd,
      lastActivity: s.mtime ? new Date(s.mtime).toISOString() : null,
      // Evicted mirrors are listed but never read: no first prompt to show.
      firstPrompt: s.evicted ? null : firstUserPromptText(s.file),
      ...(s.file.endsWith('.gz') ? { evicted: !!s.evicted } : {}),
    })), null, 2));
    return;
  }
  console.log();
  for (const s of pool) {
    const when = s.mtime ? `${dateOf(new Date(s.mtime).toISOString())} ${fmtTime(new Date(s.mtime).toISOString())}` : '                   ';
    let first;
    if (s.evicted) {
      first = paint(ESC.dim, '(evicted — bytes in iCloud; rendering it fetches them)');
    } else {
      first = firstUserPromptText(s.file);
      if (first.length > 70) first = first.slice(0, 67) + '…';
    }
    const repoTag = listAll || repoArg ? '  ' + paint(ESC.blue, `[${s.label}]`) : '';
    console.log(`  ${paint(ESC.cyan, s.id.slice(0, 8))}  ${paint(ESC.dim, when)}${repoTag}  ${first}`);
  }
  console.log(`\n  ${paint(ESC.dim, `${pool.length} session(s)${archiveMode ? ' · archive' : ''}. Use: cctranscript <id>  or  cctranscript -n <k>`)}\n`);
}

function runTranscript() {
  const pool = pickSessions();
  if (lastK > pool.length) {
    console.error(`Only ${pool.length} session(s) available; can't take #${lastK}.`);
    process.exit(1);
  }
  const chosen = pool[lastK - 1];
  // Judged by the file, not the flag, so an explicit .jsonl.gz path is tagged
  // as archive-sourced too.
  const fromArchive = chosen.file.endsWith('.gz');
  const { turns: read, context, agents } = readTurns(chosen.file);
  const turns = numberTurns(read);

  if (asJson) {
    console.log(JSON.stringify({
      session: chosen.id, repo: chosen.label, cwd: chosen.cwd,
      source: fromArchive ? 'archive' : 'live',
      timezone: useUtc ? 'UTC' : 'local',
      context: { peak: context.peak || null, final: context.final || null },
      agents,
      turns: turns.map((t) => ({ ref: t.ref || null, role: t.role, model: t.model || null, timestamp: t.ts, text: t.text })),
    }, null, 2));
    return;
  }

  if (!turns.length) { console.log('\n  (no renderable turns in this session)\n'); return; }

  // Header: a rule with the session identity, then a one-line summary.
  const startDate = dateOf(turns[0].ts);
  const stamped = turns.filter((t) => t.ts);
  const first = stamped[0] && stamped[0].ts;
  const last = stamped.length ? stamped[stamped.length - 1].ts : first;
  const title = `Session ${chosen.id.slice(0, 8)} · ${chosen.label || 'unknown repo'} · ${startDate}${useUtc ? ' UTC' : ''}${fromArchive ? ' · archive' : ''}`;
  const fill = Math.max(0, TW - title.length - 4);
  console.log();
  console.log(paint(ESC.grey, '━━ ') + paint(ESC.bold, title) + ' ' + paint(ESC.grey, '━'.repeat(fill)));

  const count = (r) => turns.filter((t) => t.role === r).length;
  const parts = [`${turns.length} turns`, `${count('you')} you`, `${count('claude')} Claude`];
  if (showThink && count('think')) parts.push(`${count('think')} thinking`);
  if (showTools && count('tool')) parts.push(`${count('tool')} tool`);
  // How wide the session ran — always reported, including "0 agents". The line
  // is read by comparing sessions against each other, and a chip that vanishes
  // at zero makes two headers line up differently for the reader to reconcile;
  // a stated zero is a fact, and an absent chip is only ambiguity. (Mike's call,
  // 2026-07-26, reversing an omit-at-zero default on exactly that ground.)
  parts.push(`${agents.spawned} agent${agents.spawned === 1 ? '' : 's'}`);
  // The context chip is the other case, and stays conditional: a log with no
  // usage records leaves the size *unknown*, which "0" would misreport. Known
  // zero is printed; unknown is omitted.
  const ctxChip = fmtTokens(context.peak);
  if (ctxChip) parts.push(`${ctxChip} context`);
  if (first && last) {
    parts.push(`${fmtTime(first)}–${fmtTime(last)}`);
    const span = new Date(last) - new Date(first);
    if (span > 0) parts.push(humanDelta(span, false));
  }
  console.log('   ' + paint(ESC.dim, parts.join(' · ')));

  let prevTs = null;
  let curDate = startDate;
  for (const t of turns) {
    const d = dateOf(t.ts);
    if (d && d !== curDate) {
      console.log();
      console.log('   ' + paint(ESC.grey, `── ${d} ──`));
      curDate = d;
    }
    const role = ROLE[t.role] || ROLE.claude;
    const side = t.role === 'you' ? 'right' : 'left';
    let deltaMs = null;
    if (showDelta && prevTs && t.ts) {
      const ms = new Date(t.ts) - new Date(prevTs);
      if (ms >= 0) deltaMs = ms;
    }
    prevTs = t.ts || prevTs;
    console.log();
    if (side === 'right') console.log(exchangeRule(t.ref));
    console.log(turnHeader(role, t.model, fmtTime(t.ts), deltaMs, side, t.ref));
    for (const line of renderBody(t.text, role, CW, side)) console.log(line);
  }
  console.log();
}

// Run as a CLI only when invoked directly; when required (by the tests) the
// functions below are exported and nothing executes — including the help
// check, whose console output and process.exit() must not fire off the HOST's
// argv when this file is required.
if (require.main === module) {
  if (argv.includes('-h') || argv.includes('--help')) {
    console.log(HELP);
    process.exit(0);
  }
  if (doList) runList();
  else runTranscript();
}

module.exports = {
  friendlyModel, modelColor, humanDelta, fmtTokens, contextOf, wrap, visLen, padLeftTo,
  styleInline, fmtTime, dateOf, toolSummary, extractText, encodePath, readTurns,
  numberTurns, defaultArchiveDest, readLogText, isDatalessFlags, sessionRecord,
};
