#!/usr/bin/env node
/*
 * ccclose — check, from a fresh read, whether a session's close left anything
 * owing.
 *
 * RECORD.md's close declaration says what a close owes and that "nothing is
 * owed" is a claim that must carry its evidence. This is that evidence, read
 * from the repo, the host and the session's own transcript rather than from the
 * session's memory, which is the thing that drifts in a long session. It prints
 * the standard outputs (session id, transcript, window), fifteen checks in a
 * fixed order, four listings (every prompt the principal gave, the questions put
 * to him, the other repos the session touched, the other live sessions), a
 * one-line verdict and the identifiers block. The design of record is
 * instruments/ccclose.design.md.
 *
 * ATTRIBUTION IS A HEURISTIC, and the output says so on every run: "this
 * session's" commits, branches, worktrees, claims and PRs are the ones dated
 * inside the window (first to last transcript timestamp) on this repo. Two
 * sessions working one repo at once can each be credited with the other's work.
 * The one stronger signal is a [~] claim line that names the session's 8-char id
 * prefix. The identifiers block (--identifiers) goes further for commits and
 * board movement: it credits as fact only a commit that a git command of the
 * session or its subagents made, bound to the commit by subject, repo, result and
 * time, and labels the rest "unconfirmed" (design note section 15).
 *
 * READ-ONLY. It never commits, pushes, fetches, removes a worktree or edits a
 * file. "Pushed" therefore means "in a remote-tracking ref as of the last
 * fetch". The only network is `gh`, and only when gh is present and
 * authenticated; otherwise those checks print unknown, never a pass. The one
 * exception is the pin check (check 14), which runs atelier's tools/pins.py:
 * that fetches origin into the ATELIER checkout (remote-tracking refs only; it
 * touches no working tree and nothing in the repo under check). A failed fetch
 * or a missing checkout prints "no result", never "current".
 *
 * The transcript is streamed a line at a time. The prompt classifiers are
 * cctranscript's own (required from beside this file), so a ref printed here
 * opens the same exchange in cctranscript.
 *
 * Test seams: $CCCLOSE_GH names the gh executable (default "gh"), so the tests
 * can stand a stub in for the network; $CCCLOSE_PS names the ps executable the
 * launched-work check (check 15) reads the process table with, so no test reads
 * the real one. $CCCLOSE_ATELIER names the atelier
 * checkout the pin check measures against, and $CCCLOSE_PINS_TIMEOUT its
 * time limit in seconds (default 20); both are documented in the man page.
 */
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const readline = require('node:readline');
const { spawnSync } = require('node:child_process');

const cct = require(path.join(__dirname, 'cctranscript'));

const HELP = `ccclose — check a session's close from a fresh read

USAGE
  ccclose [--session <id|path>] [--root <dir>] [--json] [--identifiers]

OPTIONS
  --session <id|path>  The session to check: a session id, or a .jsonl path.
                       Default: $CLAUDE_CODE_SESSION_ID.
  --root <dir>         The repo to check (default: the current directory).
  --json               Machine-readable output.
  --identifiers        Print only the paste-ready identifiers block
                       (RECORD.md), instead of the checks.
  -h, --help           This help.

Checks worktrees, branches, pushes, PRs, the session record, the board, live
claims, the floor at the pushed head, review pointers, workaround-shaped
commands (a refused delete re-routed among them), the working tree, subagents,
the scratch folder, in a repo that pins atelier the pin and floor copy (runs
pins.py: it fetches the atelier checkout's origin), and anything else the
session launched still running (reads the process table; fails closed). Lists
every prompt you gave, each question put to you, the other repos touched (the
same checks there) and the other live sessions; ends with the identifiers block.
Read-only. Exit 0 when no check fails.  Full manual: man ccclose`;

// The cap on every listed set. Counts stay whole; only the lists are cut.
const CAP = 25;

// --- arguments -----------------------------------------------------------

function parseArgs(argv) {
  const opts = { session: null, root: null, json: false, identifiers: false, help: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '-h' || a === '--help') opts.help = true;
    else if (a === '--json') opts.json = true;
    else if (a === '--identifiers') opts.identifiers = true;
    else if (a === '--session' || a === '--root') {
      const v = argv[i + 1];
      if (v === undefined || v.startsWith('--')) return { error: `${a} needs a value` };
      opts[a.slice(2)] = v;
      i++;
    } else return { error: `unknown argument '${a}'` };
  }
  return opts;
}

// --- small helpers -------------------------------------------------------

function run(cmd, args, cwd, timeout = 30000) {
  let r;
  try {
    r = spawnSync(cmd, args, {
      cwd, encoding: 'utf8', timeout, maxBuffer: 64 * 1024 * 1024,
      stdio: ['ignore', 'pipe', 'pipe'],
    });
  } catch (e) { return { ok: false, code: null, out: '', err: String(e && e.message) }; }
  if (r.error) return { ok: false, code: null, out: r.stdout || '', err: String(r.error.message) };
  return { ok: r.status === 0, code: r.status, out: r.stdout || '', err: r.stderr || '' };
}
// --no-optional-locks: `git status` otherwise refreshes the index under
// index.lock, which is a write, and on a shared checkout it can collide with a
// peer session's commit. A checker must not cause the contention it reports on.
const git = (root, args, timeout) => run('git', ['--no-optional-locks', '-C', root, ...args], root, timeout);
const lines = (s) => s.split('\n').filter((l) => l.length > 0);
const isDir = (p) => { try { return fs.statSync(p).isDirectory(); } catch { return false; } };
const isFile = (p) => { try { return fs.statSync(p).isFile(); } catch { return false; } };
const clip = (s, n) => {
  const flat = String(s).replace(/\s+/g, ' ').trim();
  return flat.length > n ? flat.slice(0, n - 1) + '…' : flat;
};
const utc = (ms) => (Number.isFinite(ms) ? new Date(ms).toISOString().slice(0, 16).replace('T', ' ') : 'unknown');
const short = (sha) => (sha ? sha.slice(0, 12) : 'unknown');

// --- the transcript ------------------------------------------------------

// Find <id>.jsonl in any project folder: a session that moved into a worktree
// still logs under the folder it started in, so the cwd encoding is not enough.
function locateTranscript(spec) {
  if (!spec) return null;
  if (spec.includes('/') || spec.endsWith('.jsonl')) {
    const p = path.resolve(spec);
    return isFile(p) ? p : null;
  }
  const projects = path.join(os.homedir(), '.claude', 'projects');
  let dirs;
  try { dirs = fs.readdirSync(projects); } catch { return null; }
  for (const d of dirs) {
    const p = path.join(projects, d, `${spec}.jsonl`);
    if (isFile(p)) return p;
  }
  return null;
}

// Harness wrappers that ride in a type:"user" record but are not the principal
// typing. Text that is nothing BUT these is not a prompt for the asks list. The
// lists are cctranscript's own, so the two tools cannot drift. The slash-command
// wrappers split: <command-name> and <command-message> hold none of the
// principal's sentences and are stripped, but <command-args> holds exactly what
// they typed after the command, so it is UNWRAPPED, its text kept (160/880, HC1).
// A command with empty args is therefore still wrapper-only, and no prompt.
const COMMAND_ARGS_RE = /<command-args\b[^>]*>([\s\S]*?)<\/command-args>/g;
function stripWrappers(text) {
  const t = cct.stripElements(text, [...cct.HARNESS_TAGS, ...cct.COMMAND_WRAPPER_TAGS]);
  return t.replace(COMMAND_ARGS_RE, ' $1 ').trim();
}

// The close-out ask heuristic (design note §9). A sentence is listed when it
// has a strong close phrase, or both a cue and an object. It errs towards
// listing: a missed ask is the costly error.
const STRONG = /\b(close[- ]?out|closing out|ready to close|before (?:you )?(?:close|closing|finish|finishing|stop|stopping|wrap)|at (?:the )?close|wrap(?:ping)? up|tidy[- ]?up|clean[- ]?up|leave (?:it |things |everything |the \w+ )?(?:clean|tidy))\b/i;
const CUE = /\b(make sure|ensure|remember to|don'?t forget|do not forget|check (?:that|whether|for|if)|before you|at the end|when (?:you'?re|you are|it'?s) (?:done|finished)|close|closing|record(?:ed|s)?|log(?:ged)?|update[ds]?)\b/i;
const OBJECT = /\b(session (?:log|record|entry)|sessions\.md|roadmap|board|changelog|worktrees?|branch(?:es)?|PRs?|pull requests?|merged?|push(?:ed)?|learnings?|defects?|evidence|assumptions?|decisions?|questions?|rulings?|follow-?ups?|memory|reviews?|floor)\b/i;
function askSentences(text) {
  const out = [];
  for (const raw of text.split(/\n+|(?<=[.!?])\s+/)) {
    const s = raw.trim();
    if (s.length < 3) continue;
    if (STRONG.test(s) || (CUE.test(s) && OBJECT.test(s))) out.push(s);
  }
  return out;
}

// Shell commands shaped like a workaround (Mike: "no work arounds when issues
// come up like contention on commits"). Listed, never judged: some are fine.
const BYPASSES = [
  ['hooks skipped', /--no-verify\b/],
  ['signing switched off', /--no-gpg-sign\b|commit\.gpgsign=false|gpg\.format=\S*\s/],
  ['hooks redirected', /core\.hooksPath\s*=/],
  ['force push', /\bgit\b[^|;&]*\bpush\b[^|;&]*(?:\s-f\b|--force\b|--force-with-lease\b)/],
  ['hard reset', /\bgit\b[^|;&]*\breset\b[^|;&]*--hard\b/],
  ['bare stash', /\bgit\s+stash(?:\s+(?:pop|push)?\s*)?(?:$|[;&|])/],
  ['stage everything', /\bgit\s+add\s+(?:-A\b|--all\b|\.(?:\s|$))/],
  ['lock file removed', /\brm\b[^|;&]*index\.lock\b/],
  ['protection bypassed', /\bgh\s+pr\s+merge\b[^|;&]*--admin\b/],
];
function bypassesIn(command) {
  return BYPASSES.filter(([, re]) => re.test(command)).map(([label]) => label);
}

// A refused delete reached by another route (180/180). A session whose delete
// was refused, by a deny rule, the classifier or the principal, then deleted the
// same files by a Python call: the refusal treated as an obstacle. The narrow
// form: only deletes, only the routes below, only inline in a shell command. A
// later call is flagged when it deletes only by routes no refused call used; a
// retry by a refused route is not (a rule narrowed on the principal's word lets
// the same command through, and that is no workaround). The flag does not
// expire: the transcript does not record a rule being changed.
const DELETE_ROUTES = [
  ['rm', /(?<![\w./-])(?<!\bgit\s+)rm\s/],
  ['rmdir', /(?<![\w./-])rmdir\s/],
  ['unlink', /(?<![\w./-])unlink\s/],
  ['find -delete', /\bfind\s[^;&|\n]*\s-delete\b/],
  ['python rmtree', /\brmtree\s*\(/],
  ['python os delete', /\bos\.(?:remove|unlink|rmdir|removedirs)\s*\(/],
  ['python pathlib delete', /(?<!\bos)\.(?:unlink|rmdir)\s*\(/],
  ['node fs delete', /\b(?:rmSync|unlinkSync|rmdirSync)\s*\(|\bfs(?:\.promises)?\.(?:rm|unlink|rmdir)\s*\(/],
];
function deleteRoutes(command) {
  return DELETE_ROUTES.filter(([, re]) => re.test(command)).map(([label]) => label);
}
// How the harness words a refused call in its tool_result (census of the live
// store, 2026-11-03): a deny rule, the auto-mode classifier, the principal's
// rejection, a block for safety, and a compound command whose parts needed an
// approval nobody gave. Each arrives with is_error set. A failed command
// (a non-zero exit) is not a refusal and does not match.
const REFUSAL = /^\s*(?:Permission to use \S+[\s\S]*? has been denied|Permission for this action was denied|The user doesn't want to proceed with this tool use|Auto mode could not evaluate this action and is blocking it|This \S+ command [\s\S]*?require approval)/;
const isRefusal = (b) => !!(b && b.is_error) && REFUSAL.test(typeof b.content === 'string' ? b.content : cct.extractText(b.content));

// The ends of background agents, as the parent transcript records them: a
// <task-notification> block with a <task-id> (the agent's id) and a <status>.
// The harness writes the same block in three shapes (census of the live store,
// 2026-10-18): an `attachment` record of type queued_command (the text in
// attachment.prompt), a `queue-operation` enqueue (the text in content), and a
// plain `user` record (the text in message.content). A record that merely
// MENTIONS the tag (an assistant discussing it, a prompt quoting it) is none of
// the three, and a user text counts only when it opens with the tag.
const NOTE_BLOCK = /<task-notification>([\s\S]*?)<\/task-notification>/g;
function notificationText(o) {
  if (o.type === 'attachment' && o.attachment && o.attachment.type === 'queued_command') {
    return cct.extractText(o.attachment.prompt);
  }
  if (o.type === 'queue-operation' && o.operation === 'enqueue') return cct.extractText(o.content);
  if (o.type === 'user' && !o.toolUseResult && o.message) return cct.extractText(o.message.content);
  return '';
}
function taskNotifications(text) {
  if (!text || !text.trimStart().startsWith('<task-notification>')) return [];
  const out = [];
  for (const m of text.matchAll(NOTE_BLOCK)) {
    const id = (m[1].match(/<task-id>\s*([^<\s]+)\s*<\/task-id>/) || [])[1];
    const status = (m[1].match(/<status>\s*([^<\s]+)\s*<\/status>/) || [])[1];
    if (id && status) out.push({ id, status });
  }
  return out;
}

// What the session did to PRs and worktrees, read from the commands it ran. A
// worktree that was put away, and its deleted branch, leave no trace in git, and
// a PR the session merged is no longer open, so the repo alone cannot name them;
// the transcript can. Shell parsing here is deliberately small: it reads the
// first segment of a command (up to an unquoted ; & | or newline) and the common
// forms, and a form it cannot read is missed, never guessed.

function shellWords(s) {
  const words = [];
  let cur = null, q = null;
  const push = () => { if (cur !== null) { words.push(cur); cur = null; } };
  for (let i = 0; i < s.length; i++) {
    const c = s[i];
    if (q) {
      if (c === q) q = null;
      else if (c === '\\' && q === '"' && i + 1 < s.length) cur += s[++i];
      else cur += c;
      continue;
    }
    if (c === '"' || c === "'") { q = c; if (cur === null) cur = ''; continue; }
    if (c === '\\' && s[i + 1] === '\n') { push(); i++; continue; }
    if (c === '\\' && i + 1 < s.length) { cur = (cur || '') + s[++i]; continue; }
    if (c === '\n' || c === ';' || c === '|' || c === '&') { push(); break; }
    if (/\s/.test(c)) { push(); continue; }
    cur = (cur || '') + c;
  }
  push();
  return words;
}

// The block is pasted into records that may be public, so a path under the
// home directory prints as ~/… and the account name stays out (RECORD.md,
// the record is public). --json keeps the absolute path.
const tildePath = (p) => {
  const h = os.homedir();
  return p === h ? '~' : p.startsWith(h + path.sep) ? '~' + p.slice(h.length) : p;
};

const unquote = (x) => x.replace(/^(["'])(.*)\1$/, '$2');
function resolveFrom(base, p) {
  const q = p.startsWith('~') ? path.join(os.homedir(), p.slice(1)) : p;
  return path.isAbsolute(q) ? path.normalize(q) : (base ? path.resolve(base, q) : q);
}

// `git [-C dir] worktree add [-b|-B branch] [flags] <path> [<commit-ish>]`.
// The branch is -b's value; else, with a commit-ish, that ref (an existing
// branch checked out); else the path's basename, which git creates. --detach
// has no branch. A relative path resolves against a preceding `cd`, a -C, or
// the record's own cwd.
//
// A `$NAME` / `${NAME}` in the path (or in the `cd` / `-C` it resolves against,
// or in the -b branch) is expanded from a literal assignment made earlier in the
// same command, or before it in the transcript (`vars`, the same reading the
// message-file evidence uses, 210/310). A variable with no such assignment, or
// any other expansion ($(...), backticks), leaves the path unknown, and the add
// is DROPPED: a made-up path would be pasted as fact (210/330). An assignment
// that only prefixes the git command itself (`W=/p git worktree add $W`) is
// not seen by that command's own expansion, so it does not count either.
//
// An add inside `for VAR in w1 w2; do ... done` whose word list is plain words
// (no glob, brace, $ or backtick) is expanded once per word, the loop variable
// standing for each; nested literal loops multiply. A loop over anything else
// leaves its variable unset, so the add is dropped (210/360).
//
// `stats`, when given, takes the number of adds that were dropped, so the block
// can say how many it could not resolve instead of under-counting silently.
const WT_ADD = /\bgit\s+((?:-[Cc]\s+\S+\s+)*)worktree\s+add\b/g;
const FOR_HEAD = /(?:^|[\s;&|(])for\s+([A-Za-z_]\w*)\s+in\s+([^;\n]*?)\s*(?:;|\n)\s*do\b/g;
const LOOP_OPEN = /(?:^|[\s;&|(])(?:for|while|until|select)\s/g;
const LOOP_CLOSE = /(?:^|[\s;&|()])done\b/g;

// The `for` loops whose body holds the offset `at`: [{ name, words|null }],
// outermost first. words is null when the list is not plain literal words.
function loopsAround(command, at) {
  const out = [];
  if (!command.includes('for')) return out;
  for (const h of command.matchAll(FOR_HEAD)) {
    const bodyFrom = h.index + h[0].length;
    if (bodyFrom > at) continue;
    // Walk to this loop's own `done`, skipping nested loops' pairs.
    const marks = [];
    for (const m of command.slice(bodyFrom).matchAll(LOOP_OPEN)) marks.push([m.index, 1]);
    for (const m of command.slice(bodyFrom).matchAll(LOOP_CLOSE)) marks.push([m.index, -1]);
    marks.sort((a, b) => a[0] - b[0]);
    let depth = 0, doneAt = Infinity;
    for (const [i, d] of marks) {
      depth += d;
      if (depth < 0) { doneAt = bodyFrom + i; break; }
    }
    if (at >= doneAt) continue;
    const raw = h[2];
    const plain = raw.trim() !== '' && !/[$`*?\[\]{}()<>~\\]/.test(raw);
    out.push({ name: h[1], words: plain ? shellWords(raw) : null });
  }
  return out;
}

function worktreeAdds(command, cwd, vars = new Map(), stats = null) {
  const out = [];
  const assigns = command.includes('=') ? assignmentsIn(command) : [];
  for (const m of command.matchAll(WT_ADD)) {
    const words = shellWords(command.slice(m.index + m[0].length));
    let branch = null, detach = false;
    const pos = [];
    for (let i = 0; i < words.length; i++) {
      const x = words[i];
      if (x === '-b' || x === '-B') branch = words[++i] || null;
      else if (x === '--reason') i++;
      else if (x === '--detach') detach = true;
      else if (x.startsWith('-')) continue;
      else pos.push(x);
    }
    if (!pos.length) continue;
    // Variables as they stand when this add runs.
    const base0 = new Map(vars);
    for (const a of assigns) {
      const from = command.indexOf(a.name + '=', a.at);
      if (a.at < m.index && /[;&|\n]/.test(command.slice(from, m.index))) base0.set(a.name, a.value);
    }
    // One environment per combination of the enclosing loops' words.
    let envs = [base0];
    for (const lp of loopsAround(command, m.index)) {
      if (lp.words === null) { for (const e of envs) e.delete(lp.name); continue; }
      envs = envs.flatMap((e) => lp.words.map((wd) => new Map(e).set(lp.name, wd)));
    }
    let dropped = false;
    const site = [];
    for (const env of envs) {
      const expand = (word) => (/[$`]/.test(word) ? expandVars(word, env) : word);
      const target = expand(pos[0]);
      const br = branch === null ? null : expand(branch);
      if (target === null || target === '' || br === null && branch !== null) { dropped = true; continue; }
      let base = cwd || null, baseKnown = true;
      const cds = [...command.slice(0, m.index).matchAll(/\bcd\s+("[^"]*"|'[^']*'|[^\s;&|]+)/g)];
      const dirs = [];
      if (cds.length) dirs.push(unquote(cds[cds.length - 1][1]));
      for (const c of m[1].matchAll(/-C\s+(\S+)/g)) dirs.push(unquote(c[1]));
      for (const d of dirs) {
        const x = expand(d);
        if (x === null) { baseKnown = false; break; }
        base = resolveFrom(base, x);
      }
      // An unknown directory only matters to a relative path.
      if (!baseKnown && !path.isAbsolute(target) && !target.startsWith('~')) { dropped = true; continue; }
      const wtPath = resolveFrom(base, target);
      const commitish = pos[1] !== undefined ? expand(pos[1]) : null;
      if (!br && !detach && pos[1] !== undefined && commitish === null) { dropped = true; continue; }
      if (site.includes(wtPath)) continue;
      site.push(wtPath);
      out.push({
        path: wtPath,
        branch: detach ? null : (br || commitish || path.basename(wtPath)),
      });
    }
    if (dropped && stats) stats.unresolved = (stats.unresolved || 0) + 1;
  }
  return out;
}

// `gh pr merge <n>`, `gh pr merge <url>`, `gh pr merge #n`. The number may sit
// before or after the flags; a flag's value is skipped so `--body 5` is not PR 5.
// No number (the current branch's PR) or `--repo` (another repo's) yields none.
const GH_PR = /(?:^|[\n;&|(]\s*)(?:[A-Za-z_]\w*=\S*\s+)*gh\s+pr\s+(create|merge)\b/g;
const PR_OPT_VALUE = new Set(['-b', '--body', '-t', '--subject', '-F', '--body-file', '--match-head-commit',
  '-A', '--author-email', '-T', '--title', '-B', '--base', '-H', '--head', '-a', '--assignee', '-l', '--label',
  '-m', '--milestone', '-p', '--project', '-r', '--reviewer']);
function ghPrCommands(command) {
  const out = { creates: 0, merges: [] };
  for (const m of command.matchAll(GH_PR)) {
    const words = shellWords(command.slice(m.index + m[0].length));
    if (words.some((x) => x === '-R' || x === '--repo' || x.startsWith('--repo='))) continue;
    if (m[1] === 'create') { out.creates++; continue; }
    for (let i = 0; i < words.length; i++) {
      const x = words[i];
      if (PR_OPT_VALUE.has(x)) { i++; continue; }
      if (x.startsWith('-')) continue;
      const n = x.match(/^#?(\d+)$/) || x.match(/\/pull\/(\d+)/);
      if (n) { out.merges.push(Number(n[1])); break; }
    }
  }
  return out;
}

// The git commands a Bash command RUNS that make or rewrite commits, read from
// the command text, each with where it ran. This house commits with `git commit
// -q`, so a SHA never reaches the transcript, but the message does: in `-m`, or
// in a heredoc (`-m "$(cat <<'EOF' ...)"` or `-F - <<'EOF'`). A message held in
// a variable is missed, never guessed; the commit it made is then "unconfirmed".
// A message in a file (`-F path`) is read by messageFilesIn / MsgEvidence below,
// from the session's own Write or heredoc.
//
// Only a git word in COMMAND POSITION counts (line start, after ; & | ( or then /
// do / else, past env assignments and time/nice/exec): a commit command quoted
// in a heredoc body, a grep pattern or an echo runs nothing and is no evidence
// (IE4). Heredoc bodies are blanked before the match, so an offset in the blanked
// text is an offset in the command.
const normSubject = (x) => String(x).replace(/\s+/g, ' ').trim();
// What git calls the subject (%s): the first paragraph, its lines joined.
function firstParagraph(text) {
  const out = [];
  for (const l of String(text).split('\n')) {
    if (!l.trim()) { if (out.length) break; continue; }
    out.push(l);
  }
  return normSubject(out.join(' '));
}
const HEREDOC_G = /<<-?\s*(['"]?)([A-Za-z_]\w*)\1/g;
function codeOf(command) {
  if (!command.includes('<<')) return command;
  const ls = command.split('\n');
  for (let i = 0; i < ls.length; i++) {
    const tags = [...ls[i].matchAll(HEREDOC_G)].map((m) => m[2]);
    if (!tags.length) continue;
    let j = i + 1;
    for (const tag of tags) {
