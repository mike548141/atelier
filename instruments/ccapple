    0x85: "MotionSensor", 0x87: "LightSensor", 0x89: "ProgrammableSwitch", 0x8A: "TemperatureSensor",
    0x8C: "WindowCovering", 0x96: "Battery", 0x110: "CameraStream", 0x112: "Microphone",
    0x113: "Speaker", 0x121: "Doorbell", 0xD8: "Television", 0xD9: "InputSource",
