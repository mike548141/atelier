// Stream the log once: window, prompt counts, asks, models, bypasses, and what
// the parent saw of its agents (notifications by task id; tool_result ids).
async function readTranscript(file) {
  const t = {
    first: null, last: null, turn: 0, midTurn: 0, models: new Set(),
    asks: [], asksTotal: 0, bypasses: [], bypassesTotal: 0,
    notes: new Map(), toolResults: new Map(),
    // What the session did to PRs and worktrees, from its own commands (see
    // the identifiers section): pend holds a command until its result lands.
