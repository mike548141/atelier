.IR K=V ]...
.RB [ \-\-keep ]
.RB [ \-\-in
.IR worktree ]
.RB [ \-\-dry\-run ]
.br
.B ccfleet
.RI [ common ]
.B drive
.I jobs
.RB [ \-\-max
.IR n ]
.RB [ \-\-serial\-per\-repo ]
.RB [ \-\-dry\-run ]
.br
.B ccfleet
.RI [ common ]
.B drain
.RB [ \-\-max
.IR n ]
.RB [ \-\-dry\-run ]
.br
.B ccfleet
