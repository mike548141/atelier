#!/usr/bin/env node
/*
 * ccarchive — durably preserve every Claude Code transcript, word for word.
 *
 * Claude Code writes each session as a raw .jsonl log under
 * ~/.claude/projects/<encoded-repo-path>/<session-uuid>.jsonl (plus subagent
 * logs beneath it) — one JSON object per turn, verbatim, carrying the
 * timestamp, the model, token counts, tool calls and thinking. That is the
 * complete record. But it is *ephemeral*: Claude Code deletes logs older than
 * `cleanupPeriodDays` (default 30). Where cctranscript *reads* these logs,
 * ccarchive *keeps* them — it mirrors every .jsonl into a compressed archive
 * that outlives the source.
 *
 * The archive is an incremental per-session gzip mirror: each
 *   ~/.claude/projects/<rel>/<name>.jsonl
 * becomes
 *   <dest>/<rel>/<name>.jsonl.gz
 * so each session stays individually readable (`cctranscript <path>` after
 * gunzip, or `zgrep`) and only files that changed since last run are
 * recompressed — cheap to run often, and light on a synced dest like iCloud
 * Drive (only new/updated sessions upload). The default dest is iCloud Drive.
 *
 * Append-only by contract: ccarchive never deletes from the archive. When
 * Claude Code's cleanup removes a source log, the archived copy remains — that
 * is the whole point. Pruning the archive is deliberately not a mode.
 *
 * The .jsonl schema is internal to Claude Code, but ccarchive doesn't parse it —
 * it preserves the bytes exactly — so it is immune to schema drift.
 *
 * Integrity: gzip's own CRC-32 catches a corrupted .gz on decompression, but it
 * is weak and only proves the file is self-consistent — not that it still equals
 * what was captured. So ccarchive records a sha256 of each transcript's raw bytes
 * in <dest>/manifest.json when it archives, and `ccarchive --verify` re-hashes
 * every archived .gz and compares. That detects any post-archive mutation, bit
 * rot or sync glitch. The manifest is the trust anchor: it defends against
 * accidental corruption; for tamper-resistance keep a copy somewhere separate
 * from the archive (a mutation that also rewrites the manifest would pass).
 *
 * Scheduling is built in: `ccarchive --install-schedule` writes and loads a
 * launchd agent (macOS) that runs it daily and at login, so preservation needs
 * no hand-wired cron and re-establishes on a new machine with one command (after
 * instruments/install puts it on PATH). Every path is derived at runtime —
 * nothing personal is baked in. On non-macOS it prints the cron line to add.
 */
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const zlib = require('node:zlib');
const crypto = require('node:crypto');
const { execFileSync } = require('node:child_process');

const argv = process.argv.slice(2);

const HELP = `ccarchive — durably preserve every Claude Code transcript, word for word

USAGE
  ccarchive [options]

OPTIONS
  --dest <dir>           Archive dir (default: iCloud Drive; or $CCARCHIVE_DEST).
  --source <dir>         Read from <dir> (default: ~/.claude/projects).
  --dry-run              Preview; write nothing (works with --restore too).
  --force                Overwrite a shrunk archive copy; with --restore, a newer live file.
  --allow-repo-dest      Permit an archive dir inside a git work tree.
  --verify [--materialise]  Re-check archive vs sha256 manifest; --materialise reads evicted files too.
  --audit                Check the live store against the archive; report drift.
  --restore              Restore transcripts from the archive into the live store.
  --delta                With --restore: only --audit's drift (mutated/pruned/renamed).
  --install-schedule     Run daily via launchd (macOS); --schedule-status/--uninstall-schedule.
  --json                 Machine-readable output (never styled).
  -h, --help             This summary.

Mirrors every ~/.claude/projects/*.jsonl into a compressed, append-only, sha256-verified
archive outliving Claude Code's cleanup, and restores from it.  Full manual:  man ccarchive`;

function takeValue(flag) {
  const i = argv.indexOf(flag);
  return i !== -1 ? argv[i + 1] : null;
}

// --- pure helpers (unit-tested; no filesystem side effects) --------------

// The macOS iCloud Drive root, derived at runtime — no hardcoded home path, so
// this file carries no personal data (atelier is public; ADR 0005/0006).
function defaultDest(home) {
  return path.join(home, 'Library', 'Mobile Documents', 'com~apple~CloudDocs', 'cc-transcripts');
}

// The archived path for one source log: mirror its path relative to the source
// root under the dest root, with a .gz suffix.
function archivePathFor(destRoot, srcRoot, srcAbs) {
  return path.join(destRoot, path.relative(srcRoot, srcAbs) + '.gz');
}

// Archive a source only when the mirror is missing or the source is newer.
// destMtimeMs is null when no archived copy exists yet. The 1 ms tolerance
// absorbs the sub-millisecond rounding a filesystem can apply when we stamp the
// mirror's mtime — without it an unchanged session would re-archive every run;
// a genuine rewrite moves the mtime by far more than a millisecond.
const MTIME_TOLERANCE_MS = 1;
function shouldArchive(srcMtimeMs, destMtimeMs) {
  return destMtimeMs === null || srcMtimeMs - destMtimeMs > MTIME_TOLERANCE_MS;
}

// A re-archive that would shrink the stored copy is suspect: session logs only
// ever grow, so a smaller-than-recorded source usually means truncation or
// corruption upstream. After Claude Code's cleanup the archive is the sole
// durable copy, so an overwrite must never propagate that damage silently —
// refuse unless the operator forces it (--force).
function isSuspectShrink(srcBytes, manifestEntry) {
  return !!(manifestEntry && typeof manifestEntry.rawBytes === 'number'
    && srcBytes < manifestEntry.rawBytes);
}

// The write target must never sit inside a git work tree: the archive holds
// personal transcripts, and a repo dest is one commit away from publishing
// them. This makes the ADR's second guard a refusal in code, not just a safe
// default (--allow-repo-dest overrides, consciously).
function insideGitWorkTree(dir) {
  let d = path.resolve(dir);
  for (;;) {
    if (fs.existsSync(path.join(d, '.git'))) return true;
    const parent = path.dirname(d);
    if (parent === d) return false;
    d = parent;
  }
}

function humanBytes(n) {
  if (n < 1024) return `${n} B`;
  const units = ['KB', 'MB', 'GB', 'TB'];
  let v = n / 1024;
  let i = 0;
  while (v >= 1024 && i < units.length - 1) { v /= 1024; i++; }
  return `${v < 10 ? v.toFixed(1) : Math.round(v)} ${units[i]}`;
}

// --- filesystem walk -----------------------------------------------------

// Every .jsonl at any depth under root (session logs + nested subagent logs),
// returned as absolute paths. Missing root ⇒ empty (nothing to archive yet).
function listJsonl(root) {
  const out = [];
  let entries;
  try {
    entries = fs.readdirSync(root, { withFileTypes: true });
  } catch (e) {
    if (e.code === 'ENOENT') return out;
    throw e;
  }
  for (const ent of entries) {
    const abs = path.join(root, ent.name);
    if (ent.isDirectory()) out.push(...listJsonl(abs));
    else if (ent.isFile() && ent.name.endsWith('.jsonl')) out.push(abs);
  }
  return out;
}

// --- schedule management -------------------------------------------------
// The archive is only durable if it actually runs. Rather than a hand-written
// launchd plist (invisible to version control, silently missing on a new
// machine), ccarchive installs its own schedule from runtime-derived paths.

const SCHEDULE_LABEL = 'com.ccarchive.archive';   // neutral: no personal data
const SCHEDULE_INTERVAL_SECONDS = 24 * 60 * 60;   // daily

function xmlEscape(s) {
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function schedulePaths(home) {
  return {
    label: SCHEDULE_LABEL,
    plistPath: path.join(home, 'Library', 'LaunchAgents', SCHEDULE_LABEL + '.plist'),
    logPath: path.join(home, 'Library', 'Logs', 'ccarchive.log'),
  };
}

// Prefer the stable installed entrypoint (~/.local/bin/ccarchive, put on PATH by
// instruments/install) so the agent survives the repo moving; fall back to this
// script's own path when it isn't installed there.
function resolveScriptPath(home, fallbackPath) {
  const installed = path.join(home, '.local', 'bin', 'ccarchive');
  return fs.existsSync(installed) ? installed : fallbackPath;
}

function launchdPlist({ label, nodePath, scriptPath, intervalSeconds, logPath }) {
  return `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${xmlEscape(label)}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${xmlEscape(nodePath)}</string>
        <string>${xmlEscape(scriptPath)}</string>
    </array>
    <key>StartInterval</key>
    <integer>${intervalSeconds}</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${xmlEscape(logPath)}</string>
    <key>StandardErrorPath</key>
    <string>${xmlEscape(logPath)}</string>
</dict>
</plist>
`;
}

// Daily at 03:00 — the fallback for non-launchd platforms.
function cronLine(nodePath, scriptPath) {
  return `0 3 * * * ${nodePath} ${scriptPath}`;
}

function installSchedule(home) {
  const nodePath = process.execPath;
  const scriptPath = resolveScriptPath(home, fs.realpathSync(__filename));
  const { label, plistPath, logPath } = schedulePaths(home);

  if (process.platform !== 'darwin') {
    process.stdout.write(
      'ccarchive scheduling uses launchd (macOS). On this platform, add a cron line:\n' +
      `  ${cronLine(nodePath, scriptPath)}\n`);
    return 0;
  }

  fs.mkdirSync(path.dirname(plistPath), { recursive: true });
  fs.writeFileSync(plistPath, launchdPlist({
    label, nodePath, scriptPath, intervalSeconds: SCHEDULE_INTERVAL_SECONDS, logPath,
  }));
  // Reload so a re-install picks up a changed plist; ignore the unload error
  // when it wasn't already loaded.
  try { execFileSync('launchctl', ['unload', '-w', plistPath], { stdio: 'ignore' }); } catch {}
  execFileSync('launchctl', ['load', '-w', plistPath], { stdio: 'ignore' });

  process.stdout.write(
    `Scheduled: ${label} runs daily (and at login).\n` +
    `  plist: ${plistPath}\n` +
    `  runs:  ${nodePath} ${scriptPath}\n` +
    `  log:   ${logPath}\n`);
  return 0;
}

function uninstallSchedule(home) {
  const { label, plistPath } = schedulePaths(home);
  if (process.platform !== 'darwin') {
    process.stdout.write('Nothing to remove (launchd is macOS-only). Delete any cron line you added.\n');
    return 0;
  }
  try { execFileSync('launchctl', ['unload', '-w', plistPath], { stdio: 'ignore' }); } catch {}
  let removed = false;
  try { fs.rmSync(plistPath); removed = true; } catch (e) { if (e.code !== 'ENOENT') throw e; }
  process.stdout.write(removed
    ? `Removed schedule ${label} (${plistPath}).\n`
    : `No schedule installed (${plistPath} absent).\n`);
  return 0;
}

function scheduleStatus(home) {
  const nodePath = process.execPath;
  const scriptPath = resolveScriptPath(home, fs.realpathSync(__filename));
  const { label, plistPath, logPath } = schedulePaths(home);
  if (process.platform !== 'darwin') {
    process.stdout.write(
      'Scheduling uses launchd (macOS); not this platform.\n' +
      `  cron equivalent: ${cronLine(nodePath, scriptPath)}\n`);
    return 0;
  }
  const installed = fs.existsSync(plistPath);
  let loaded = false;
  try { execFileSync('launchctl', ['list', label], { stdio: 'ignore' }); loaded = true; } catch {}
  process.stdout.write(
    `Schedule ${label}:\n` +
    `  plist installed: ${installed ? 'yes' : 'no'} (${plistPath})\n` +
    `  launchd loaded:  ${loaded ? 'yes' : 'no'}\n` +
    `  log:             ${logPath}\n`);
  return 0;
}

// --- iCloud dataless-file awareness --------------------------------------
// iCloud Drive's "Optimise Mac Storage" evicts the local bytes of files it
// judges unused, leaving a *dataless* placeholder: the content still lives in
// the cloud and faults back on the next read, but no bytes sit on disk. The
// archive dest defaults to iCloud Drive, so its .gz files are prime eviction
// targets. Reading one re-downloads it — fine for a deliberate restore, ruinous
// for a whole-archive --verify that would drag the entire history back onto disk
// and defeat the point of eviction.
//
// macOS records eviction as the SF_DATALESS bit in st_flags. Node's fs.Stats
// does NOT expose st_flags (no `flags` field, even with { bigint: true } —
// checked on Node 24), and process.binding is off-limits, so the only
// stdlib-clean signal is to shell out to BSD `stat -f %f`, which prints st_flags
// as a decimal. `stat` reads metadata only — it does NOT fault an evicted file
// back (verified read-only against a genuinely dataless iCloud file: repeated
// stat left it dataless). fs.statSync, used elsewhere only for mtime, is
// likewise non-faulting — so the incremental archive freshness check and the
// manifest write never re-download an evicted mirror.
const SF_DATALESS = 0x40000000;

// Pure: does a st_flags value carry the dataless bit? Unit-tested against the
// real observed value on an evicted iCloud file (0x40000060 = SF_DATALESS +
// UF_COMPRESSED; UF_COMPRESSED alone does NOT mean evicted).
function isDatalessFlags(flags) {
  return Number.isFinite(flags) && (flags & SF_DATALESS) !== 0;
}

// Read a path's BSD st_flags via `stat -f %f`. Returns null when the signal is
// simply unavailable — non-Darwin, no `stat`, a failed call, or an unparseable
// value — so a caller treats "unknown" as "not evicted". The whole mechanism
// therefore cleanly no-ops off macOS and on non-iCloud volumes (where the bit is
// just 0), never crashing and never false-positiving.
function statFlags(p) {
  if (process.platform !== 'darwin') return null;
  try {
    const n = Number(execFileSync('stat', ['-f', '%f', p], { encoding: 'utf8' }).trim());
    return Number.isFinite(n) ? n : null;
  } catch { return null; }
}

// Is this archive file an evicted iCloud placeholder whose bytes are not local?
// Test seam: CCARCHIVE_SIMULATE_DATALESS holds comma-separated path substrings to
// treat as dataless, so the classify/skip logic is exercisable over synthetic
// fixtures that can never truly be evicted — an eviction cannot be forced on
// demand, and this tool must never evict anything itself. Absent the env var it
// is purely the real stat-based signal above.
function isDataless(p) {
  const sim = process.env.CCARCHIVE_SIMULATE_DATALESS;
  if (sim) return sim.split(',').some((s) => s !== '' && p.includes(s));
  const flags = statFlags(p);
  return flags === null ? false : isDatalessFlags(flags);
}

// --- integrity: sha256 manifest + verify ---------------------------------
// Each archived transcript's raw-byte sha256 is recorded in <dest>/manifest.json
// (keyed by the same source-relative path the mirror uses). --verify re-hashes
// the archive against it. The manifest tracks the archive (append-only), not the
// live sources: a source pruned by Claude Code's cleanup keeps its entry, because
// its .gz is kept too.

function sha256(buf) { return crypto.createHash('sha256').update(buf).digest('hex'); }
function sha256File(p) { return sha256(fs.readFileSync(p)); }
function sha256Gz(gzPath) { return sha256(zlib.gunzipSync(fs.readFileSync(gzPath))); }

function manifestPath(destRoot) { return path.join(destRoot, 'manifest.json'); }

function loadManifest(destRoot) {
  try {
    return JSON.parse(fs.readFileSync(manifestPath(destRoot), 'utf8'));
  } catch (e) {
    if (e.code === 'ENOENT') return {};
    // Corrupt manifest: preserve it rather than clobber, warn, start fresh.
    try { fs.renameSync(manifestPath(destRoot), manifestPath(destRoot) + '.corrupt'); } catch {}
    process.stderr.write(
      `ccarchive: manifest unreadable (${e.message}); kept as manifest.json.corrupt, starting fresh.\n`);
    return {};
  }
}

function saveManifest(destRoot, obj) {
  fs.mkdirSync(destRoot, { recursive: true });
  const ordered = {};
  for (const k of Object.keys(obj).sort()) ordered[k] = obj[k];  // stable diffs
  const p = manifestPath(destRoot);
  const tmp = p + '.tmp';
  fs.writeFileSync(tmp, JSON.stringify(ordered, null, 2) + '\n');
  fs.renameSync(tmp, p);  // atomic: a crash mid-write can't corrupt the manifest
}

// Archived transcripts as manifest keys (the .gz suffix stripped). Excludes
// manifest.json and any non-transcript file.
function listArchivedRels(destRoot) {
  const out = [];
  const walk = (dir) => {
    let entries;
    try { entries = fs.readdirSync(dir, { withFileTypes: true }); }
    catch (e) { if (e.code === 'ENOENT') return; throw e; }
    for (const ent of entries) {
      const abs = path.join(dir, ent.name);
      if (ent.isDirectory()) walk(abs);
      else if (ent.isFile() && ent.name.endsWith('.jsonl.gz')) out.push(path.relative(destRoot, abs).slice(0, -3));
    }
  };
  walk(destRoot);
  return out;
}

function verifyArchive(destRoot, asJson, materialise) {
  const manifest = loadManifest(destRoot);
  const rels = Object.keys(manifest);
  const result = { dest: destRoot, checked: rels.length, ok: 0, mismatch: [], missing: [], evicted: [], unmanifested: [] };

  for (const rel of rels) {
    const gzPath = path.join(destRoot, rel + '.gz');
    // Eviction check BEFORE any read: an evicted .gz is intact in the cloud, just
    // not local, so re-hashing it would re-download it. Skipping keeps a whole-
    // archive --verify from bulk-faulting the history back onto disk. Reported as
    // `evicted` — distinct from missing/mismatch, and NOT a failure. --materialise
    // opts into reading (and thus deliberately re-downloading) them.
    if (!materialise && isDataless(gzPath)) { result.evicted.push(rel); continue; }
    let actual;
    try { actual = sha256Gz(gzPath); }
    catch (e) { if (e.code === 'ENOENT') { result.missing.push(rel); continue; } throw e; }
    if (actual === manifest[rel].sha256) result.ok++;
    else result.mismatch.push(rel);
  }
  for (const rel of listArchivedRels(destRoot)) {
    if (!manifest[rel]) result.unmanifested.push(rel);  // archived but no recorded hash
  }
  // Entries whose hash was backfilled from the .gz itself — the archive
  // attesting the archive, weaker than a raw-bytes anchor; surfaced, not hidden.
  result.fromArchive = rels.filter((rel) => manifest[rel].fromArchive).length;

  // An unmanifested file fails the verify: it is either injected, or archived
  // history the manifest lost — both need a human eye, not a green tick.
  const failed = result.mismatch.length + result.missing.length + result.unmanifested.length;
  if (asJson) { process.stdout.write(JSON.stringify(result, null, 2) + '\n'); return failed ? 1 : 0; }

  const lines = [
    `cc-transcripts verify → ${destRoot}`,
    `  ${result.checked} in manifest · ${result.ok} verified, ` +
      `${result.mismatch.length} mismatched, ${result.missing.length} missing` +
      (result.evicted.length ? `, ${result.evicted.length} evicted` : ''),
  ];
  if (result.fromArchive) {
    lines.push(`  ${result.fromArchive} entr${result.fromArchive === 1 ? 'y' : 'ies'} ` +
      `attest the archived copy only (source pruned before hashing — fromArchive)`);
  }
  if (result.evicted.length) {
    lines.push(`  ${result.evicted.length} evicted (dataless — bytes in iCloud, not local; ` +
      `skipped, not re-downloaded. Check them with: ccarchive --verify --materialise)`);
  }
  for (const rel of result.mismatch) lines.push(`  ✗ MISMATCH ${rel}`);
  for (const rel of result.missing) lines.push(`  ✗ MISSING  ${rel}`);
  for (const rel of result.unmanifested) {
    lines.push(`  ✗ UNMANIFESTED ${rel} (no recorded hash — injected, or lost ` +
      `from the manifest; run ccarchive to record it, then investigate)`);
  }
  if (!failed) {
    lines.push(result.evicted.length
      ? `  ✓ every checked transcript matches its recorded sha256 (${result.evicted.length} evicted, skipped).`
      : '  ✓ every archived transcript matches its recorded sha256.');
  }
  process.stdout.write(lines.join('\n') + '\n');
  return failed ? 1 : 0;
}

// --- audit: the live store vs the archive --------------------------------
// --verify checks the archive against its own manifest (has a .gz rotted or
// gone?). --audit checks the *live* store against the archive (has a live
// transcript drifted from what we preserved?). Different axis, read-only. The
// manifest is the record of what was archived; the live files are the truth
// we compare it to.
//
// Every live/archived transcript falls into one bucket:
//   synced  — live present, raw-byte sha256 == the recorded hash. The healthy
//             majority; counted only.
//   grown   — live present, hash differs, but the archived bytes are a strict
//             prefix of the live bytes: a pure append since the last archive.
//             Normal between runs; the next `ccarchive` catches it up.
//   mutated — live present, hash differs, and the live bytes are NOT a growth
//             of the archived copy (rewritten, or shrunk/truncated). Real
//             drift: the archive no longer equals the live session's history.
//   renamed — a live file with no manifest entry whose content matches an
//             archived entry recorded under a different path that is itself
//             gone from the live store. Real drift: the archive is keyed by
//             the old path.
//   new     — live present, unarchived, matching no archived content. The next
//             run archives it; counted.
//   pruned  — an archived entry with no live counterpart, its content unseen
//             live. The expected steady state after Claude Code's cleanup;
//             counted.
// Only mutated and renamed are drift worth a non-zero exit.

// Bucket the live store against the manifest by sha256 alone (no byte reads):
// `changed` still needs a byte-level look to split grown from mutated.
function auditCategorize(manifest, liveList) {
  const manifestRels = Object.keys(manifest);
  const manifestSet = new Set(manifestRels);
  const liveSet = new Set(liveList.map((f) => f.rel));

  // sha256 → the archived rels holding that content, for rename detection.
  const shaIndex = {};
  for (const rel of manifestRels) {
    const s = manifest[rel].sha256;
    (shaIndex[s] || (shaIndex[s] = [])).push(rel);
  }

  const synced = [];
  const changed = [];           // in manifest, hash differs → classify by bytes
  const renamed = [];           // { from, to, ambiguous }
  const added = [];             // live, unmanifested, content unseen archived
  const renameSources = new Set();

  for (const f of liveList) {
    if (manifestSet.has(f.rel)) {
      if (manifest[f.rel].sha256 === f.sha256) synced.push(f.rel);
      else changed.push(f.rel);
      continue;
    }
    // Unmanifested live file: a rename of an archived one, or genuinely new?
    // A match only counts as a rename when the archived path it matches is
    // itself gone from the live store (else it is a copy, not a move).
    const cands = (shaIndex[f.sha256] || []).filter((r) => !liveSet.has(r) && !renameSources.has(r));
    if (cands.length) {
      renamed.push({ from: cands[0], to: f.rel, ambiguous: cands.length > 1 });
      renameSources.add(cands[0]);
    } else {
      added.push(f.rel);
    }
  }

  const pruned = manifestRels.filter((r) => !liveSet.has(r) && !renameSources.has(r));
  return { synced, changed, renamed, added, pruned };
}

// How a live file diverges from its archived copy, once the hashes disagree.
// Pure prefix comparison over the raw bytes — a session log only ever appends,
// so a growth is benign (the archive just hasn't caught up); anything else is
// a rewrite or truncation the archive should not silently absorb.
function classifyDivergence(archivedBuf, liveBuf) {
  if (liveBuf.length >= archivedBuf.length) {
    return archivedBuf.equals(liveBuf.subarray(0, archivedBuf.length)) ? 'grown' : 'rewritten';
  }
  return liveBuf.equals(archivedBuf.subarray(0, liveBuf.length)) ? 'shrunk' : 'rewritten';
}

function auditLiveStore(srcRoot, destRoot, asJson, materialise) {
  const manifest = loadManifest(destRoot);
  const files = listJsonl(srcRoot);
  const liveList = files.map((abs) => ({
    rel: path.relative(srcRoot, abs), abs, sha256: sha256File(abs),
  }));

  const cat = auditCategorize(manifest, liveList);
  const absByRel = new Map(liveList.map((f) => [f.rel, f.abs]));

  const grown = [];
  const mutated = [];           // { rel, reason, liveBytes, archivedBytes }
  const evicted = [];           // { rel, liveBytes } — changed, archive copy dataless
  for (const rel of cat.changed) {
    const liveBuf = fs.readFileSync(absByRel.get(rel));
    const gzPath = path.join(destRoot, rel + '.gz');
    // A changed live file whose archived .gz is evicted: we know it differs from
    // the recorded hash, but classifying grown-vs-mutated needs the archived
    // bytes — reading them would fault the archive back. Undetermined, not proven
    // drift; report `evicted` and leave it to --materialise (or the next
    // ccarchive run, which re-archives the change anyway).
    if (!materialise && isDataless(gzPath)) { evicted.push({ rel, liveBytes: liveBuf.length }); continue; }
    let archivedBuf;
    try { archivedBuf = zlib.gunzipSync(fs.readFileSync(gzPath)); }
    catch (e) {
      if (e.code !== 'ENOENT') throw e;
      // The manifest records this rel but its .gz is gone (a --verify concern).
      // We can't classify the divergence, but live ≠ record is itself drift.
      mutated.push({ rel, reason: 'archive-missing', liveBytes: liveBuf.length, archivedBytes: null });
      continue;
    }
    const kind = classifyDivergence(archivedBuf, liveBuf);
    if (kind === 'grown') grown.push(rel);
    else mutated.push({ rel, reason: kind, liveBytes: liveBuf.length, archivedBytes: archivedBuf.length });
  }

  const result = {
    live: srcRoot, archive: destRoot,
    archived: Object.keys(manifest).length, live_total: liveList.length,
    synced: cat.synced.length, grown: grown.length,
    added: cat.added.length, pruned: cat.pruned.length,
    mutated, renamed: cat.renamed, evicted,
  };
  const drift = mutated.length + cat.renamed.length;

  if (asJson) { process.stdout.write(JSON.stringify(result, null, 2) + '\n'); return drift ? 1 : 0; }

  const lines = [
    `cc-transcripts audit → live store vs archive`,
    `  ${result.archived} archived · ${result.synced} in sync, ${result.grown} grown, ` +
      `${result.added} new, ${result.pruned} pruned`,
  ];
  if (drift) lines.push(`  ${mutated.length} mutated, ${cat.renamed.length} renamed`);
  for (const m of mutated) {
    const label = m.reason === 'shrunk' ? 'SHRUNK   '
      : m.reason === 'rewritten' ? 'REWRITTEN'
      : m.reason === 'archive-missing' ? 'NO-ARCHIVE' : 'MUTATED  ';
    const sizes = m.archivedBytes === null
      ? `live ${humanBytes(m.liveBytes)}, archived copy absent`
      : `live ${humanBytes(m.liveBytes)} vs archived ${humanBytes(m.archivedBytes)}`;
    lines.push(`  ✗ ${label} ${m.rel} (${sizes})`);
  }
  for (const r of cat.renamed) {
    lines.push(`  ✗ RENAMED   ${r.from} → ${r.to}${r.ambiguous ? ' (one of several matches)' : ''}`);
  }
  if (evicted.length) {
    lines.push(`  ⚠ ${evicted.length} changed but undetermined (archive copy dataless — ` +
      `not classified; re-run with --materialise, or ccarchive to re-archive the change)`);
  }
  if (!drift && (result.grown || result.added)) {
    lines.push(`  ⚠ ${result.grown + result.added} changed or added since the last archive — ` +
      `run ccarchive to catch up.`);
  }
  if (!drift && !result.grown && !result.added && !evicted.length) {
    lines.push('  ✓ the live store matches the archive (only expected pruning).');
  }
  process.stdout.write(lines.join('\n') + '\n');
  return drift ? 1 : 0;
}

// --- restore: archive → live store ---------------------------------------
// The inverse of archiving: gunzip <dest>/<rel>.gz back to <srcRoot>/<rel>.
// Two shapes share one engine:
//   --restore          every archived transcript (the manifest is the target
//                      list) — rebuild a lost or wiped live store from scratch.
//   --restore --delta  only what --audit flags as drift — the mutated, pruned
//                      and renamed buckets. Repair in place, not a full rebuild.
//
// Safety is content-first, because the archive is a point-in-time copy and a
// live file can be legitimately *ahead* of it. Restore never overwrites:
//   • an identical live file            — nothing to do;
//   • a live file the archive is a strict prefix of (the `grown` bucket: an
//     in-flight session appended since the last archive run) — overwriting would
//     drop the live tail the archive never held. This is the roadmap's explicit
//     "grown is not a restore target", enforced by bytes, not by trusting mtime.
// And it *refuses* — loudly, non-zero, rather than silently overwriting — a live
// file that diverged in some other way (rewritten/truncated) yet carries a newer
// mtime than the archived copy: it may be a fresh in-flight rewrite, so --force
// is the deliberate override. pruned and renamed targets have no live file at
// the restore path, so writing them can never clobber anything.

// Pure decision for one target. liveBuf null ⇒ no live file at the path (the
// pruned / renamed-old-path / missing case — always a safe write). Returns
// { action: 'restore'|'skip'|'refuse', reason }.
function classifyRestore(archivedBuf, liveBuf, gzMtimeMs, liveMtimeMs, force) {
  if (liveBuf === null) return { action: 'restore', reason: 'missing' };
  if (liveBuf.equals(archivedBuf)) return { action: 'skip', reason: 'identical' };
  const div = classifyDivergence(archivedBuf, liveBuf);   // grown | shrunk | rewritten
  if (div === 'grown') return { action: 'skip', reason: 'ahead' };
  const newer = liveMtimeMs !== null && liveMtimeMs - gzMtimeMs > MTIME_TOLERANCE_MS;
  if (newer && !force) return { action: 'refuse', reason: 'newer' };
  return { action: 'restore', reason: newer ? 'forced-newer' : div };
}

// A restore target must resolve *inside* the live root: a tampered or malformed
// manifest key containing `..` must never let a write escape the projects dir
// (the zip-slip class of bug). Belt-and-braces alongside the path.join.
function isInsideRoot(root, target) {
  const rel = path.relative(path.resolve(root), path.resolve(target));
  return rel !== '' && rel !== '..' && !rel.startsWith('..' + path.sep) && !path.isAbsolute(rel);
}

// The rels to consider, in stable order. Full = every manifest key. Delta =
// re-run the audit categorisation and take mutated + pruned + renamed. Growth is
// deliberately excluded (it is ahead of the archive), and `synced`/`added` have
// nothing to restore. The renamed bucket contributes its OLD (archived) path:
// the archive is keyed by `from`, that path is gone from the live store, and the
// live renamed copy at `to` is left untouched — so restore re-materialises the
// archived key without disturbing the live rename. Content is byte-identical, so
// this adds a copy under the old name rather than moving anything.
function restoreTargets(manifest, srcRoot, destRoot, delta) {
  if (!delta) return Object.keys(manifest).sort();
  const files = listJsonl(srcRoot);
  const liveList = files.map((abs) => ({ rel: path.relative(srcRoot, abs), abs, sha256: sha256File(abs) }));
  const cat = auditCategorize(manifest, liveList);
  const absByRel = new Map(liveList.map((f) => [f.rel, f.abs]));
  const mutated = [];
  for (const rel of cat.changed) {
    const liveBuf = fs.readFileSync(absByRel.get(rel));
    let archivedBuf;
    try { archivedBuf = zlib.gunzipSync(fs.readFileSync(path.join(destRoot, rel + '.gz'))); }
    catch (e) { if (e.code !== 'ENOENT') throw e; mutated.push(rel); continue; }  // .gz gone: still drift
    if (classifyDivergence(archivedBuf, liveBuf) !== 'grown') mutated.push(rel);  // grown excluded
  }
  const renamedFrom = cat.renamed.map((r) => r.from);
  return [...new Set([...mutated, ...cat.pruned, ...renamedFrom])].sort();
}

function restoreArchive(srcRoot, destRoot, { delta, dryRun, force, asJson }) {
  const manifest = loadManifest(destRoot);
  if (Object.keys(manifest).length === 0) {
    process.stderr.write(`ccarchive: nothing to restore — no manifest at ${destRoot}.\n`);
    return 1;
  }
  const rels = restoreTargets(manifest, srcRoot, destRoot, delta);
  const report = {
    mode: delta ? 'delta' : 'full', live: srcRoot, archive: destRoot, dryRun: !!dryRun,
    considered: rels.length, restored: [], skipped: [], refused: [], errors: [],
  };

  for (const rel of rels) {
    const liveAbs = path.join(srcRoot, rel);
    if (!isInsideRoot(srcRoot, liveAbs)) { report.errors.push({ rel, reason: 'escapes-root' }); continue; }
    const gzPath = path.join(destRoot, rel + '.gz');
    let archivedBuf, gzMtimeMs;
    try { archivedBuf = zlib.gunzipSync(fs.readFileSync(gzPath)); gzMtimeMs = fs.statSync(gzPath).mtimeMs; }
    catch (e) {
      if (e.code !== 'ENOENT') throw e;
      report.errors.push({ rel, reason: 'no-archive' });   // manifest records it, .gz absent
      continue;
    }
    let liveBuf = null, liveMtimeMs = null;
    try { liveBuf = fs.readFileSync(liveAbs); liveMtimeMs = fs.statSync(liveAbs).mtimeMs; }
    catch (e) { if (e.code !== 'ENOENT') throw e; }

    const d = classifyRestore(archivedBuf, liveBuf, gzMtimeMs, liveMtimeMs, force);
    if (d.action === 'skip') { report.skipped.push({ rel, reason: d.reason }); continue; }
    if (d.action === 'refuse') {
      report.refused.push({ rel, reason: d.reason, liveBytes: liveBuf.length, archivedBytes: archivedBuf.length });
      continue;
    }
    if (!dryRun) {
      fs.mkdirSync(path.dirname(liveAbs), { recursive: true });
      fs.writeFileSync(liveAbs, archivedBuf);
      // Stamp the restored file with the archived copy's mtime, so a later audit
      // reads it as synced and a repeated restore is idempotent (identical → skip).
      fs.utimesSync(liveAbs, gzMtimeMs / 1000, gzMtimeMs / 1000);
    }
    report.restored.push({ rel, reason: d.reason, bytes: archivedBuf.length });
  }

  const failed = report.refused.length + report.errors.length;
  if (asJson) { process.stdout.write(JSON.stringify(report, null, 2) + '\n'); return failed ? 1 : 0; }

  const identical = report.skipped.filter((s) => s.reason === 'identical').length;
  const ahead = report.skipped.filter((s) => s.reason === 'ahead');
  const verb = dryRun ? 'would restore' : 'restored';
  const lines = [
    `cc-transcripts restore${dryRun ? ' (dry run)' : ''} → ${srcRoot}  [${report.mode}]`,
    `  ${report.considered} considered · ${report.restored.length} ${verb}, ` +
      `${report.skipped.length} skipped, ${report.refused.length} refused` +
      (report.errors.length ? `, ${report.errors.length} error${report.errors.length === 1 ? '' : 's'}` : ''),
  ];
  if (identical) lines.push(`  (${identical} already match the archive)`);
  for (const r of report.restored) {
    const how = r.reason === 'missing' ? 'was missing'
      : r.reason === 'forced-newer' ? 'FORCED over newer live'
      : r.reason;   // shrunk | rewritten
    lines.push(`  ${dryRun ? '·' : '✓'} ${dryRun ? 'would restore' : 'RESTORED'} ${r.rel} (${how}, ${humanBytes(r.bytes)})`);
  }
  for (const s of ahead) {
    lines.push(`  · skip ${s.rel} (live is ahead of the archive — grown, not a restore target)`);
  }
  for (const r of report.refused) {
    lines.push(`  ✗ REFUSED ${r.rel} — live file is newer than the archived copy ` +
      `(live ${humanBytes(r.liveBytes)} vs archived ${humanBytes(r.archivedBytes)}); ` +
      `an in-flight session? Re-run with --force to overwrite it.`);
  }
  for (const e of report.errors) {
    lines.push(e.reason === 'no-archive'
      ? `  ✗ ERROR ${e.rel} (the manifest records it but its .gz is gone — nothing to restore from)`
      : `  ✗ ERROR ${e.rel} (target path escapes the live root — refused)`);
  }
  if (!report.restored.length && !report.refused.length && !report.errors.length && !ahead.length) {
    lines.push('  ✓ nothing to restore — the live store already matches the archive.');
  }
  process.stdout.write(lines.join('\n') + '\n');
  return failed ? 1 : 0;
}

// --- run -----------------------------------------------------------------

function run() {
  if (argv.includes('-h') || argv.includes('--help')) {
    process.stdout.write(HELP + '\n');
    return 0;
  }
  if (argv.includes('--install-schedule')) return installSchedule(os.homedir());
  if (argv.includes('--uninstall-schedule')) return uninstallSchedule(os.homedir());
  if (argv.includes('--schedule-status')) return scheduleStatus(os.homedir());
  const asJson = argv.includes('--json');
  const dryRun = argv.includes('--dry-run');
  const force = argv.includes('--force');
  const materialise = argv.includes('--materialise');
  const home = os.homedir();
  const srcRoot = takeValue('--source') || path.join(home, '.claude', 'projects');
  const destRoot = takeValue('--dest') || process.env.CCARCHIVE_DEST || defaultDest(home);

  if (argv.includes('--verify')) return verifyArchive(destRoot, asJson, materialise);
  if (argv.includes('--audit')) return auditLiveStore(srcRoot, destRoot, asJson, materialise);
  if (argv.includes('--restore')) {
    return restoreArchive(srcRoot, destRoot, { delta: argv.includes('--delta'), dryRun, force, asJson });
  }

  if (insideGitWorkTree(destRoot) && !argv.includes('--allow-repo-dest')) {
    process.stderr.write(
      `ccarchive: refusing to archive into a git work tree (${destRoot}) — ` +
      `transcripts are personal data one commit away from publication. ` +
      `Pass --allow-repo-dest to override.\n`);
    return 1;
  }

  const files = listJsonl(srcRoot);
  const report = { source: srcRoot, dest: destRoot, dryRun, total: files.length,
    archived: 0, skipped: 0, refusedShrink: [], bytesRaw: 0, bytesGz: 0, files: [] };

  // The manifest is read on every run (the shrink guard needs its rawBytes);
  // it is only ever written back on a real run.
  const manifest = loadManifest(destRoot);
  let manifestChanged = false;
  const nowIso = dryRun ? null : new Date().toISOString();

  // Layout-drift alarm: an empty source against a non-empty archive means the
  // live dir moved or was renamed — without this, a scheduled run would report
  // success forever while the archive silently stopped growing.
  if (files.length === 0 && Object.keys(manifest).length > 0) {
    process.stderr.write(
      `ccarchive: source ${srcRoot} yielded no transcripts while the archive ` +
      `holds ${Object.keys(manifest).length} — has the live directory moved?\n`);
    return 1;
  }

  for (const srcAbs of files) {
    const srcStat = fs.statSync(srcAbs);
    const destAbs = archivePathFor(destRoot, srcRoot, srcAbs);
    const rel = path.relative(srcRoot, srcAbs);
    let destMtimeMs = null;
    try { destMtimeMs = fs.statSync(destAbs).mtimeMs; } catch (e) {
      if (e.code !== 'ENOENT') throw e;
    }

    if (!shouldArchive(srcStat.mtimeMs, destMtimeMs)) {
      report.skipped++;
      // Backfill: an already-archived transcript with no recorded hash (e.g. the
      // first run after this feature shipped). The source is present, so hash it.
      if (!dryRun && !manifest[rel]) {
        manifest[rel] = { sha256: sha256File(srcAbs), rawBytes: srcStat.size, archivedAt: nowIso };
        manifestChanged = true;
      }
      continue;
    }

    // Shrink guard: this is an overwrite of the sole durable copy, and the
    // source is smaller than what the manifest recorded — suspect, refuse.
    if (!force && destMtimeMs !== null && isSuspectShrink(srcStat.size, manifest[rel])) {
      report.refusedShrink.push(rel);
      report.files.push({ rel, action: 'refused-shrink', rawBytes: srcStat.size,
        recordedBytes: manifest[rel].rawBytes });
      continue;
    }

    if (dryRun) {
      report.archived++;
      report.bytesRaw += srcStat.size;
      report.files.push({ rel, action: 'would-archive', rawBytes: srcStat.size });
      continue;
    }

    const raw = fs.readFileSync(srcAbs);
    const gz = zlib.gzipSync(raw);
    fs.mkdirSync(path.dirname(destAbs), { recursive: true });
    fs.writeFileSync(destAbs, gz);
    // Stamp the mirror with the source's mtime (numeric seconds, so no Date
    // millisecond truncation) so the next run's freshness check is stable and
    // the archive reflects each session's real time.
    fs.utimesSync(destAbs, srcStat.atimeMs / 1000, srcStat.mtimeMs / 1000);
    manifest[rel] = { sha256: sha256(raw), rawBytes: srcStat.size, archivedAt: nowIso };
    manifestChanged = true;

    report.archived++;
    report.bytesRaw += srcStat.size;
    report.bytesGz += gz.length;
    report.files.push({ rel, action: 'archived', rawBytes: srcStat.size, gzBytes: gz.length });
  }

  // Backfill any archived .gz whose source is already gone (pruned before this
  // feature existed) — hash it from the compressed copy, the only source left.
  if (!dryRun) {
    for (const rel of listArchivedRels(destRoot)) {
      if (manifest[rel]) continue;
      // Backfill hashes from the .gz — a read that would fault an evicted copy
      // back. Skip dataless ones so an ordinary run never bulk-downloads the
      // archive; they stay unmanifested (a later run/--verify with them local
      // records them). Only ever fires for archived files with no manifest entry.
      const gzPath = path.join(destRoot, rel + '.gz');
      if (isDataless(gzPath)) continue;
      manifest[rel] = { sha256: sha256Gz(gzPath), archivedAt: nowIso, fromArchive: true };
      manifestChanged = true;
    }
    if (manifestChanged) saveManifest(destRoot, manifest);
    report.manifestEntries = Object.keys(manifest).length;
  }

  for (const rel of report.refusedShrink) {
    process.stderr.write(
      `ccarchive: REFUSED ${rel} — source is smaller than the archived copy ` +
      `(truncated?). Re-run with --force to overwrite deliberately.\n`);
  }

  if (asJson) {
    process.stdout.write(JSON.stringify(report, null, 2) + '\n');
    return report.refusedShrink.length ? 1 : 0;
  }

  const verb = dryRun ? 'would archive' : 'archived';
  const lines = [
    `cc-transcripts archive${dryRun ? ' (dry run)' : ''} → ${destRoot}`,
    `  ${report.total} transcript${report.total === 1 ? '' : 's'} · ` +
      `${report.archived} ${verb}, ${report.skipped} unchanged`,
  ];
  if (report.archived > 0) {
    lines.push(dryRun
      ? `  ${humanBytes(report.bytesRaw)} raw to compress`
      : `  ${humanBytes(report.bytesGz)} written (from ${humanBytes(report.bytesRaw)} raw)`);
  }
  if (report.refusedShrink.length) {
    lines.push(`  ${report.refusedShrink.length} REFUSED (source smaller than archived copy — see stderr)`);
  }
  if (!dryRun && report.manifestEntries) {
    lines.push(`  ${report.manifestEntries} sha256 in manifest.json — verify with: ccarchive --verify`);
  }
  process.stdout.write(lines.join('\n') + '\n');
  return report.refusedShrink.length ? 1 : 0;
}

if (require.main === module) {
  process.exit(run());
}

module.exports = {
  defaultDest, archivePathFor, shouldArchive, humanBytes, listJsonl, run,
  xmlEscape, schedulePaths, resolveScriptPath, launchdPlist, cronLine,
  sha256, manifestPath, loadManifest, saveManifest, listArchivedRels, verifyArchive,
  isSuspectShrink, insideGitWorkTree, auditCategorize, classifyDivergence, auditLiveStore,
  isDatalessFlags, statFlags, isDataless,
  classifyRestore, isInsideRoot, restoreTargets, restoreArchive,
};
