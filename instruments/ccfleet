EXIT_SETUP, EXIT_CLAIM, EXIT_RESET, EXIT_EMPTY, EXIT_GUARD, EXIT_USAGE = 1, 2, 3, 4, 5, 64
PLACEHOLDER = re.compile(r"\{([A-Z][A-Z0-9_]*)\}")
# A RESULT line: one that BEGINS with RESULT: (a mention inside a NOTES line is
# not one, RK3). Markdown bold or backticks around the word are tolerated, and
# every capital-letter word in a row is captured; result_word() then keeps a
# known phrase (BUDGET EXHAUSTED) or the first word, so "SKIPPED NEEDS LIVE
# WRITE" reads SKIPPED and "DONE WITH FINDINGS" reads DONE.
RESULT_RX = re.compile(r"^[ \t>*`-]*RESULT[*`]*:[ \t*`]*([A-Z]+(?:[ \t]+[A-Z]+)*)", re.M)
# The final-output shape's identity line: the transcript fallback takes only a
# text that carries one, so a line of planning narration is never a verdict.
SHAPE_RX = re.compile(r"^\s*\**(?:ITEM|REPO):", re.M)
# A line that is only a code fence: a report fenced whole still ends on its
# RESULT line (DP2).
FENCE_RX = re.compile(r"^\s*(?:```+|~~~+)[\w+.-]*\s*$")
PIN_RX = re.compile(r"atelier@([0-9a-f]{7,40})\b", re.I)
# Without this, `claude -p` kills a background subagent about ten minutes after
# the orchestrator's last turn: a reviewer still working on act 2 dies mid-act.
CEILING_VAR = "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS"
RELEASE_ON = ["DONE", "SKIPPED"]
# A clean RESULT whose worktree still holds unlanded work reads as this word,
# which no release_on may hold: the claim stays and the pass can be resumed.
UNLANDED = "UNLANDED"
STOP_ON = ["BUDGET EXHAUSTED"]
# A job's own verdicts that end it for good though they are not clean (the
# fleet prompts' PARTIAL and BLOCKED): the worker finished and its report says
# what is left. A `run` with no claim removes its worktree when it holds no
# unlanded work, and a drive does not start it again (RK24). A claim is never
# released on one.
SETTLED_ON = ["PARTIAL", "BLOCKED"]
QUEUE_NOT_SEALED_RC = 3  # the queue contract's code for "refused: no seal held" (210/640)
TIMEOUT_RC = 124          # the exit code a session killed at its time limit is given
QUEUE_TIMEOUT = 600       # seconds a queue command may take before it counts as failed
# Values ccfleet fills in every prompt, and those only a pass or a resume adds
# (`check` uses these to name the placeholders nothing fills).
ALWAYS_FILLED = {"REPO", "GH", "BR", "VIS", "PIN", "WT", "PRIMARY", "LANDING", "NOTES", "SCRATCH",
                 "BY", "DATE", "SESSION"}
PASS_FILLED = {"ITEM", "BRIEF", "REVIEW_LOG"}
# What a resume (with --item) and a fold (run --in WT --item ITEM) add: the
# same two. Only `pass` fills {BRIEF}, and only for pass_prompt.
RESUME_FILLED = {"ITEM", "REVIEW_LOG"}
# claude_args that widen what an unattended session may do without asking, or
# what it can reach (MCP servers, plugins, the tool list, a permission tool).
# The first two take no value.
PERMISSION_FLAGS = ("--dangerously-skip-permissions", "--allow-dangerously-skip-permissions",
                    "--permission-mode", "--allowedTools", "--allowed-tools", "--add-dir",
                    "--mcp-config", "--plugin-dir", "--tools", "--permission-prompt-tool")
# User-level keys a session keeps (they equip it) that still widen what it can
# do or run; `check` names each one present. The config's `settings` can
# override any of them.
WIDENING_KEPT = {
    "enabledPlugins": "each plugin brings its own hooks, skills, agents and MCP servers",
    "env": "environment every tool call sees",
    "skipDangerousModePermissionPrompt": "skips the bypass mode's confirmation",
    "enableAllProjectMcpServers": "approves every MCP server a repo's .mcp.json names",
    "enabledMcpjsonServers": "approves the named MCP servers of a repo's .mcp.json",
    "apiKeyHelper": "runs a command of its own for credentials",
    "awsAuthRefresh": "runs a command of its own for credentials",
    "awsCredentialExport": "runs a command of its own for credentials",
    "otelHeadersHelper": "runs a command of its own for telemetry headers",
    "sandbox": "with autoAllowBashIfSandboxed, a Bash command the sandbox runs is approved without asking",
}
# Kept user-level keys known to equip a session without widening what it may
# do. Any other kept key is named "kept, not classified" by `check`, so a key a
# newer harness adds never widens the grant unseen (PK11).
NARROW_KEPT = {"permissions", "hooks", "model", "effortLevel", "statusLine", "outputStyle",
               "includeCoAuthoredBy", "cleanupPeriodDays", "alwaysThinkingEnabled", "spinnerTipsEnabled"}
# What a launch does when the user-level instructions file it appends names a
# private name and the repo is public or of unknown visibility.
INSTRUCTIONS_GUARD = ("refuse", "warn")


class Refusal(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code


def now_utc():
    return dt.datetime.now(dt.timezone.utc)


def expand(p):
    return os.path.abspath(os.path.expanduser(p)) if p else p


def expand_home(v):
    """A leading ~/ (or a bare ~) in a vars or env value is the home folder:
    neither a prompt that quotes the path nor an environment variable would
    expand it later."""
    return os.path.expanduser(v) if isinstance(v, str) and (v == "~" or v.startswith("~/")) else v


# ---------- config ----------

def load_config(path):
    path = path or os.environ.get("CCFLEET_CONFIG")
    if not path:
        raise Refusal(EXIT_USAGE, "no config: pass --config PATH or set CCFLEET_CONFIG")
    try:
        with open(expand(path), encoding="utf-8") as f:
            cfg = json.load(f)
    except OSError as e:
        raise Refusal(EXIT_USAGE, f"config {path}: cannot read it ({e.strerror or e})")
    except ValueError as e:
        raise Refusal(EXIT_USAGE, f"config {path}: not valid JSON ({e})")
    if not isinstance(cfg, dict):
        raise Refusal(EXIT_USAGE, f"config {path}: must be a JSON object")
    missing = [k for k in ("kit_dir", "repos_root", "worktrees_root", "default_model") if not cfg.get(k)]
    if missing:
        raise Refusal(EXIT_USAGE, f"config {path}: missing {', '.join(missing)}")
    for k in ("kit_dir", "repos_root", "worktrees_root"):
        cfg[k] = expand(cfg[k])
    cfg.setdefault("claude_bin", "claude")
    cfg.setdefault("claude_args", [])
    cfg.setdefault("nice", 5)
    cfg.setdefault("max_concurrent", 4)
    cfg.setdefault("stagger_seconds", 90)
    cfg.setdefault("poll_seconds", 30)
    t = cfg.setdefault("session_timeout_minutes", 480)
    if not isinstance(t, (int, float)) or isinstance(t, bool) or t < 0:
        raise Refusal(EXIT_USAGE, f"config {path}: session_timeout_minutes must be a number, 0 for none")
    if not isinstance(cfg["claude_args"], list):
        raise Refusal(EXIT_USAGE, f"config {path}: claude_args must be a list of arguments")
    owned = sorted({str(a).split("=", 1)[0] for a in cfg["claude_args"]} & set(OWNED_FLAGS))
    if owned:
        raise Refusal(EXIT_USAGE, f"config {path}: claude_args may not set {', '.join(owned)}: ccfleet sets "
                                  f"them so the config is the whole grant; put settings in `settings`")
    if not isinstance(cfg.setdefault("settings", {}), dict):
        raise Refusal(EXIT_USAGE, f"config {path}: settings must be a JSON object (Claude Code settings)")
    dh = cfg.setdefault("drop_hooks", [])
    if not isinstance(dh, list) or not all(isinstance(x, str) and x for x in dh):
        raise Refusal(EXIT_USAGE, f"config {path}: drop_hooks must be a list of non-empty texts")
    if cfg.get("reset_utc"):
        try:
            parse_reset(cfg["reset_utc"])
        except (TypeError, ValueError):
            raise Refusal(EXIT_USAGE, f"config {path}: reset_utc must be YYYY-MM-DDTHH:MM in UTC, "
                                      f"not {cfg['reset_utc']!r}")
    gate = cfg.setdefault("gate", {})
    gate.setdefault("max_load", 2 * (os.cpu_count() or 4))
    gate.setdefault("min_mem_pct", 25)
    gate.setdefault("min_disk_gb", 20)
    cfg.setdefault("private_names", [])
    if cfg.setdefault("instructions_guard", "refuse") not in INSTRUCTIONS_GUARD:
        raise Refusal(EXIT_USAGE, f"config {path}: instructions_guard must be one of "
                                  f"{', '.join(INSTRUCTIONS_GUARD)}, not {cfg['instructions_guard']!r}")
    if not isinstance(cfg.setdefault("vars", {}), dict):
        raise Refusal(EXIT_USAGE, f"config {path}: vars must be an object of NAME: value")
    cfg.setdefault("repos", {})
    if not isinstance(cfg.setdefault("env", {}), dict):
        raise Refusal(EXIT_USAGE, f"config {path}: env must be an object of NAME: value")
    for k in ("vars", "env"):
        cfg[k] = {n: expand_home(v) for n, v in cfg[k].items()}
    q = cfg.get("queue") or {}
    for k, default in (("release_on", RELEASE_ON), ("stop_on", STOP_ON)):
        if not isinstance(q.get(k, default), list):
            raise Refusal(EXIT_USAGE, f"config {path}: queue.{k} must be a list of RESULT words")
    if UNLANDED in q.get("release_on", RELEASE_ON):
        raise Refusal(EXIT_USAGE, f"config {path}: queue.release_on may not hold {UNLANDED}: it is the word "
                                  f"for a clean end that left unlanded work, which keeps its claim")
    return cfg


def release_on(cfg):
    return list((cfg.get("queue") or {}).get("release_on", RELEASE_ON))


def stop_on(cfg):
    return list((cfg.get("queue") or {}).get("stop_on", STOP_ON))


def parse_reset(r):
    return dt.datetime.strptime(r, "%Y-%m-%dT%H:%M").replace(tzinfo=dt.timezone.utc)


def reset_reached(cfg, at=None):
    r = cfg.get("reset_utc")
    if not r:
        return False
    return (at or now_utc()) >= parse_reset(r)


def check_repo_name(repo):
    """A repo is a plain name under repos_root, never a path: a path would miss
    its config entry and move the worktree out of its job folder."""
    if not repo or repo in (".", "..") or "/" in repo or "\0" in repo or repo != repo.strip():
        raise Refusal(EXIT_USAGE, f"repo must be a plain name under repos_root, not {repo!r}")
    return repo


def parse_sets(pairs):
    """--set K=V values; one with no '=' is a usage error, never a traceback."""
    out = {}
    for s in pairs:
        if "=" not in s:
            raise Refusal(EXIT_USAGE, f"--set {s!r}: expected K=V")
        k, v = s.split("=", 1)
        out[k] = v
    return out


def permission_args(cfg):
    """What the config grants an unattended session beyond asking (its
    claude_args flags and its `settings` permissions), and whether any of it is
    a bypass (nothing is asked at all). Since user-level settings are not
    loaded, this is the whole grant but for a repo's own settings files."""
    args, found, bypass = cfg.get("claude_args") or [], [], False
    for i, a in enumerate(args):
        a = str(a)
        flag = a.split("=", 1)[0]
        if flag not in PERMISSION_FLAGS:
            continue
        value = a.split("=", 1)[1] if "=" in a else (
            str(args[i + 1]) if flag not in PERMISSION_FLAGS[:2] and i + 1 < len(args) else "")
        found.append(f"{flag} {value}".strip())
        if flag == PERMISSION_FLAGS[0] or (flag == "--permission-mode" and value == "bypassPermissions"):
            bypass = True
    perms = (cfg.get("settings") or {}).get("permissions")
    for k in GRANT_KEYS if isinstance(perms, dict) else ():
        v = perms.get(k)
        if v:
            found.append(f"settings {k} {', '.join(map(str, v)) if isinstance(v, list) else v}")
            bypass = bypass or (k == "defaultMode" and v == "bypassPermissions")
    return found, bypass


# ---------- the session's settings: the config is the whole grant ----------
#
# A headless session would otherwise load the operator's user-level settings,
# whose allow rules, default mode and extra directories widen whatever the
# config narrows (found 2026-11-23: a config without python3 in its tool list
# ran python3 anyway). So every launch passes --setting-sources project,local,
# which leaves the user-level settings file out, and --settings with a file
# ccfleet writes: the user-level settings with their grants taken out (hooks,
# deny and ask rules, plugins and env kept: they restrict or equip, they do
# not grant), then the config's own `settings` on top. Leaving the user source
# out also leaves out the user-level CLAUDE.md (checked against claude 2.1.x),
# so ccfleet appends it to the system prompt (--append-system-prompt-file):
# the operator's standing instructions still bind an unattended session.
SETTING_SOURCES = "project,local"
# The permission keys that widen what a session may do: never carried over.
GRANT_KEYS = ("allow", "defaultMode", "additionalDirectories")
# Launch flags ccfleet sets itself: in claude_args they would undo the above.
OWNED_FLAGS = ("--setting-sources", "--settings", "--append-system-prompt", "--append-system-prompt-file")
# A hook command that prints an allow decision approves tool calls: a grant.
GRANTING_HOOK_RX = re.compile(r"permissionDecision\W{0,8}allow", re.I)


def read_settings(path, required=True):
    """A settings file as a dict; {} when it does not exist. One that cannot be
    read is a refusal when `required` (the user's: launching without it would
    silently drop its guard hooks and deny rules), else None."""
    try:
        with open(path, encoding="utf-8") as f:
            d = json.load(f)
        if not isinstance(d, dict):
            raise ValueError("not a JSON object")
        return d
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        if not required:
            return None
        raise Refusal(EXIT_SETUP, f"cannot read the user settings {path} ({e}): launching without them "
                                  f"would drop their hooks and deny rules")


def merge_settings(base, over):
    """`over` on top of `base`: objects merge key by key, lists join without
    repeats, any other value is `over`'s."""
    out = dict(base)
    for k, v in over.items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = merge_settings(out[k], v)
        elif isinstance(v, list) and isinstance(out.get(k), list):
            out[k] = out[k] + [x for x in v if x not in out[k]]
        else:
            out[k] = v
    return out


def user_settings_path():
    return os.path.join(config_dir(), "settings.json")


def hook_commands(group):
    return [str(h.get("command", "")) for h in group.get("hooks", []) if isinstance(h, dict)]


def session_settings(cfg):
    """(settings, notes): the user-level settings less their grants and less
    the hooks that grant or that the config drops, with the config's own
    `settings` on top; and what was left out, for `check` and the man page's
    account. A hook command is dropped when it prints an allow decision or
    holds a drop_hooks text; the other commands of its entry are kept."""
    user = read_settings(user_settings_path())
    notes = {"grants": [], "dropped_hooks": [], "kept_hooks": []}
    perms = user.get("permissions")
    if isinstance(perms, dict):
        perms = dict(perms)
        for k in GRANT_KEYS:
            if k in perms:
                v = perms.pop(k)
                if k == "allow":
                    notes["grants"].append(f"allow ({len(v) if isinstance(v, list) else v} rule(s))")
                else:
                    notes["grants"].append(f"{k} {', '.join(map(str, v)) if isinstance(v, list) else v}")
        user = {**user, "permissions": perms}
    hooks = user.get("hooks")
    if isinstance(hooks, dict):
        kept = {}
        for event, groups in hooks.items():
            for g in groups if isinstance(groups, list) else []:
                if not isinstance(g, dict):
                    continue
                where = f"{event} {g.get('matcher', '*') or '*'}"
                left = []
                for h in g.get("hooks", []) if isinstance(g.get("hooks"), list) else []:
                    c = str(h.get("command", "")) if isinstance(h, dict) else ""
                    drop = [d for d in cfg.get("drop_hooks", []) if d in c]
                    if GRANTING_HOOK_RX.search(c) or drop:
                        why = f"drop_hooks {drop[0]!r}" if drop else "approves tool calls"
                        notes["dropped_hooks"].append(f"{where} ({why})")
                        continue
                    left.append(h)
                    notes["kept_hooks"].append(f"{where}: {c}")
                if left:
                    kept.setdefault(event, []).append({**g, "hooks": left})
        user = {**user, "hooks": kept}
    return merge_settings(user, cfg.get("settings") or {}), notes


def user_instructions_path():
    return os.path.join(config_dir(), "CLAUDE.md")


# Set when a signal stops a launcher whose session runs on: its settings
# copies are that session's, so the launcher's exit leaves them (PK1).
LEFT_RUNNING = []
# A per-session copy's name: <session>.<launcher pid>.json, or
# <session>.<launcher pid>-user-instructions.md.
COPY_RX = re.compile(r"(.+)\.(\d+)(?:\.json|-user-instructions\.md)")


def remove_session_files(paths):
    if LEFT_RUNNING:
        return  # the session still runs and may read them again; the next launch sweeps them
    for p in paths:
        if p:
            try:
                os.remove(p)
            except OSError:
                pass


def sweep_session_files(cfg):
    """Remove the per-session copies nobody holds any more: those whose
    launcher (the pid in the name) is gone and that no live session record
    lists (a launcher stopped by a signal leaves them to its session, PK1).
    A copy of another name (an older layout) is left for the operator."""
    d = os.path.join(cfg["kit_dir"], "settings")
    try:
        names = os.listdir(d)
    except OSError:
        return
    held = {os.path.realpath(c) for _, rec in live_records(cfg) for c in rec["copies"]}
    for name in names:
        m = COPY_RX.fullmatch(name)
        if not m:
            continue
        path = os.path.join(d, name)
        pid = int(m.group(2))
        if pid == os.getpid() or alive(pid) or os.path.realpath(path) in held:
            continue
        try:
            os.remove(path)
        except OSError:
            pass


# The harness's rules for an @-import in a CLAUDE.md (Claude Code's memory
# page, "Import additional files", code.claude.com/docs/en/memory): a path is
# relative to the file that imports it, not the working directory; imports
# nest to at most four hops; an import inside a code span or a fenced code
# block is not one; the path ends at the first space a backslash does not
# escape; a quoted path is not imported; an import may stand anywhere in the
# text, a sentence included ("reference them with @ syntax anywhere"). The
# page says nothing of a missing file or a cycle: here each is left as its
# line, with a note. ccfleet follows (inlines) only an import on a line of its
# own, which a block quote, a heading, a list bullet or number and a task box
# may lead (IMPORT_LINE); one inside a line of other text (IMPORT_TOKEN) is
# left as text for a private repo's session and withheld from a public one
# (DP18).
IMPORT_HOPS = 4
_IMPORT_PATH = r"@((?:\\ |[^\s`\"'])(?:\\ |[^\s`])*)"
IMPORT_LINE = re.compile(r"[ \t]*(?:>[ \t]*)*(?:#{1,6}[ \t]+|(?:[-*+]|\d{1,9}[.)])[ \t]+(?:\[[ xX]\][ \t]+)?)?"
                         + _IMPORT_PATH + r"[ \t]*")
# An import anywhere in a line: an @ at the line's start or after white space.
IMPORT_TOKEN = re.compile(r"(?<!\S)" + _IMPORT_PATH)
CODE_SPAN = re.compile(r"(`+)(?!`).*?(?<!`)\1(?!`)")
FENCE = re.compile(r" {0,3}(`{3,}|~{3,})")


def expand_imports(text, base, hops=0, chain=(), found=None):
    """`text` (a file in directory `base`) with each import line replaced by
    the file it names, itself expanded, as the harness reads memory imports
    (IMPORT_HOPS, IMPORT_LINE). One that cannot be followed (past the hop
    limit, a cycle, no such file, unreadable) stays as its line with a note
    below it. `found` collects (as written, resolved path, what was done)."""
    found = [] if found is None else found
    out, fence = [], None
    for line in text.splitlines(keepends=True):
        f = FENCE.match(line)
        if fence:
            if f and f.group(1)[0] == fence[0] and len(f.group(1)) >= len(fence) and not line[f.end():].strip():
                fence = None
            out.append(line)
            continue
        if f:
            fence = f.group(1)
            out.append(line)
            continue
        m = IMPORT_LINE.fullmatch(line.rstrip("\r\n"))
        if not m:
            out.append(line)
            continue
        raw = m.group(1)
        target = os.path.normpath(os.path.join(base, os.path.expanduser(raw.replace("\\ ", " "))))
        real = os.path.realpath(target)
        why, body = None, None
        if hops >= IMPORT_HOPS:
            why = f"past the harness's limit of {IMPORT_HOPS} hops"
        elif real in chain:
            why = "a cycle: it is already being imported"
        elif not os.path.isfile(target):
            why = "no such file"
        else:
            try:
                with open(target, encoding="utf-8", errors="replace") as fh:
                    body = fh.read()
            except OSError as e:
                why = f"cannot be read ({e.strerror})"
        line = line if line.endswith("\n") else line + "\n"
        if why:
            found.append((raw, target, f"not followed: {why}"))
            out.append(line + f"<!-- ccfleet: @{raw} not followed: {why} ({target}) -->\n")
            continue
        found.append((raw, target, "inlined"))
        inner = expand_imports(body, os.path.dirname(target), hops + 1, chain + (real,), found)
        out.append(f"<!-- ccfleet: @{raw} inlined from {target} -->\n" + inner
                   + ("" if inner.endswith("\n") or not inner else "\n")
                   + f"<!-- ccfleet: end of {target} -->\n")
    return "".join(out)


WITHHELD_IMPORT = "<!-- ccfleet: an @-import line withheld from this session -->\n"
WITHHELD_TOKEN = "[an @-import withheld]"


def outside_fences(text):
    """(line, in_fence) for each line of `text`, keepends: a line inside a
    fenced code block, or a fence line itself, is in a fence."""
    fence = None
    for line in text.splitlines(keepends=True):
        f = FENCE.match(line)
        if fence:
            if f and f.group(1)[0] == fence[0] and len(f.group(1)) >= len(fence) and not line[f.end():].strip():
                fence = None
            yield line, True
        elif f:
            fence = f.group(1)
            yield line, True
        else:
            yield line, False


def import_tokens(line):
    """The imports inside a line of text, outside its code spans: match
    objects of IMPORT_TOKEN, read with the spans blanked out."""
    masked = CODE_SPAN.sub(lambda m: " " * len(m.group(0)), line)
    return list(IMPORT_TOKEN.finditer(masked))


def inline_imports(text, base):
    """The imports inside a line of other text (not on a line of their own,
    not in a fenced block or code span), each as (as written, resolved path,
    what ccfleet does with it): the harness would follow them, ccfleet does
    not inline them, and a public session gets each withheld (DP18)."""
    out = []
    for line, fenced in outside_fences(text):
        if fenced or IMPORT_LINE.fullmatch(line.rstrip("\r\n")):
            continue
        for m in import_tokens(line):
            raw = m.group(1)
            # A sentence's own punctuation may close the path ("see @a.md,"):
            # where only the path without it is a file, that is the target.
            for r in (raw, raw.rstrip(".,;:!?)]}")):
                target = os.path.normpath(os.path.join(base, os.path.expanduser(r.replace("\\ ", " "))))
                if os.path.exists(target):
                    break
            else:
                target = os.path.normpath(os.path.join(base, os.path.expanduser(raw.replace("\\ ", " "))))
            out.append((raw, target, "inside a line of text: left as text, not inlined"))
    return out


def withhold_imports(text):
    """`text` with each import line (as expand_imports reads one: on a line of
    its own, outside a fenced block) replaced by WITHHELD_IMPORT, and each
    import inside a line of other text (inline_imports) by WITHHELD_TOKEN,
    neither of which names a path: a public session is not told where the
    withheld file is (PK5, DP18)."""
    out = []
    for line, fenced in outside_fences(text):
        if fenced:
            out.append(line)
        elif IMPORT_LINE.fullmatch(line.rstrip("\r\n")):
            out.append(WITHHELD_IMPORT)
        else:
            for m in reversed(import_tokens(line)):
                line = line[:m.start()] + WITHHELD_TOKEN + line[m.end():]
            out.append(line)
    return "".join(out)


def read_instructions(visibility):
    """(path, text, found, inline): instructions_text, and the imports inside
    a line of other text (inline_imports), which `found` does not list."""
    umd = user_instructions_path()
    if not os.path.isfile(umd):
        return umd, None, [], []
    with open(umd, encoding="utf-8", errors="replace") as f:
        text = f.read()
    found = []
    inlined = expand_imports(text, os.path.dirname(umd), chain=(os.path.realpath(umd),), found=found)
    inline = inline_imports(text, os.path.dirname(umd))
    return umd, (inlined if visibility == "PRIVATE" else withhold_imports(text)), found, inline


def instructions_text(visibility):
    """What a session for a repo of `visibility` is handed of the user-level
    instructions file, its header aside: for a private repo, the file with its
    imports inlined; for a public or unknown one, the file with each import
    withheld (withhold_imports), so an imported file reaches no public
    session and its path is not named. Returns (path, text, found), text None
    when there is no file; `found` lists every import line resolved, nested
    ones too, for either visibility (a public session's settings deny Read of
    each, and of each import inside a line of text, import_denies). The guard
    reads this same text, so it reads exactly what is appended."""
    return read_instructions(visibility)[:3]


def read_denies(paths, tree=False):
    """A deny rule for Read of each path, by the path and by its real path
    ("//" begins an absolute path in a permission rule; "/**" takes a whole
    folder), so a path reached through a link is denied by both names."""
    rules = []
    for p in paths:
        for path in (p, os.path.realpath(p)):
            rule = f"Read(/{path}{'/**' if tree else ''})"
            if rule not in rules:
                rules.append(rule)
    return rules


def import_denies(found):
    """A deny rule for Read of each file the user-level imports resolve to,
    by its path and its real path: what a public or unknown repo's session
    must not open."""
    return read_denies(target for _, target, _ in found)


def kit_denies(cfg):
    """A deny rule for Read of <kit_dir>/settings/ and <kit_dir>/sessions/,
    for every session (DP3): the first holds every running session's copies
    (a private repo's with its imports inlined, a public repo's naming the
    withheld files in its deny rules), the second their process records, and
    both sit two steps from the {SCRATCH} folder every session is told. No
    session reads either: Claude Code reads its own two copies at start, by
    the flags, not by a tool."""
    return read_denies((os.path.join(cfg["kit_dir"], d) for d in ("settings", "sessions")), tree=True)


# Auto memory: Claude Code loads the first 200 lines (or 25 KB) of the
# project's MEMORY.md into every session with auto memory on, one folder per
# repository shared by all its worktrees, whatever --setting-sources says. It
# is written by the operator's own earlier sessions, so it may name anything
# they knew. Switched off by the setting autoMemoryEnabled false (read from
# any settings file) or the environment variable
# CLAUDE_CODE_DISABLE_AUTO_MEMORY=1: Claude Code's memory page, "Enable or
# disable auto memory" (code.claude.com/docs/en/memory, fetched 2026-11-26),
# and the settings reference's index (autoMemoryEnabled: "Any file"). Neither
# page says the setting is honoured from --settings, so a public or unknown
# repo's session gets both, the variable through the copy's env block (DP4).
# Not tested against a live session.
NO_AUTO_MEMORY = {"autoMemoryEnabled": False, "env": {"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"}}


def session_files(cfg, sid, visibility, write=True):
    """Write (unless not `write`) the session's settings file, and the
    user-level CLAUDE.md as an instructions file when there is one, under
    <kit_dir>/settings/. Returns their paths (the second None when there is no
    user CLAUDE.md). Its @-imports are inlined only when `visibility` is
    PRIVATE (instructions_text).

    They hold whatever the user-level env block and instruction file hold, so
    they live only as long as their session: removed when the ccfleet process
    that launched it exits, by which time its session has ended (each process
    launches one session; a resume writes fresh ones). They are not removed
    while the session runs, since it may read its settings file again: a
    launcher a signal stops leaves them, its process record lists them, and
    the next launch sweeps them once that session has ended (PK1). Each name
    carries the launcher's process id, so a sweep never takes the copies of a
    launch that has not yet recorded its session."""
    d = os.path.join(cfg["kit_dir"], "settings")
    me = os.getpid()
    spath, ipath = os.path.join(d, f"{sid}.{me}.json"), os.path.join(d, f"{sid}.{me}-user-instructions.md")
    if not os.path.isfile(user_instructions_path()):
        ipath = None
    if not write:
        return spath, ipath
    settings, _ = session_settings(cfg)
    umd, text, found, inline = read_instructions(visibility) if ipath else (None, None, [], [])
    # No session reads the folder of copies or of process records (DP3).
    settings = merge_settings(settings, {"permissions": {"deny": kit_denies(cfg)}})
    if visibility != "PRIVATE":
        # The imported files are withheld from this session: deny reading them
        # too, so nothing it is told or asked can open one (PK5, DP18); and
        # the repo's auto memory is not loaded into it (DP4).
        settings = merge_settings(settings, {"permissions": {"deny": import_denies(found + inline)}})
        settings = merge_settings(settings, NO_AUTO_MEMORY)
    sweep_session_files(cfg)
    os.makedirs(d, exist_ok=True)
    atexit.register(remove_session_files, (spath, ipath))
    fd = os.open(spath, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(settings, f, indent=1)
    if ipath:
        if visibility == "PRIVATE":
            head, how = f"# The operator's user-level instructions ({umd})", \
                "with each @-import on a line of its own inlined"
        else:
            head, how = "# The operator's user-level instructions", "with its @-imports withheld"
        fd = os.open(ipath, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(f"{head}\n\n"
                    f"ccfleet loads no user-level settings, so Claude Code does not load this file "
                    f"itself; it is passed here {how}, and binds as it would have.\n\n" + text)
    return spath, ipath


def repo_grants(wt):
    """What a worktree's own settings files (the project and local sources,
    which still load) grant, one line each: the config is not the whole grant
    where these say something, and each launch says so."""
    out = []
    for rel in (os.path.join(".claude", "settings.json"), os.path.join(".claude", "settings.local.json")):
        d = read_settings(os.path.join(wt, rel), required=False)
        if d is None:
            out.append(f"{rel}: unreadable (Claude Code ignores an invalid settings file)")
            continue
        perms = d.get("permissions") if isinstance(d.get("permissions"), dict) else {}
        got = [f"{k} {json.dumps(perms[k])}" for k in GRANT_KEYS if perms.get(k)]
        hooks = d.get("hooks") if isinstance(d.get("hooks"), dict) else {}
        if any(GRANTING_HOOK_RX.search(c) for gs in hooks.values() if isinstance(gs, list)
               for g in gs if isinstance(g, dict) for c in hook_commands(g)):
            got.append("a hook that approves tool calls")
        if got:
            out.append(f"{rel}: {'; '.join(got)}")
    return out


# ---------- headroom gate ----------

def read_mem_pct():
    """Free memory as a percentage, or None when it cannot be read."""
    if sys.platform == "darwin":
        try:
            out = subprocess.run(["memory_pressure", "-Q"], capture_output=True, text=True, timeout=20).stdout
            m = re.search(r"free percentage:\s*(\d+)", out)
            return int(m.group(1)) if m else None
        except (OSError, subprocess.SubprocessError):
            return None
    try:
        info = {}
        with open("/proc/meminfo") as f:
            for line in f:
                k, v = line.split(":", 1)
                info[k] = int(v.split()[0])
        return int(100 * info["MemAvailable"] / info["MemTotal"])
    except (OSError, KeyError, ValueError):
        return None


def read_headroom(cfg):
    l1, l5, l15 = os.getloadavg()
    probe = cfg["worktrees_root"]
    while not os.path.exists(probe):
        probe = os.path.dirname(probe)
    disk_gb = shutil.disk_usage(probe).free // 2**30
    return {"load": (l1, l5, l15), "mem_pct": read_mem_pct(), "disk_gb": disk_gb}


def gate_ok(gate, reading):
    """A start may go only when every reading has headroom. An unreadable
    memory figure holds (fail closed) unless min_mem_pct is 0."""
    l1, l5, _ = reading["load"]
    if l1 >= gate["max_load"] or l5 >= gate["max_load"]:
        return False
    if gate["min_mem_pct"] > 0 and (reading["mem_pct"] is None or reading["mem_pct"] < gate["min_mem_pct"]):
        return False
    return reading["disk_gb"] >= gate["min_disk_gb"]


def describe(reading):
    l = reading["load"]
    mem = "?" if reading["mem_pct"] is None else reading["mem_pct"]
    return f"load {l[0]:.1f}/{l[1]:.1f}/{l[2]:.1f} mem {mem}% disk {reading['disk_gb']}G"


# ---------- git facts ----------

def git(*args, cwd=None, check=True):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if check and r.returncode != 0:
        raise Refusal(EXIT_SETUP, f"git {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout.strip()


def repo_facts(cfg, repo, fetch=True, lookup=None):
    primary = os.path.join(cfg["repos_root"], repo)
    if not os.path.isdir(os.path.join(primary, ".git")) and not os.path.isfile(os.path.join(primary, ".git")):
        raise Refusal(EXIT_SETUP, f"not a git checkout: {primary}")
    rc = cfg["repos"].get(repo, {})
    remote = git("remote", "get-url", "origin", cwd=primary, check=False)
    facts = {"primary": primary, "remote": bool(remote)}
    if remote:
        if fetch:
            git("fetch", "-q", "origin", cwd=primary)
        # Not every repo's mainline is main.
        ref = git("symbolic-ref", "--short", "refs/remotes/origin/HEAD", cwd=primary, check=False)
        facts["defref"] = ref or "origin/main"
        facts["branch"] = facts["defref"].split("/", 1)[1]
        m = re.search(r"github\.com[:/](.+?)(?:\.git)?$", remote)
        facts["gh"] = rc.get("github") or (m.group(1) if m else remote)
    else:
        facts["defref"] = facts["branch"] = rc.get("branch", "main")
        facts["gh"] = rc.get("github", "(no remote)")
    vis = rc.get("visibility")
    if not vis and remote and shutil.which("gh") and (fetch if lookup is None else lookup):
        r = subprocess.run(["gh", "repo", "view", facts["gh"], "--json", "visibility", "-q", ".visibility"],
                           capture_output=True, text=True)
        vis = r.stdout.strip() if r.returncode == 0 else None
    facts["visibility"] = (vis or "UNKNOWN").upper()
    return facts


def worktree_branch(wt):
    """The branch a worktree is on, or None when its HEAD is detached."""
    r = subprocess.run(["git", "symbolic-ref", "-q", "--short", "HEAD"], cwd=wt, capture_output=True, text=True)
    return (r.stdout.strip() or None) if r.returncode == 0 else None


def landing_text(facts, wt, branch_name=None):
    if not facts["remote"] and not branch_name:
        b = facts["branch"]
        return (f"This repo has NO remote; local {b} is the mainline and your worktree's HEAD is detached. "
                f"Instead of pull/push: `git -C '{wt}' rebase {b}`, then land with `git -C '{facts['primary']}' "
                f"merge --ff-only <the commit `git -C '{wt}' rev-parse HEAD` prints>` against the primary "
                f"checkout (only while it is on {b}; if the merge refuses over uncommitted changes there, "
                f"wait and retry, never stash or absorb them). Never `git push`.")
    if facts["remote"]:
        b = facts["branch"]
        return (f"Land each commit with `git -C '{wt}' pull --rebase origin {b}` then "
                f"`git -C '{wt}' push origin HEAD:{b}` (unless this repo's CLAUDE.md requires "
                f"a PR; then open one and say so).")
    return (f"This repo has NO remote; local {facts['branch']} is the mainline and your worktree is on "
            f"branch {branch_name}. Instead of pull/push: `git -C '{wt}' rebase {facts['branch']}`, then land "
            f"with `git -C '{facts['primary']}' merge --ff-only {branch_name}` against the primary checkout "
            f"(only while it is on {facts['branch']}; if the merge refuses over uncommitted changes there, "
            f"wait and retry, never stash or absorb them). Never `git push`.")


# ---------- prompt rendering ----------

def render(template, values):
    out = PLACEHOLDER.sub(lambda m: str(values[m.group(1)]) if m.group(1) in values else m.group(0), template)
    left = sorted(set(PLACEHOLDER.findall(out)))
    return out, left


def private_hits(cfg, text, visibility):
    """Private names in a prompt bound for a public or unknown-visibility repo."""
    if visibility == "PRIVATE":
        return []
    names = set(cfg["private_names"])
    names |= {r for r, rc in cfg["repos"].items() if str(rc.get("visibility", "")).upper() == "PRIVATE"}
    # Only letters and digits continue a word: a name joined by '-', '_', '.'
    # or '/' (a <label>-<HHMM> worktree parent, a -kit kit_dir, name_notes,
    # atelier--name) is still the name. "[^\W_]" is a letter or digit.
    return sorted(n for n in names if n and re.search(r"(?<![^\W_])" + re.escape(n) + r"(?![^\W_])", text, re.I))


def build_prompt(cfg, template_path, values, template_text=None):
    if template_text is None:
        template_text = read_template(template_path)
    text, left = render(template_text, values)
    if left:
        raise Refusal(EXIT_GUARD, f"unfilled placeholder(s) in {template_path}: {', '.join('{'+k+'}' for k in left)}")
    hits = private_hits(cfg, text, values.get("VIS", "UNKNOWN"))
    if hits:
        raise Refusal(EXIT_GUARD, f"refused: the prompt for {values.get('REPO')} ({values.get('VIS')}) names "
                                  f"private name(s) {', '.join(hits)}")
    guard_instructions(cfg, values.get("REPO"), values.get("VIS", "UNKNOWN"))
    return text


def instruction_hits(cfg, visibility):
    """Private names in the user-level instructions file every launch appends
    to the session's system prompt (session_files), for a public or
    unknown-visibility repo: in the text that is appended, which leaves its
    @-imports unfollowed, so a name only an imported file holds is none here.
    One that cannot be read has none here; reading it for the launch fails
    loudly instead."""
    if visibility == "PRIVATE":
        return []
    try:
        _, text, _ = instructions_text(visibility)
    except OSError:
        return []
    return private_hits(cfg, text, visibility) if text is not None else []


def guard_instructions(cfg, repo, visibility):
    """The private-name guard over what else a launch hands the session: the
    user-level instructions file. With instructions_guard "refuse" (the
    default) a public or unknown-visibility repo's launch is refused, as a
    prompt naming one is: a publication cannot be retracted. With "warn" it
    goes on, and a line per name says so at launch."""
    hits = instruction_hits(cfg, visibility)
    if not hits:
        return
    p = user_instructions_path()
    if cfg.get("instructions_guard", "refuse") == "warn":
        for n in hits:
            print(f"INSTRUCTIONS name private name {n}: {p} is appended to this {visibility} repo's session "
                  f"anyway (instructions_guard warn; man ccfleet, THREATS)", flush=True)
        return
    raise Refusal(EXIT_GUARD, f"refused: {p}, appended to every session's system prompt, names private "
                              f"name(s) {', '.join(hits)}, and {repo} is {visibility}; take the names out of "
                              f"it, or set instructions_guard to warn to append it anyway (man ccfleet, THREATS)")


# ---------- one session ----------

def config_dir():
    """Claude Code's own directory: $CLAUDE_CONFIG_DIR, else ~/.claude."""
    return expand(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude")


def message_text(msg):
    """The text blocks of a transcript message, joined."""
    if not isinstance(msg, dict):
        return ""
    c = msg.get("content")
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return "\n".join(b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text")
    return ""


def shaped_results(text):
    """The captured words of each RESULT line in `text` that stands in the
    final-output shape the prompts fix. Two shapes:

    - the review prompts (RESULT, then ITEM): directly above an ITEM: or
      REPO: line;
    - the fleet prompts (REPO first, RESULT last): the text's last line,
      closing a block, with no blank line in it, that holds an ITEM: or
      REPO: line.

    A line that is only a code fence (```) is not counted as the last line,
    so a report fenced whole still ends on its RESULT. When the text holds
    no other RESULT line, blank lines may part the RESULT line from its
    ITEM: line, and the fleet block may hold blank lines (a list spaced out,
    a field on several lines), since with one RESULT line in the text there
    is nothing it could be mistaken for (DP2). Any other RESULT line, an
    earlier mention or one followed by more text, is not one (PK4): a
    verdict is never read from the middle of a block."""
    lines = (text or "").splitlines()
    marked = [i for i, line in enumerate(lines) if RESULT_RX.match(line)]
    alone = len(marked) == 1
    filled = [i for i, line in enumerate(lines) if line.strip() and not FENCE_RX.match(line)]
    last = filled[-1] if filled else -1
    out = []
    for i in marked:
        m = RESULT_RX.match(lines[i])
        j = i + 1
        while alone and j < len(lines) and not lines[j].strip():
            j += 1
        if j < len(lines) and SHAPE_RX.match(lines[j]):
            out.append(m.group(1))
        elif i == last:
            j = i - 1
            while j >= 0 and (alone or lines[j].strip()):
                if SHAPE_RX.match(lines[j]):
                    out.append(m.group(1))
                    break
                j -= 1
    return out


def verdict_phrase(captured, known=()):
    """A known phrase (e.g. BUDGET EXHAUSTED) kept whole, else the first
    capital-letter word."""
    words = captured.split()
    for phrase in sorted((k.split() for k in known), key=len, reverse=True):
        if phrase and words[:len(phrase)] == phrase:
            return " ".join(phrase)
    return words[0]


def result_word(text, known=(), stops=(), clean=None):
    """The verdict of `text`, or "" when there is none: the RESULT line in the
    final-output shape (shaped_results), so neither a later mention ("NOTES:
    ... RESULT: DONE", RK3) nor an earlier one ("RESULT: DONE is not what this
    is", PK4) is read. Two shaped verdicts that disagree are none.

    A clean word (`clean`: by default the words of `known` not in `stops`)
    stands only when no other RESULT line in the text names a word that is
    not clean (DP6): a quoted, well-shaped DONE never outranks the session's
    own FAILED that drifted out of the shape, and a quoted stop word after a
    shaped DONE gives no verdict rather than halting a drain. A word in
    `stops` on a RESULT line out of the shape is kept only when no shaped
    verdict stands at all: a session cut off by its budget may not manage
    the shape, and stopping then spares the passes that would fail after it."""
    clean = set(known) - set(stops) if clean is None else set(clean)
    every = [verdict_phrase(w, known) for w in RESULT_RX.findall(text or "")]
    shaped = {verdict_phrase(w, known) for w in shaped_results(text)}
    if len(shaped) == 1:
        word = shaped.pop()
        if word not in clean or all(w in clean for w in every):
            return word
        return ""
    if not shaped:
        for w in every:
            if w in stops:
                return w
    return ""


def result_line(text, known=(), stops=()):
    """How the text's RESULT lines read: "in-shape" (one gave the verdict),
    "out-of-shape" (a line begins RESULT: but none gave one), or "none" (no
    line begins RESULT:). The END line carries it, so a drain tells a session
    that wrote its verdict out of the shape from one that wrote none (DP2)."""
    if not RESULT_RX.search(text or ""):
        return "none"
    return "in-shape" if result_word(text, known, stops) else "out-of-shape"


def transcript_result(sid, since=None):
    """The newest assistant text in the session's own transcript
    (<config dir>/projects/*/<sid>.jsonl) that carries a RESULT: line AND an
    ITEM: or REPO: line of the final-output shape, or "". Entries stamped
    before `since` (ISO UTC) are not read, so a resumed session never takes an
    earlier run's verdict; a line of planning narration that mentions a
    RESULT is not a report, so it is never taken."""
    if not sid or not re.fullmatch(r"[A-Za-z0-9_-]+", sid):
        return ""
    best = ("", -1, "")
    for path in glob.glob(os.path.join(glob.escape(config_dir()), "projects", "*", sid + ".jsonl")):
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                lines = f.readlines()
        except OSError:
            continue
        for n, line in enumerate(lines):
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if not isinstance(e, dict) or e.get("type") != "assistant":
                continue
            ts = str(e.get("timestamp") or "")
            if since and ts and ts < since:
                continue
            text = message_text(e.get("message"))
            if shaped_results(text) and (ts, n) >= best[:2]:
                best = (ts, n, text)
    return best[2]


def harvest(log_path, since=None, rc=0, known=tuple(RELEASE_ON + STOP_ON), stops=tuple(STOP_ON)):
    """(result text, session id, RESULT word) from a `claude -p --output-format json` log.

    An end is clean only when the session exited 0 and its JSON flags no
    error. A nonzero exit or an error flag reads as ERROR (TIMEOUT for a
    session killed at its time limit), whatever its text says, and never takes
    the transcript fallback: a cut-off pass is never read as DONE. The one
    exception is a word in `stops` (such as BUDGET EXHAUSTED, printed by the
    session itself), which is kept, since stopping is the safe direction.
    `known` lists the multi-word verdicts read whole.

    On a clean end a verdict counts only beside the final output's shape line
    (ITEM: or REPO:), as in the transcript fallback; a `stops` word is the one
    exception. Output that is not the JSON log reads UNKNOWN, but for a
    `stops` word (RK3: a stray "RESULT: DONE" in a log's tail read DONE).

    `claude -p` prints only the last turn. A session whose last turn came after
    a background notification (a subagent finishing) can print a line with no
    RESULT in it while its real report sits earlier; then, on a clean end
    only, the transcript is read for the newest report-shaped text."""
    try:
        with open(log_path, encoding="utf-8", errors="replace") as f:
            s = f.read()
    except OSError:
        s = ""
    j = None
    try:
        j = json.loads(s[s.index("{"):])
        if not isinstance(j, dict):
            raise ValueError
        text, sid = str(j.get("result", "") or ""), str(j.get("session_id", "") or "")
    except (ValueError, AttributeError):
        j, text, sid = None, s[-4000:], ""
    flagged = bool(j and (j.get("is_error") or j.get("subtype") not in (None, "success")))
    word = result_word(text, known, stops)
    if rc != 0 or flagged:
        why = f"rc={rc}" + (f", subtype={j.get('subtype')}" if j and j.get("subtype") else "") + \
              (", is_error" if j and j.get("is_error") else "")
        verdict = "TIMEOUT" if rc == TIMEOUT_RC else "ERROR"
        if word and word in stops:
            verdict = word
        return f"(an error end, {why}: never read as clean)\n{text}", sid, verdict
    if word and word not in stops and j is None:
        # Not the final output: unreadable output (result_word already reads
        # only a RESULT line in the final-output shape). Only the transcript
        # can still give one.
        word = ""
    if not word and sid:
        t = transcript_result(sid, since)
        if t:
            text = "(read from the session transcript: the last turn printed no RESULT line)\n" + t
            word = result_word(t, known, stops)
    return text, sid, (word or "UNKNOWN")


def models_used(log_path):
    """The models a session's JSON log names in modelUsage, comma-separated,
    or "-" when it names none: the orchestrator's own, and a reviewer's when
    it ran on another model. The END line carries it, so a pass's record shows
    the model its reviewer ran on (DV3), beside the REVIEW_MODEL it was told
    (review_model=, told_review_model; DP15)."""
    j = read_log_json(log_path) or {}
    mu = j.get("modelUsage")
    names = sorted(str(m) for m in mu) if isinstance(mu, dict) else []
    return ",".join(re.sub(r"[\s,]", "_", n) for n in names) or "-"


def told_review_model(values, template_text):
    """The REVIEW_MODEL the session was told, for its END line: the value
    its prompt was filled with when the prompt names {REVIEW_MODEL}, else
    "-" (the prompt told it no review model). Spaces become underscores so
    the line keeps one field per word (DP15)."""
    if "{REVIEW_MODEL}" not in (template_text or "") or not str(values.get("REVIEW_MODEL", "")).strip():
        return "-"
    return re.sub(r"\s", "_", str(values["REVIEW_MODEL"]).strip())


def end_line(log, line):
    """Print a session's END line, and keep it beside its log (<log>.end), so
    the cost history reads a resume's or a fold's own verdict, its exit code
    and an UNLANDED included, rather than its JSON alone (PK12)."""
    print(line, flush=True)
    try:
        with open(log + ".end", "w", encoding="utf-8") as f:
            f.write(line + "\n")
    except OSError:
        pass


def stamp_dir(root, label):
    stamp = now_utc().strftime("%H%M")
    parent = os.path.join(root, f"{label}-{stamp}")
    if os.path.exists(parent):
        parent += now_utc().strftime("%S")
    return parent


def session_argv(cfg, model, prompt, resume=None, session_id=None, files=(None, None)):
    """The launch line. A new session is given its id up front (--session-id),
    so a session killed before it prints anything still has a known id: the
    START line, the claim and the result file carry it, and `resume` can use it.
    `files` are the session's settings and user-instructions files
    (session_files): no user-level settings load, so the config is the grant."""
    argv = []
    if cfg["nice"]:
        argv += ["nice", "-n", str(cfg["nice"])]
    argv += [cfg["claude_bin"], "-p"]
    if resume:
        argv += ["--resume", resume]
    elif session_id:
        argv += ["--session-id", session_id]
    settings, instructions = files
    argv += ["--setting-sources", SETTING_SOURCES]
    if settings:
        argv += ["--settings", settings]
    if instructions:
        argv += ["--append-system-prompt-file", instructions]
    argv += ["--model", model, *cfg["claude_args"], "--output-format", "json", prompt]
    return argv


def session_env(cfg):
    """The launch environment: ours, the config's `env`, and the wait ceiling
    switched off, always (see CEILING_VAR)."""
    env = dict(os.environ)
    env.update({str(k): str(v) for k, v in cfg.get("env", {}).items()})
    env[CEILING_VAR] = "0"
    return env


def kill_group(p, grace=30):
    """End a session and everything it started: TERM to its process group,
    then KILL after `grace` seconds."""
    for sig, wait in ((signal.SIGTERM, grace), (signal.SIGKILL, 10)):
        try:
            os.killpg(p.pid, sig)
        except (ProcessLookupError, PermissionError):
            pass
        try:
            p.wait(timeout=wait)
            return
        except subprocess.TimeoutExpired:
            continue


def session_pid_path(cfg, sid):
    return os.path.join(cfg["kit_dir"], "sessions", f"{safe(sid)}.pid")


def read_session_record(path):
    """A process record: the session's pid, its launcher's pid, when, the
    worktree it runs in and its settings copies (tab-separated; a record an
    earlier ccfleet wrote has only the first three)."""
    with open(path) as f:
        fields = f.read().rstrip("\n").split("\t")
    return {"pid": int(fields[0]), "wt": fields[3] if len(fields) > 3 else "",
            "copies": [c for c in fields[4:] if c]}


def live_session(cfg, sid):
    """The process id of session `sid` when a launcher recorded it and it still
    runs (a process by that id whose command line names the session), else
    None. A record whose process is gone is removed."""
    if not sid:
        return None
    path = session_pid_path(cfg, sid)
    try:
        pid = read_session_record(path)["pid"]
    except (OSError, ValueError, IndexError):
        return None
    if alive(pid):
        r = subprocess.run(["ps", "-ww", "-o", "command=", "-p", str(pid)], capture_output=True, text=True)
        if sid in r.stdout:
            return pid
    try:
        os.remove(path)
    except OSError:
        pass
    return None


def live_records(cfg):
    """(session id, record) for each recorded session that still runs."""
    out = []
    for path in sorted(glob.glob(os.path.join(glob.escape(cfg["kit_dir"]), "sessions", "*.pid"))):
        sid = os.path.basename(path)[:-len(".pid")]
        if live_session(cfg, sid):
            try:
                out.append((sid, read_session_record(path)))
            except (OSError, ValueError, IndexError):
                pass
    return out


def refuse_live_worktree(cfg, wt):
    """Refuse a launch into a worktree a recorded session still runs in: a
    second session there would take the worktree from under the first (a
    fold whose pass's launcher was stopped looks like a cut-off pass, PK2)."""
    real = os.path.realpath(wt)
    for sid, rec in live_records(cfg):
        if rec["wt"] and os.path.realpath(rec["wt"]) == real:
            raise Refusal(EXIT_CLAIM, f"session {sid} still runs in {wt} (pid {rec['pid']}): its launcher "
                                      f"died or still watches it, and a launch beside it would take the "
                                      f"worktree from under it. Wait for it to end, or end it (kill -TERM "
                                      f"-{rec['pid']}; what it has not saved is lost), then launch")


class LauncherSignal(BaseException):
    """SIGTERM or SIGHUP to a launcher watching a session."""


def launch(cfg, argv, cwd, log, sid=None):
    """Run one session to its end and return its exit code. A session still
    running at session_timeout_minutes (0: no limit) is ended, with its whole
    process group, and returns TIMEOUT_RC: a session that never exits would
    otherwise hold its slot, and the driver and its lock, past the reset.

    The session runs in its own process session, so it outlives a launcher
    that dies (RK4). Its process id is recorded at
    <kit_dir>/sessions/<sid>.pid for as long as it may run: `resume` refuses
    while it lives, and a drain names it. A SIGTERM or SIGHUP to the launcher
    leaves the session running (its worktree may hold unsaved work), says so
    and exits 128+signal; a ^C ends the session with it, as before."""
    limit = cfg.get("session_timeout_minutes") or 0
    pid_path = session_pid_path(cfg, sid) if sid else None

    def on_signal(signum, _frame):
        raise LauncherSignal(signum)

    # stdin from /dev/null, always: see the module docstring. Its own process
    # group, so a time limit ends everything it started.
    with open(log, "w") as out, open(log + ".err", "w") as err:
        p = subprocess.Popen(argv, cwd=cwd, stdin=subprocess.DEVNULL, stdout=out, stderr=err,
                             env=session_env(cfg), start_new_session=True)
        if pid_path:
            # The worktree and the settings copies too: a launch into the
            # worktree is refused, and the copies kept, while it runs (PK1, PK2).
            copies = [argv[argv.index(f) + 1] for f in ("--settings", "--append-system-prompt-file")
                      if f in argv[:-1]]
            os.makedirs(os.path.dirname(pid_path), exist_ok=True)
            with open(pid_path, "w") as f:
                f.write("\t".join([str(p.pid), str(os.getpid()), f"{now_utc():%Y-%m-%dT%H:%M:%SZ}",
                                   os.path.abspath(cwd), *copies]) + "\n")
        before = {}
        for sig in (signal.SIGTERM, signal.SIGHUP):
            try:
                before[sig] = signal.signal(sig, on_signal)
            except (ValueError, OSError):  # not the main thread
                pass
        ended = True
        try:
            return p.wait(timeout=limit * 60 if limit else None)
        except subprocess.TimeoutExpired:
            print(f"TIMEOUT {now_utc():%Y-%m-%dT%H:%M:%SZ} the session ran past "
                  f"session_timeout_minutes={limit}; ending it", flush=True)
            kill_group(p)
            return TIMEOUT_RC
        except LauncherSignal as e:
            ended = False
            LEFT_RUNNING.append(sid or p.pid)  # its settings copies stay with it (PK1)
            try:
                print(f"LAUNCHER STOPPED {now_utc():%Y-%m-%dT%H:%M:%SZ} by signal {e.args[0]}: the session "
                      f"(pid {p.pid}{', session ' + sid if sid else ''}) is left running, unwatched; its "
                      f"claim and worktree stay, and a resume is refused while it runs", flush=True)
            except OSError:
                pass  # a closed terminal
            raise SystemExit(128 + int(e.args[0]))
        except BaseException:
            kill_group(p, grace=5)  # a ^C to ccfleet ends its session too
            raise
        finally:
            for sig, h in before.items():
                signal.signal(sig, signal.SIG_DFL if h is None else h)
            if pid_path and ended and p.poll() is not None:
                try:
                    os.remove(pid_path)
                except OSError:
                    pass


def iso_now():
    return f"{now_utc():%Y-%m-%dT%H:%M:%S}"


def read_at_file(v):
    """A variable written `@file:PATH` takes the file's text (a multi-line task)."""
    if isinstance(v, str) and v.startswith("@file:"):
        with open(expand(v[6:]), encoding="utf-8") as f:
            return f.read().rstrip("\n")
    return v


def safe(s):
    return re.sub(r"[^A-Za-z0-9._-]+", "-", s).strip("-")


def resolve_pin(cfg, facts):
    """(pin, source) for a repo: tools/pins.py's reading of its checkout, else
    the first atelier@<sha> in its CLAUDE.md on the mainline (or in the
    checkout), else ("UNRESOLVED", why). Atelier is vars.ATELIER, else the
    checkout this file lives in."""
    atelier = expand(cfg["vars"].get("ATELIER") or
                     os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
    pins = os.path.join(atelier, "tools", "pins.py")
    primary = facts["primary"]
    if os.path.isfile(pins):
        try:
            r = subprocess.run([sys.executable, pins, "--atelier", atelier, "--head", "--child", primary,
                                "--json"], capture_output=True, text=True, timeout=120,
                               stdin=subprocess.DEVNULL)
            kids = json.loads(r.stdout).get("children") or []
            if kids and kids[0].get("pin"):
                return str(kids[0]["pin"]).lower(), "pins.py"
        except (OSError, subprocess.SubprocessError, ValueError, AttributeError):
            pass
    text = git("show", f"{facts['defref']}:CLAUDE.md", cwd=primary, check=False)
    if not text:
        try:
            with open(os.path.join(primary, "CLAUDE.md"), encoding="utf-8", errors="replace") as f:
                text = f.read()
        except OSError:
            text = ""
    m = PIN_RX.search(text)
    if m:
        return m.group(1).lower(), "CLAUDE.md"
    why = "pins.py found none" if os.path.isfile(pins) else f"no {pins}"
    return "UNRESOLVED", f"{why}, and CLAUDE.md has no atelier@<sha>"


def base_values(cfg, repo, facts, wt, by, extra, template_text, branch_name=None):
    """Every template value a session gets. {PIN} is resolved only when the
    template uses it and nothing supplied it; an unresolved pin is filled as
    UNRESOLVED and said, never left silently empty."""
    scratch = os.path.join(cfg["kit_dir"], "scratch", safe(repo))
    values = {**{k: str(v) for k, v in cfg["vars"].items()}, **{k: str(v) for k, v in extra.items()},
              "REPO": repo, "GH": facts["gh"], "BR": facts["branch"], "VIS": facts["visibility"],
              "WT": wt, "PRIMARY": facts["primary"], "LANDING": landing_text(facts, wt, branch_name),
              "NOTES": cfg["repos"].get(repo, {}).get("notes", "none"), "SCRATCH": scratch + "/",
              "BY": by, "DATE": f"{now_utc():%Y-%m-%d}"}
    if "PIN" not in values and "{PIN}" in template_text:
        values["PIN"], source = resolve_pin(cfg, facts)
        if values["PIN"] == "UNRESOLVED":
            print(f"PIN UNRESOLVED for {repo}: {source}; the prompt says UNRESOLVED", flush=True)
        else:
            print(f"PIN {values['PIN']} for {repo} (from {source})", flush=True)
    values.setdefault("PIN", "")
    return values


def read_template(path):
    with open(expand(path), encoding="utf-8") as f:
        return f.read()


def unlanded_work(wt, facts, branch_name=None):
    """Why removing `wt` would lose work, or "" when it holds none: uncommitted
    or untracked files, or commits on no remote branch (with no remote: on no
    branch but the worktree's own). A worktree that cannot be read holds work,
    as far as this check can tell."""
    r = subprocess.run(["git", "status", "--porcelain"], cwd=wt, capture_output=True, text=True)
    if r.returncode:
        return f"git status failed: {r.stderr.strip()[:200]}"
    if r.stdout.strip():
        n = len(r.stdout.strip().splitlines())
        return f"{n} uncommitted or untracked path(s)"
    if facts.get("remote"):
        not_on = ["--not", "--remotes"]
    else:
        not_on = ["--not", facts["branch"]]
    r = subprocess.run(["git", "rev-list", "--count", "HEAD", *not_on], cwd=wt, capture_output=True, text=True)
    if r.returncode:
        return f"git rev-list failed: {r.stderr.strip()[:200]}"
    if int(r.stdout.strip() or 0):
        where = "no remote branch" if facts.get("remote") else f"no branch but {branch_name or 'its own'}"
        return f"{r.stdout.strip()} commit(s) on {where}"
    return ""


def unlanded_verdict(wt, facts, branch_name, result, text):
    """(text, RESULT) for a session that ended with a clean RESULT: UNLANDED,
    with the reason put first in the text, when its worktree still holds work
    that is on no remote branch; else both unchanged. An UNLANDED end is not
    clean: no release, the worktree is kept, `resume` can finish it."""
    why = unlanded_work(wt, facts, branch_name)
    if not why:
        return text, result
    print(f"UNLANDED {wt}: the session said RESULT {result} but left {why}; read as not clean, so any "
          f"claim stays and the worktree is kept (land it, or resume the session)", flush=True)
    return (f"(RESULT {result} read as {UNLANDED}: the worktree {wt} holds {why}; never read as clean)\n"
            + text), UNLANDED


def remove_worktree(facts, wt, branch_name=None):
    """Remove a worktree only when it holds no unlanded work, never with
    --force; say why when it is kept. Returns True when it was removed."""
    why = unlanded_work(wt, facts, branch_name)
    if not why:
        r = subprocess.run(["git", "worktree", "remove", wt], cwd=facts["primary"], capture_output=True, text=True)
        why = "" if r.returncode == 0 else f"git worktree remove refused: {r.stderr.strip()[:200]}"
    if why:
        print(f"KEPT worktree {wt}: {why}", flush=True)
        return False
    try:
        os.rmdir(os.path.dirname(wt))
    except OSError:
        pass
    if branch_name:
        git("branch", "-d", branch_name, cwd=facts["primary"], check=False)
    return True


def results_day():
    """The UTC day whose results folder a run writes: $CCFLEET_RESULTS_DAY
    (set by `drive` for its children, so one drive keeps one folder), else today."""
    d = os.environ.get("CCFLEET_RESULTS_DAY", "")
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", d):
        return d
    return now_utc().strftime("%Y-%m-%d")


RESULT_HEAD_RX = re.compile(r"^<!-- session (\S*) rc=(\S+) result=(.*?) -->")


def pass_result_path(cfg, label, day=None):
    """The result file of the pass with this label: the newest day's that
    exists, else the one for `day` (default results_day()). A resume and a
    fold write here, so the pass has one file and its last end heads it."""
    found = sorted(glob.glob(os.path.join(glob.escape(cfg["kit_dir"]), "results", "*",
                                          glob.escape(label) + ".md")))
    return found[-1] if found else os.path.join(cfg["kit_dir"], "results", day or results_day(), label + ".md")


def write_result(path, sid, rc, result, text, keep_earlier=True):
    """Write a result file: the session id, exit code and RESULT on its first
    line, then the text. An earlier end already in the file is kept below,
    marked superseded (a resume or a fold of a pass that was cut off)."""
    earlier = ""
    if keep_earlier:
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                earlier = f.read()
        except OSError:
            pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(f"<!-- session {sid} rc={rc} result={result} -->\n{text}\n")
        if earlier:
            f.write(f"\n<!-- an earlier end of this label, superseded by the one above -->\n{earlier}")


def pass_started(cfg, label, wt):
    """Whether a pass with this label (<repo>-<item>) started in worktree
    `wt`, by what ccfleet itself wrote under kit_dir (DV1, DP13). Any of:

    - the session log the pass's launch wrote into logs/, named for the
      worktree's folder (<label>-<HHMM>-<stamp>.json; a fold's own "-in-"
      log does not count), written as its session started, so a pass run
      by hand whose launcher was then stopped (no result file, its START
      line on the terminal) counts;
    - a session record (sessions/<id>.pid) naming this worktree;
    - a START line for the label naming this worktree in a drain's
      logs/pass-*.out;
    - the pass's result file, written after this worktree was made.

    Each is tied to this worktree, so a pass on the same item in an earlier
    worktree, however long ago, does not count. A fold passes the reset only
    on this: the fold shape alone is the caller's own flags."""
    kit = cfg["kit_dir"]
    real = os.path.realpath(wt)
    folder = os.path.basename(os.path.dirname(real))
    if re.fullmatch(re.escape(label) + r"-\d{4}(?:\d{2})?", folder):
        # <folder>.json is the name an earlier ccfleet gave it.
        own = re.compile(re.escape(folder) + r"(?:-\d{8}T\d{6})?\.json")
        try:
            names = os.listdir(os.path.join(kit, "logs"))
        except OSError:
            names = []
        if any(own.fullmatch(n) for n in names):
            return True
    for path in glob.glob(os.path.join(glob.escape(kit), "sessions", "*.pid")):
        try:
            rec = read_session_record(path)
        except (OSError, ValueError, IndexError):
            continue
        if rec["wt"] and os.path.realpath(rec["wt"]) == real:
            return True
    for out in glob.glob(os.path.join(glob.escape(kit), "logs", "pass-*.out")):
        try:
            with open(out, encoding="utf-8", errors="replace") as f:
                for line in f:
                    w = re.search(r" wt=(.*?) log=", line)
                    if line.startswith("START ") and line.split()[2:3] == [label] and w \
                            and os.path.realpath(w.group(1)) == real:
                        return True
        except OSError:
            continue
    try:
        made = os.stat(os.path.dirname(real)).st_mtime
    except OSError:
        return False
    return any(os.path.getmtime(r) >= made
               for r in glob.glob(os.path.join(glob.escape(kit), "results", "*", glob.escape(label) + ".md")))


def run_one(cfg, repo, template, label=None, model=None, extra=None, by="unknown",
            dry=False, keep=False, pre=None, post=None, check_file=None, existing=None,
            remove_adopted=False, item=None):
    """Make the worktree, render, launch, harvest, clean up. Returns (exit, RESULT word).

    The worktree is removed only when the RESULT is clean (queue.release_on),
    a `post` hook did not report a refused release, and the tree holds no
    unlanded work; otherwise it is kept and said. An adopted worktree (--in)
    is the caller's and is kept, unless `remove_adopted` (run --in --item: a
    fold, whose launcher puts the worktree away). A refused release exits 2."""
    # A fold finishes a pass; one that runs the pass prompt starts a new one,
    # with a review-tier reviewer, under the fold's exemption (DV1).
    if remove_adopted and cfg.get("pass_prompt") and \
            os.path.realpath(expand(template)) == os.path.realpath(expand(cfg["pass_prompt"])):
        raise Refusal(EXIT_USAGE, "a fold (run --in WT --item ITEM) never runs pass_prompt: that is a new "
                                  "pass; give the fold its own template")
    # The reset stops NEW work only. A fold (run --in WT --item ITEM) finishes a
    # pass that started before the reset, as `resume` does, so it is not
    # refused here (RK5: the cheap fold was refused while the review-tier
    # resume ran). Only a pass ccfleet saw start counts (DV1): the fold's shape
    # is the caller's own flags. Whether to run it is the caller's alone;
    # ccfleet checks no word of the principal's.
    if reset_reached(cfg):
        fold_of = safe(f"{repo}-{item}") if (existing and remove_adopted and item) else None
        if not (fold_of and pass_started(cfg, fold_of, expand(existing))):
            why = (f": no pass on {repo}:{item} started in {expand(existing)} (kit_dir holds no session log, "
                   f"session record, START line or result file of one there), so this fold would be new "
                   f"work" if fold_of else "")
            print(f"RESET reached; not starting {label or repo}{why}")
            return EXIT_RESET, "RESET"
    check_repo_name(repo)
    extra = {k: read_at_file(v) for k, v in (extra or {}).items()}
    model = model or extra.pop("MODEL", None) or cfg["repos"].get(repo, {}).get("model") or cfg["default_model"]
    label = safe(label or repo)
    facts = repo_facts(cfg, repo, fetch=not dry)
    day = results_day()
    wt = expand(existing) if existing else os.path.join(stamp_dir(cfg["worktrees_root"], label), repo)
    if existing and (os.path.basename(wt) != repo or not os.path.isdir(wt)):
        # The basename is the billing key: a session in a differently named
        # directory would bill some other label.
        raise Refusal(EXIT_SETUP, f"--in must be an existing worktree whose basename is {repo}: {wt}")
    if existing:
        refuse_live_worktree(cfg, wt)
    keep = keep or (bool(existing) and not remove_adopted)  # an adopted worktree is the caller's
    kit = cfg["kit_dir"]
    logs, results, scratch = (os.path.join(kit, "logs"), os.path.join(kit, "results", day),
                              os.path.join(kit, "scratch", safe(repo)))
    # Date and seconds in the name: a later launch never reopens an earlier
    # log, which the cost history reads (PK12).
    log = os.path.join(logs, os.path.basename(os.path.dirname(wt))
                       + ("-in-" if existing else "-") + f"{now_utc():%Y%m%dT%H%M%S}.json")
    if facts["remote"]:
        branch_name = None
    elif existing:
        branch_name = worktree_branch(wt)  # a fold or an adopted tree: its own branch (RK17)
    else:
        branch_name = f"fleet/{label}-{now_utc().strftime('%H%M%S')}"
    sid0 = str(uuid.uuid4())
    template_text = read_template(template)
    values = base_values(cfg, repo, facts, wt, by, {**extra, "SESSION": sid0}, template_text, branch_name)
    prompt = build_prompt(cfg, template, values, template_text)
    argv = session_argv(cfg, model, prompt, session_id=sid0,
                        files=session_files(cfg, sid0, facts["visibility"], write=False))
    clean = release_on(cfg)
    if dry:
        print(f"DRY {repo} model={model} vis={facts['visibility']} wt={wt}")
        print(f"DRY worktree add from {facts['defref']}; log={log}")
        print("DRY argv: " + " ".join(argv[:-1]) + f" <prompt {len(prompt)} chars> < /dev/null")
        # The same END line a real run prints, so a dry drain reads its passes
        # as ended rather than "ended early".
        print(f"END {now_utc():%Y-%m-%dT%H:%M:%SZ} rc=0 result=DRY session=- models=- "
              f"review_model={told_review_model(values, template_text)} result_line=- out={log}", flush=True)
        return 0, "DRY"
    # Written before the worktree or the claim: a user settings file that
    # cannot be read refuses the launch with nothing to undo.
    argv = session_argv(cfg, model, prompt, session_id=sid0, files=session_files(cfg, sid0, facts["visibility"]))
    for d in (logs, results, scratch, os.path.dirname(wt)):
        os.makedirs(d, exist_ok=True)
    if existing:
        pass
    elif facts["remote"]:
        git("worktree", "add", "-q", "--detach", wt, facts["defref"], cwd=facts["primary"])
    else:
        git("worktree", "add", "-q", "-b", branch_name, wt, facts["branch"], cwd=facts["primary"])

    def cleanup():
        if not existing:
            remove_worktree(facts, wt, branch_name)

    if check_file and not os.path.isfile(os.path.join(wt, check_file)):
        print(f"not on {facts['defref']}: {check_file}")
        cleanup()
        return EXIT_SETUP, "UNKNOWN"
    if pre:
        code = pre(values, log)
        if code:
            cleanup()
            return code, "UNKNOWN"
    for line in repo_grants(wt):
        print(f"WIDENED by the repo's own {line} (it loads with the project; man ccfleet, THREATS)", flush=True)
    print(f"START {now_utc():%Y-%m-%dT%H:%M:%SZ} {label} model={model} session={sid0} wt={wt} log={log}",
          flush=True)
    since = iso_now()
    rc = launch(cfg, argv, wt, log, sid=sid0)
    text, sid, result = harvest(log, since, rc, known=clean + stop_on(cfg), stops=stop_on(cfg))
    sid = sid or sid0
    if result in clean and (remove_adopted or not existing):
        # The principal, 2026-11-23: a clean RESULT that leaves unlanded work
        # is not clean. The claim stays and the pass can be resumed; only an
        # adopted worktree with no item (the caller's own) is not judged.
        text, result = unlanded_verdict(wt, facts, branch_name, result, text)
    if existing and remove_adopted:
        # A fold writes its pass's own result file, the earlier end kept below
        # (RK6): the close counts the pass once, as the fold ended it.
        out = pass_result_path(cfg, label, day)
        write_result(out, sid, rc, result, text)
    else:
        out = os.path.join(results, f"{label}.md")
        write_result(out, sid, rc, result, text, keep_earlier=False)
    shape = result_line(text, clean + stop_on(cfg), stop_on(cfg))
    end_line(log, f"END {now_utc():%Y-%m-%dT%H:%M:%SZ} rc={rc} result={result} session={sid} "
                  f"models={models_used(log)} review_model={told_review_model(values, template_text)} "
                  f"result_line={shape} out={out}")
    released = True
    if post:
        released = post(values, result, sid, log) is not False
    settled = result in SETTLED_ON and post is None
    if keep:
        pass
    elif (result in clean or settled) and released:
        remove_worktree(facts, wt, branch_name)
    else:
        why = "the release was refused" if not released else f"RESULT {result} is not clean"
        print(f"KEPT worktree {wt}: {why}", flush=True)
    return (0 if released else EXIT_CLAIM), result


# ---------- drivers ----------

class FileLock:
    """An exclusive lock held for this process's life (flock(2)): a dead
    holder cannot leave it stale, and two processes taking it at once cannot
    both win (a check-then-write lock let them)."""

    def __init__(self, path, what, code=EXIT_SETUP):
        self.path, self.what, self.code, self.fd = path, what, code, None

    def __enter__(self):
        # A fresh kit_dir does not exist yet; the lock is the first thing a
        # driver writes, so it makes the directory (found on a first real run).
        try:
            os.makedirs(os.path.dirname(self.path), exist_ok=True)
            fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o644)
        except OSError as e:
            raise Refusal(EXIT_SETUP, f"cannot take the lock {self.path}: {e.strerror or e}")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            try:
                holder = os.read(fd, 32).decode(errors="replace").strip() or "?"
            except OSError:
                holder = "?"
            os.close(fd)
            raise Refusal(self.code, f"{self.what} (pid {holder}) is running")
        os.ftruncate(fd, 0)
        os.write(fd, str(os.getpid()).encode())
        self.fd = fd
        return self

    def __exit__(self, *exc):
        # The file stays, emptied: removing it would let a process that opened
        # it just before lock a different inode than the next taker.
        try:
            os.ftruncate(self.fd, 0)
        except OSError:
            pass
        os.close(self.fd)


def DriverLock(kit):
    """One driver per kit_dir: two drivers would each think they own the slots."""
    return FileLock(os.path.join(kit, "driver.pid"), "another driver on this kit_dir (one driver per kit_dir)")


def say(cfg, msg):
    with open(os.path.join(cfg["kit_dir"], "driver.log"), "a") as f:
        f.write(f"{now_utc():%H:%MZ} {msg}\n")


def read_jobs(path):
    """The jobs file. A repeated label is refused before anything starts: the
    label keys a job's result file, so a repeat would run one job and skip the
    rest as already done."""
    jobs, seen = [], {}
    try:
        with open(expand(path), encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError as e:
        raise Refusal(EXIT_USAGE, f"jobs file {path}: cannot read it ({e.strerror or e})")
    for n, line in enumerate(lines, 1):
        if not line.strip() or line.startswith("#"):
            continue
        f = line.split("\t")
        if len(f) < 3:
            raise Refusal(EXIT_USAGE, f"{path}:{n}: need repo, label, prompt")
        try:
            check_repo_name(f[0])
        except Refusal as e:
            raise Refusal(EXIT_USAGE, f"{path}:{n}: {e}")
        extra = dict(x.split("=", 1) for x in f[3:] if "=" in x)
        label = safe(f[1] or f[0])
        seen.setdefault(label, []).append(n)
        jobs.append({"repo": f[0], "label": label, "prompt": f[2], "vars": extra})
    repeats = {l: ns for l, ns in seen.items() if len(ns) > 1}
    if repeats:
        said = "; ".join(f"label {l!r} on lines {', '.join(map(str, ns))}" for l, ns in sorted(repeats.items()))
        raise Refusal(EXIT_USAGE, f"{path}: repeated label(s): {said}. The label keys a job's result file, so a "
                                  f"repeat would run one job and skip the rest: give every job its own label")
    return jobs


def self_argv(args_common, *rest):
    return [sys.executable, os.path.abspath(__file__), *args_common, *rest]


def spawn(cfg, argv, out_path, label, env=None):
    """A child ccfleet in its own session, so it and its `claude` survive the
    driver's terminal closing (a hangup goes to the terminal's session only).
    It is noted in <kit_dir>/children.tsv, so a later driver counts it while
    it runs even if this driver has died."""
    with open(out_path, "w") as out:
        p = subprocess.Popen(argv, stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                             start_new_session=True, env=env)
    with open(os.path.join(cfg["kit_dir"], "children.tsv"), "a") as f:
        f.write(f"{p.pid}\t{int(time.time())}\t{label}\n")
    return p


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def earlier_children(cfg):
    """{pid: (label, started)} of children an earlier driver of this kit_dir
    started that still run (a ccfleet process by that pid): they hold slots.
    The file is rewritten with only these."""
    path = os.path.join(cfg["kit_dir"], "children.tsv")
    keep = {}
    try:
        with open(path) as f:
            rows = [l.rstrip("\n").split("\t") for l in f if l.strip()]
    except OSError:
        rows = []
    for row in rows:
        try:
            pid, t0, label = int(row[0]), int(row[1]), row[2]
        except (ValueError, IndexError):
            continue
        if pid == os.getpid() or not alive(pid):
            continue
        r = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True)
        if "ccfleet" in r.stdout:
            keep[pid] = (label, t0)
    try:
        with open(path, "w") as f:
            f.writelines(f"{pid}\t{t0}\t{label}\n" for pid, (label, t0) in keep.items())
    except OSError:
        pass
    return keep


def overdue_after(cfg):
    """Seconds after which a running child counts as hung: its session's time
    limit plus a quarter hour for the pass's own steps; None with no limit."""
    limit = cfg.get("session_timeout_minutes") or 0
    return (limit + 15) * 60 if limit else None


class Pacing:
    """What a driver re-reads every loop: the stop file and the live ceiling.

    The stop file counts only when written after this driver started: one left
    by an earlier run is ignored, and the log says so once. The ceiling is the
    file <kit_dir>/max, written with the starting value when the driver starts
    and removed when it ends; edit the number mid-run to lower or raise it
    (0 holds every new start). Running sessions are never stopped by it."""

    def __init__(self, cfg, max_n):
        self.cfg, self.n = cfg, max_n
        self.started = int(time.time())  # whole seconds: a coarse mtime still compares right
        self.stop_path = os.path.join(cfg["kit_dir"], "stop")
        self.max_path = os.path.join(cfg["kit_dir"], "max")
        self.said_stale = self.said_bad = False
        with open(self.max_path, "w") as f:
            f.write(f"{max_n}\n")

    def stop(self):
        try:
            m = os.path.getmtime(self.stop_path)
        except OSError:
            return False
        if m < self.started:
            if not self.said_stale:
                when = dt.datetime.fromtimestamp(m, dt.timezone.utc)
                say(self.cfg, f"stop file ignored: written {when:%Y-%m-%dT%H:%MZ}, before this driver "
                              f"started; touch it again to stop this run, or delete it")
                self.said_stale = True
            return False
        return True

    def max(self):
        try:
            with open(self.max_path) as f:
                text = f.read().strip()
        except OSError:
            return self.n
        try:
            v = int(text)
            if v < 0:
                raise ValueError
        except ValueError:
            if not self.said_bad:
                say(self.cfg, f"max file unreadable ({text[:20]!r}); keeping {self.n}")
                self.said_bad = True
            return self.n
        self.said_bad = False
        if v != self.n:
            say(self.cfg, f"max {self.n} -> {v} (from {self.max_path})")
            self.n = v
        return self.n

    def close(self):
        try:
            os.remove(self.max_path)
        except OSError:
            pass


def result_head(path):
    """The RESULT word on a result file's first line, or "" (none, unreadable)."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            m = RESULT_HEAD_RX.match(f.readline())
    except OSError:
        return ""
    return m.group(3) if m else ""


def clean_result(cfg, path):
    """True when a result file exists and its first line records a clean
    RESULT (queue.release_on). An unclean or unreadable one is not done."""
    return result_head(path) in release_on(cfg)


def finished_result(cfg, path):
    """The RESULT word when the file records an end a drive does not run
    again (clean, or settled: SETTLED_ON), else ""."""
    word = result_head(path)
    return word if word and (word in release_on(cfg) or word in SETTLED_ON) else ""


class Watch:
    """Running children a driver waits on: their start times, the hung ones
    (past their time limit and a grace), and a periodic line while stopping."""

    def __init__(self, cfg):
        self.cfg, self.limit, self.said, self.last_wait = cfg, overdue_after(cfg), set(), 0
        self.orphans = earlier_children(cfg)
        if self.orphans:
            say(cfg, f"{len(self.orphans)} child(ren) an earlier driver started still run and hold slots: "
                     + ", ".join(f"{l} (pid {pid})" for pid, (l, _) in self.orphans.items()))

    def held(self):
        """Slots held by an earlier driver's children that still run."""
        self.orphans = {pid: v for pid, v in self.orphans.items() if alive(pid)}
        return len(self.orphans)

    def hung(self, running, stopping):
        """Report each child running past its limit once; while stopping, give
        them up rather than wait forever. Returns the labels given up."""
        now, gone = time.time(), []
        for p, info in list(running.items()):
            label, t0 = info["label"], info["t0"]
            if self.limit is None or now - t0 < self.limit:
                continue
            if p not in self.said:
                say(self.cfg, f"hung: {label} (pid {p.pid}) has run {int((now - t0) // 60)} min, past its "
                              f"limit; its claim and worktree stay for a look")
                self.said.add(p)
            if stopping:
                running.pop(p)
                gone.append(label)
        if stopping and running and self.limit is None and now - self.last_wait > 600:
            say(self.cfg, "waiting on " + ", ".join(i["label"] for i in running.values())
                          + " (no session_timeout_minutes is set)")
            self.last_wait = now
        return gone

    def close(self):
        earlier_children(self.cfg)  # leaves only what still runs in children.tsv


def drive(cfg, jobs, common, max_n, serial_per_repo, dry, day=None):
    """Start jobs in order, up to max_n at once, one per stagger, only with headroom.
    serial_per_repo: never two jobs of one repo at once (one writer per repo).
    One results day for the whole drive (default today, UTC), passed to every
    child, so a drive crossing midnight keeps one folder; a job whose result
    file there records a clean RESULT is skipped."""
    kit, day = cfg["kit_dir"], day or now_utc().strftime("%Y-%m-%d")
    os.makedirs(os.path.join(kit, "logs"), exist_ok=True)
    env = {**os.environ, "CCFLEET_RESULTS_DAY": day}
    queue, running, last_hold = list(jobs), {}, 0
    pace, watch = Pacing(cfg, max_n), Watch(cfg)
    hung = []
    say(cfg, f"drive up: {len(queue)} jobs, max {max_n}, results day {day}"
             f"{', serial per repo' if serial_per_repo else ''}")
    try:
        while queue or running:
            for p in [p for p in running if p.poll() is not None]:
                say(cfg, f"done {running.pop(p)['label']} rc={p.returncode}")
            if queue and pace.stop():
                say(cfg, f"stop file: {len(queue)} jobs not started")
                queue = []
            if queue and reset_reached(cfg):
                # As drain: the reset stops new starts; running jobs finish (RK25).
                say(cfg, f"reset reached: {len(queue)} jobs not started")
                queue = []
            hung += watch.hung(running, stopping=not queue)
            busy = {j["repo"] for j in running.values()}
            nxt = next((j for j in queue if not (serial_per_repo and j["repo"] in busy)), None)
            word = nxt and finished_result(cfg, os.path.join(kit, "results", day, nxt["label"] + ".md"))
            if word:
                queue.remove(nxt)
                if word in SETTLED_ON:
                    say(cfg, f"skip {nxt['label']} (it ended {word} on {day}: settled, its report says "
                             f"what is left; not run again)")
                else:
                    say(cfg, f"skip {nxt['label']} (a clean result exists for {day})")
                continue
            ceiling = pace.max()
            if nxt and len(running) + watch.held() < ceiling:
                reading = read_headroom(cfg)
                if gate_ok(cfg["gate"], reading) or dry:
                    queue.remove(nxt)
                    rest = ["run", nxt["repo"], "--prompt", nxt["prompt"], "--label", nxt["label"]]
                    for k, v in nxt["vars"].items():
                        rest += ["--set", f"{k}={v}"]
                    if dry:
                        rest.append("--dry-run")
                    p = spawn(cfg, self_argv(common, *rest), os.path.join(kit, "logs", f"run-{nxt['label']}.out"),
                              nxt["label"], env)
                    running[p] = {**nxt, "t0": time.time()}
                    say(cfg, f"start {nxt['label']} ({len(running)}/{ceiling}, {describe(reading)})")
                    if not dry:
                        time.sleep(cfg["stagger_seconds"])
                    continue
                if time.time() - last_hold > 600:
                    say(cfg, f"holding: {describe(reading)}")
                    last_hold = time.time()
            time.sleep(0.2 if dry else cfg["poll_seconds"])
    finally:
        pace.close()
        watch.close()
    say(cfg, "drive down" + (f"; hung, not waited for: {', '.join(hung)}" if hung else ""))


def queue_call(cfg, name, values):
    """Run one queue command. A command that cannot start or runs past
    QUEUE_TIMEOUT seconds returns a failed result, never a traceback or a hang."""
    argv = [os.path.expanduser(PLACEHOLDER.sub(lambda m: str(values.get(m.group(1), m.group(0))), a))
            for a in cfg["queue"][name]
            # an argument that is only {FETCH} is dropped when the value is empty
            if not (a == "{FETCH}" and not values.get("FETCH"))]
    try:
        return subprocess.run(argv, capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=QUEUE_TIMEOUT)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, TIMEOUT_RC, "", f"queue.{name} timed out after {QUEUE_TIMEOUT} s")
    except OSError as e:
        return subprocess.CompletedProcess(argv, 127, "", f"queue.{name} could not start: {e.strerror or e}")


def parse_pick(stdout):
    """The queue's last non-blank line as fields: tab-separated when it has a
    tab (names with spaces survive), else split on whitespace."""
    lines = [l for l in stdout.splitlines() if l.strip()]
    if not lines:
        return []
    line = lines[-1]
    if "\t" in line:
        return [f.strip() for f in line.split("\t")]
    return line.split()


def launched_path(cfg, dry=False):
    """One launched list per budget (keyed by reset_utc) when a reset is set,
    so a drain crossing UTC midnight keeps one list; else one per UTC day. A
    dry drain keeps its own, emptied at its start and removed at its end, so a
    rehearsal never makes the real drain read a full queue as empty."""
    if dry:
        return os.path.join(cfg["kit_dir"], "launched-dry.txt")
    r = cfg.get("reset_utc")
    tag = f"reset-{safe(r.replace(':', ''))}" if r else f"{now_utc():%Y-%m-%d}"
    return os.path.join(cfg["kit_dir"], f"launched-{tag}.txt")


def read_launched(path):
    try:
        with open(path, encoding="utf-8") as f:
            return {tuple(parse_pick(l)[:3]) for l in f if l.strip()}
    except OSError:
        return set()


def unlaunch(path, pick):
    """Take one pick back off the launched list: it never started a session."""
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.readlines()
    except OSError:
        return
    for i, l in enumerate(lines):
        if tuple(parse_pick(l)[:3]) == tuple(pick):
            del lines[i]
            break
    with open(path, "w", encoding="utf-8") as f:
        f.writelines(lines)


END_RESULT_RX = re.compile(r" result=(.*?) session=")


def queue_broke(r, rehearsed=0):
    """Whether a failed `next` in a dry drain is a broken queue rather than the
    refusal the seal contract requires before the seal (DP17, 210/640). The
    contract gives that refusal its own exit code, QUEUE_NOT_SEALED_RC, so
    every other nonzero exit is a queue error: a crash, a bad argument, a
    command that could not run (126, 127), one past QUEUE_TIMEOUT or killed by
    a signal. The refusal code too is a queue error once this rehearsal has
    been offered a pick, since the seal held then."""
    return r.returncode != QUEUE_NOT_SEALED_RC or rehearsed > 0


def drain(cfg, common, max_n, dry):
    """Keep up to max_n review passes running from the adopter's queue until it is
    empty, the reset arrives, the stop file appears, or the budget runs out.
    Returns the exit code: 3 when the reset had come before any pass started
    (queue.ranked is then not called); 1 when the queue is not ranked, its
    `next` failed, or every pick ended before its session started; 4 when the
    queue was empty before any pass started; else 0."""
    if not cfg.get("queue") or not all(k in cfg["queue"] for k in ("next", "ranked", "take", "release")):
        raise Refusal(EXIT_USAGE, "drain needs queue.next, queue.ranked, queue.take and "
                                  "queue.release in the config")
    kit = cfg["kit_dir"]
    os.makedirs(os.path.join(kit, "logs"), exist_ok=True)
    if reset_reached(cfg):
        say(cfg, "drain refused: the reset has been reached (queue.ranked not called)")
        print("DRAIN EXIT: reset")
        return EXIT_RESET
    launched = launched_path(cfg, dry)
    open(launched, "w" if dry else "a").close()
    clean, halt = release_on(cfg), stop_on(cfg)
    running, bad, stop, empty, last_hold, started, spawned, hung = {}, 0, None, False, 0, 0, 0, []
    drifted = 0  # passes whose verdict stood out of the shape (DP2)
    # Picks whose claim was refused: kept out of `next` for this drain by
    # handing the queue the launched list plus these, in a file of their own.
    refused, skip_path = set(), launched + ".skip"
    # Rank and route the whole queue before any pass starts, every run: a
    # drain that takes passes in whatever order the queue lists them spends
    # the budget on the wrong reviews (the principal, 2026-11-20, in the
    # review run skill). The adopter's queue judges; ccfleet only refuses.
    # A dry drain does not call it: a rehearsal must not touch the ranking.
    if dry:
        # The one reading of the queue (plan_reading, the same function `ccfleet
        # plan` runs): read-only, so a rehearsal still touches no ranking.
        for line in dry_plan_lines(cfg):
            print(line)
        say(cfg, "dry drain: queue.ranked not called")
        print("DRY queue.ranked not called")
    else:
        r = queue_call(cfg, "ranked", {"BY": common_by(common)})
        if r.returncode:
            say(cfg, f"drain refused: queue not ranked (rc={r.returncode}): "
                     f"{(r.stderr or r.stdout).strip()[:300]}")
            print((r.stderr or r.stdout).strip())
            print("DRAIN EXIT: not ranked")
            return EXIT_SETUP
    pace, watch = Pacing(cfg, max_n), Watch(cfg)
    say(cfg, f"drain up: max {max_n}, gate {cfg['gate']}, launched list {launched}")

    def on_signal(signum, _frame):
        say(cfg, f"drain stopped by signal {signum}; passes running are left to run")
        print(f"DRAIN EXIT: signal {signum}", flush=True)
        raise SystemExit(128 + signum)

    # A SIGTERM or SIGHUP ends the driver through its `finally`, so the queue
    # still hears the run end (queue.unseal) and its lists are cleared; only a
    # SIGKILL skips it (DP17). Its passes are detached and run on.
    before = {}
    for sig in (signal.SIGTERM, signal.SIGHUP):
        try:
            if signal.getsignal(sig) is not signal.SIG_IGN:  # nohup's choice stands
                before[sig] = signal.signal(sig, on_signal)
        except (ValueError, OSError):  # not the main thread
            pass
    try:
        while True:
            for p in [p for p in running if p.poll() is not None]:
                info = running.pop(p)
                pick, out = info["label"], info["out"]
                empty = False  # a slot freed: the queue may have something again
                with open(out, errors="replace") as f:
                    lines = f.readlines()
                end = [l for l in lines if l.startswith("END ")]
                began = any(l.startswith("START ") for l in lines)
                m = END_RESULT_RX.search(end[-1]) if end else None
                if p.returncode == EXIT_RESET:
                    stop = stop or "reset"
                    if not began:
                        unlaunch(launched, info["pick"])
                elif not m and not began and p.returncode == EXIT_CLAIM:
                    # Its claim was refused (another session holds the item):
                    # not a bad end, and not offered again in this drain (RK25).
                    unlaunch(launched, info["pick"])
                    refused.add(info["pick"])
                    say(cfg, f"{pick}: claim refused; taken back off the launched list and kept out of "
                             f"next for the rest of this drain (not counted as a bad end)")
                elif not m and not began:
                    # It never started a session (a failed fetch, a brief not on
                    # the branch, a guard): it is not launched.
                    unlaunch(launched, info["pick"])
                    say(cfg, f"{pick} ended before its session started rc={p.returncode}; "
                             f"taken back off the launched list")
                    bad += 1
                    stop = stop or ("failures" if bad >= 3 else None)
                elif not m:
                    started += 1
                    sm = re.search(r" session=(\S+)", next((l for l in lines if l.startswith("START ")), ""))
                    live = live_session(cfg, sm.group(1)) if sm else None
                    if live:
                        # Its launcher died but its session did not (RK4).
                        say(cfg, f"{pick} ended with no END line rc={p.returncode}: its launcher stopped but "
                                 f"its session {sm.group(1)} (pid {live}) still runs, unwatched; claim and "
                                 f"worktree kept, and a resume is refused while it runs")
                    else:
                        say(cfg, f"{pick} ended with no END line rc={p.returncode}: its session was cut off; "
                                 f"claim and worktree kept")
                    bad += 1
                    stop = stop or ("failures" if bad >= 3 else None)
                else:
                    started += 1
                    say(cfg, f"{pick} {end[-1].strip()}")
                    if m.group(1) in halt:
                        stop = stop or f"result {m.group(1)}"
                    elif m.group(1) in clean or m.group(1) == "DRY":
                        bad = 0
                    elif m.group(1) == "UNKNOWN" and " result_line=out-of-shape " in end[-1]:
                        # The session ran to its end and wrote a verdict, out
                        # of the shape: a drifted report, not a spent budget,
                        # so it is counted apart and not as a bad end (DP2).
                        # Its claim and worktree stay for a resume.
                        drifted += 1
                        say(cfg, f"{pick}: its RESULT line stood out of the final-output shape; read UNKNOWN, "
                                 f"claim and worktree kept for a resume; not counted as a bad end "
                                 f"({drifted} so far)")
                    else:
                        bad += 1
                        stop = stop or ("failures" if bad >= 3 else None)
            if pace.stop():
                stop = stop or "stopfile"
            if reset_reached(cfg):
                stop = stop or "reset"
            gone = watch.hung(running, stopping=bool(stop or empty))
            started += len(gone)
            hung += gone
            if stop or empty:
                if not running:
                    break
                time.sleep(0.2 if dry else cfg["poll_seconds"])
                continue
            ceiling = pace.max()
            if len(running) + watch.held() < ceiling:
                reading = read_headroom(cfg)
                if gate_ok(cfg["gate"], reading) or dry:
                    offer_from = launched
                    if refused:
                        with open(launched, encoding="utf-8") as f:
                            held = f.read()
                        with open(skip_path, "w", encoding="utf-8") as f:
                            f.write(held + "".join("\t".join(x) + "\n" for x in sorted(refused)))
                        offer_from = skip_path
                    r = queue_call(cfg, "next", {"LAUNCHED": offer_from, "BY": common_by(common)})
                    if r.returncode and dry and not queue_broke(r, spawned):
                        # A rehearsal reports, it does not stop: next refuses
                        # until this run's ranking is sealed (PK9).
                        stop = stop or "not sealed: no launches rehearsed"
                        print(f"DRY not sealed: no launches rehearsed (queue next refused: "
                              f"{(r.stderr or r.stdout).strip()[:300]})", flush=True)
                        say(cfg, f"dry drain: queue next refused rc={r.returncode}; no launches rehearsed")
                        continue
                    if r.returncode:
                        # A queue tool that fails is not an empty queue: reading it as
                        # one would end a drain with budget unspent and say all is well.
                        stop = stop or "queue error"
                        if dry and not spawned:
                            say(cfg, f"dry drain: a queue refusing before its seal exits "
                                     f"{QUEUE_NOT_SEALED_RC}; this one exited {r.returncode}, read as a "
                                     f"queue error (man ccfleet, THE QUEUE INTERFACE)")
                        say(cfg, f"queue next failed rc={r.returncode}: "
                                 f"{(r.stderr or r.stdout).strip()[:300]}")
                        continue
                    pick = parse_pick(r.stdout)
                    if len(pick) < 3 or not all(pick[:3]):
                        empty = True
                        say(cfg, "queue: nothing launchable now")
                        continue
                    if tuple(pick[:3]) in read_launched(launched) | refused:
                        # A queue that ignores {LAUNCHED} would start one pass over and over.
                        empty = True
                        say(cfg, f"queue offered {' '.join(pick[:2])} again, already launched; "
                                 f"treated as nothing launchable")
                        continue
                    with open(launched, "a") as f:
                        f.write("\t".join(pick[:3]) + "\n")
                    # Date and second, as the .json logs: a pass of the same
                    # item at the same time of day on another day never
                    # reopens this one (DP20). Readers glob pass-*.out, so the
                    # time-only names an earlier ccfleet wrote are still read.
                    out = os.path.join(kit, "logs", f"pass-{safe(pick[0] + '-' + pick[1])}-"
                                                    f"{now_utc():%Y%m%dT%H%M%S}.out")
                    rest = ["pass", *pick[:3]] + (["--dry-run"] if dry else [])
                    label = " ".join(pick[:2])
                    p = spawn(cfg, self_argv(common, *rest), out, label)
                    running[p] = {"label": label, "out": out, "t0": time.time(), "pick": tuple(pick[:3])}
                    spawned += 1
                    say(cfg, f"started {pick[0]} {pick[1]} ({len(running)}/{ceiling}, {describe(reading)})")
                    if dry:
                        print(f"DRY rehearsed launch: {' '.join(pick[:3])}", flush=True)
                    if not dry:
                        time.sleep(cfg["stagger_seconds"])
                    continue
                if time.time() - last_hold > 600:
                    say(cfg, f"holding starts: {describe(reading)}")
                    last_hold = time.time()
            time.sleep(0.2 if dry else cfg["poll_seconds"])
    finally:
        for sig, h in before.items():
            signal.signal(sig, signal.SIG_DFL if h is None else h)
        pace.close()
        watch.close()
        for path in ([launched] if dry else []) + [skip_path]:
            try:
                os.remove(path)
            except OSError:
                pass
        if not dry and (cfg.get("queue") or {}).get("unseal"):
            # The run's end, where the queue can see it (PK10).
            r = queue_call(cfg, "unseal", {"BY": common_by(common)})
            say(cfg, "queue.unseal called" if not r.returncode else
                f"queue.unseal failed rc={r.returncode}: {(r.stderr or r.stdout).strip()[:300]}")
    why = stop or "queue empty"
    tail = f"; hung, not waited for: {', '.join(hung)}" if hung else ""
    say(cfg, f"drain down: {why} ({started} started, {drifted} ended with a RESULT out of shape){tail}")
    print(f"DRAIN EXIT: {why}{tail}")
    if why == "queue error":
        return EXIT_SETUP
    if dry and why.startswith("not sealed"):
        return 0  # a rehearsal reports what it found; it does not fail
    if started == 0 and spawned and why == "failures":
        return EXIT_SETUP  # every pick ended before its session started: nothing ran
    if started == 0 and why == "queue empty":
        return EXIT_EMPTY
    if started == 0 and why == "reset":
        return EXIT_RESET
    return 0


# ---------- plan: the read-only reading of the queue ----------

NO_MEASUREMENT = "no measurement"
LOCAL_ROUTE = "local"
EVIDENCE_KEYS = ("repo", "item", "brief", "title")
OWED_KEYS = ("repo", "item", "title")


def queue_rows(cfg, name, keys, values=None):
    """Run a read-only queue command that prints a JSON array of objects and
    return the rows. A command that fails, prints something that is not a JSON
    array of objects, or leaves out a required key is a setup failure (exit 1),
    said plainly, never a traceback and never read as an empty queue."""
    r = queue_call(cfg, name, values or {})
    if r.returncode:
        raise Refusal(EXIT_SETUP, f"queue.{name} failed (rc={r.returncode}): {(r.stderr or r.stdout).strip()[:300]}")
    try:
        rows = json.loads(r.stdout)
    except ValueError:
        raise Refusal(EXIT_SETUP, f"queue.{name} did not print JSON: {r.stdout.strip()[:200]!r}")
    if not isinstance(rows, list) or not all(isinstance(x, dict) for x in rows):
        raise Refusal(EXIT_SETUP, f"queue.{name} must print a JSON array of objects")
    for n, row in enumerate(rows, 1):
        gone = [k for k in keys if k not in row]
        if gone:
            raise Refusal(EXIT_SETUP, f"queue.{name} row {n} has no {', '.join(gone)} "
                                      f"(each row needs {', '.join(keys)})")
    return rows


def read_log_json(path):
    """The JSON object a `claude -p --output-format json` log holds, or None
    (read as harvest reads it: from the first brace)."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            s = f.read()
        j = json.loads(s[s.index("{"):])
    except (OSError, ValueError):
        return None
    return j if isinstance(j, dict) else None


def number(v):
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) else None


def spread(values):
    """count, median and max of the numbers, or None when there are none."""
    vals = sorted(v for v in values if v is not None)
    if not vals:
        return None
    return {"n": len(vals), "median": round(statistics.median(vals), 4), "max": round(vals[-1], 4)}


COST_WHAT = ("per completed pass, the sum over every session it took (the drain's pass session, then any "
             "resume and fold) of total_cost_usd as the CLI reports it, the reviewer subagent included")
NOTIONAL = ("the CLI prices each session at its cost basis (list: the API list price); a session on a "
            "subscription plan spent no money, so its figure is notional, not what was paid")


def session_reading(path, cfg):
    """What one session's JSON log says: its RESULT word (read as harvest
    reads it), cost, duration in seconds, turns, cost per model (modelUsage's
    costUSD, which sums to total_cost_usd, subagents included), subagents
    spawned, and cost bases."""
    clean_words, stops = release_on(cfg), stop_on(cfg)
    # The session's own END line where ccfleet kept one: its verdict with its
    # real exit code and any UNLANDED. Without one (an earlier ccfleet, or a
    # launcher stopped before its END) the log is read with exit 0 assumed.
    try:
        with open(path + ".end", encoding="utf-8", errors="replace") as f:
            m = END_RESULT_RX.search(f.read())
    except OSError:
        m = None
    word = m.group(1) if m else harvest(path, None, 0, known=clean_words + stops, stops=stops)[2]
    j = read_log_json(path) or {}
    mu = j.get("modelUsage") if isinstance(j.get("modelUsage"), dict) else {}
    ss = j.get("subagent_stats") if isinstance(j.get("subagent_stats"), dict) else {}
    return {"word": word, "cost": number(j.get("total_cost_usd")),
            "dur": None if number(j.get("duration_ms")) is None else j["duration_ms"] / 1000,
            "turns": number(j.get("num_turns")),
            "models": {str(m): number(v.get("costUSD")) for m, v in mu.items() if isinstance(v, dict)},
            "subagents": number(ss.get("spawned")),
            "bases": {str(v.get("costBasis")) for v in mu.values() if isinstance(v, dict) and v.get("costBasis")}}


def total(values):
    """The sum, or None when any part is missing: a part-measured pass is
    never read as a cheap one."""
    return None if not values or any(v is None for v in values) else sum(values)


def pass_history(cfg):
    """What ccfleet's own past review passes cost, from the logs it wrote.

    A pass is found by its <kit_dir>/logs/pass-*.out (one per pass a drain
    launched): the START line names the pass's worktree and the `claude -p
    --output-format json` log of its orchestrator session, the END line its
    RESULT. A pass the drain's session did not finish is joined, as far as
    the log names allow, by the sessions that finished it: a resume's log
    (logs/resume-<repo>-<item>-<HHMM>.json, given to the newest pass of that
    repo and item that started before it ended) and a fold's
    (logs/<the pass's worktree folder>-in-<HHMMSS>.json).

    A pass is completed when it ended clean in one session (the END line's
    and the log's RESULT both in queue.release_on, so UNLANDED, ERROR and a
    cut-off pass are not), or when the last session that finished it ended
    clean by its log. Its cost, duration and turns are the sums over all its
    sessions, counted only when every session reports them. The figure is
    the orchestrator session's total_cost_usd, which holds its subagents' too
    (modelUsage breaks it down per model, so a reviewer on its own model shows
    as that model's share). Broken down per repo and per model; no size is
    measured, so nothing is per size.

    Limits: a pass run by hand (`ccfleet pass` outside a drain) leaves no .out,
    and its log is not told apart from a `run` job's, so it is not counted;
    a resume or fold run by hand is joined only by its log name; every pass
    ccfleet launches is a local session, so only the local route is ever
    measured."""
    clean_words = release_on(cfg)
    logs = os.path.join(cfg["kit_dir"], "logs")
    passes = []
    for out in sorted(glob.glob(os.path.join(glob.escape(logs), "pass-*.out"))):
        try:
            with open(out, encoding="utf-8", errors="replace") as f:
                lines = f.read().splitlines()
        except OSError:
            continue
        start = next((l for l in lines if l.startswith("START ")), "")
        end = [l for l in lines if l.startswith("END ")]
        m, lg = (END_RESULT_RX.search(end[-1]) if end else None), re.search(r" log=(.*)$", start)
        wt = re.search(r" wt=(.*?) log=", start)
        if not (m and lg):
            continue
        label = start.split()[2] if len(start.split()) > 2 else ""
        passes.append({"label": label, "end": m.group(1), "log": lg.group(1),
                       "repo": os.path.basename(wt.group(1)) if wt else "?",
                       "folder": os.path.basename(os.path.dirname(wt.group(1))) if wt else None,
                       "at": start.split()[1], "later": []})
    for path in glob.glob(os.path.join(glob.escape(logs), "*.json")):
        name = os.path.basename(path)
        # Names with date and seconds now; the minute-only names an earlier
        # ccfleet wrote are still read.
        r = re.fullmatch(r"resume-(.+)-(?:\d{4}|\d{8}T\d{6})\.json", name)
        f = re.fullmatch(r"(.+)-in-(?:\d{6}|\d{8}T\d{6})\.json", name)
        mtime = os.path.getmtime(path)
        at = dt.datetime.fromtimestamp(mtime, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        if r:
            mine = [p for p in passes if safe(p["label"]) == r.group(1) and p["at"] <= at]
        elif f:
            mine = [p for p in passes if p["folder"] == f.group(1)]
        else:
            continue
        if mine:
            max(mine, key=lambda p: p["at"])["later"].append((mtime, path))
    rows, clean_one, later_done, by_repo, by_model, subagents, bases = [], 0, 0, {}, {}, [], set()
    for p in passes:
        first = session_reading(p["log"], cfg)
        sessions = [first] + [session_reading(lp, cfg) for _, lp in sorted(p["later"])]
        if p["end"] in clean_words and first["word"] in clean_words:
            clean_one += 1
        elif len(sessions) > 1 and sessions[-1]["word"] in clean_words:
            later_done += 1
        else:
            continue
        cost = total([x["cost"] for x in sessions])
        rows.append((cost, total([x["dur"] for x in sessions]), total([x["turns"] for x in sessions])))
        by_repo.setdefault(p["repo"], []).append(cost)
        models = {}
        for x in sessions:
            for mname, c in x["models"].items():
                models[mname] = None if c is None or models.get(mname, 0) is None else models.get(mname, 0) + c
            bases |= x["bases"]
        for mname, c in models.items():
            by_model.setdefault(mname, []).append(c)
        subagents.append(total([x["subagents"] for x in sessions]))
    local = {"passes_seen": len(passes), "clean": clean_one, "finished_later": later_done,
             "completed": clean_one + later_done}
    stats = {"cost_usd": spread([r[0] for r in rows]), "duration_s": spread([r[1] for r in rows]),
             "turns": spread([r[2] for r in rows])}
    if not any(stats.values()):
        return {"measured": False, "note": NO_MEASUREMENT, **local}
    return {"measured": True, "what": COST_WHAT, **local, **{k: (v or NO_MEASUREMENT) for k, v in stats.items()},
            "by_repo": {k: spread(v) or NO_MEASUREMENT for k, v in sorted(by_repo.items())},
            "by_model": {k: spread(v) or NO_MEASUREMENT for k, v in sorted(by_model.items())},
            "subagents_spawned": spread(subagents) or NO_MEASUREMENT,
            "cost_basis": sorted(bases) or NO_MEASUREMENT}


def plan_reading(cfg, fetch=False):
    """The read-only reading of the review queue: the evidence rows, the owed
    list and the cost history. ccfleet READS and never judges: ranking and
    routing are the plan skill's work (`/atelier:review plan`), and the seal is
    the adopter's queue's. This calls none of queue.ranked, take, next, release
    or ended, and writes no launched list, claim, worktree or session. `ccfleet
    plan`, `/atelier:review plan`, `/atelier:review run` at its start and
    `drain --dry-run` all read the queue through this one function."""
    q = cfg.get("queue") or {}
    if "evidence" not in q:
        raise Refusal(EXIT_USAGE, "plan needs queue.evidence in the config (an argv list that prints a "
                                  "JSON array, one object per briefed, unrun review)")
    notes = []
    fills = {"FETCH": "--fetch" if fetch else ""}
    if fetch and "{FETCH}" not in q["evidence"]:
        notes.append("--fetch was given but queue.evidence has no {FETCH} placeholder: nothing was fetched")
    evidence = queue_rows(cfg, "evidence", EVIDENCE_KEYS, fills)
    owed = None
    if "owed" in q:
        owed = queue_rows(cfg, "owed", OWED_KEYS, fills)
    else:
        notes.append("queue.owed is not configured: the owed-but-unbriefed list is not read (owed is null)")
    if not evidence:
        notes.append("queue.evidence printed no rows: no briefed, unrun review is owed")
    history = pass_history(cfg)
    routes = {LOCAL_ROUTE: history}
    for row in evidence:
        for route in row.get("fits") or []:
            routes.setdefault(str(route), {"measured": False, "note": NO_MEASUREMENT})
    notes.append("ccfleet measures only the local route (every pass it launches is a local session); "
                 f"any other route reads {NO_MEASUREMENT!r}")
    notes.append(f"the cost history is {COST_WHAT}; it measures no review's size, so a route's figure (or "
                 "a repo's) is the estimate for every review on it, never one for a review of a given size")
    notes.append(f"{NOTIONAL}: a column that mixes a plan route with a paid one says which is which")
    notes.append("not counted: a pass run by hand (no .out; its log is not told apart from a run job's)")
    return {"evidence": evidence, "owed": owed, "history": {"source": os.path.join(cfg["kit_dir"], "logs"),
                                                              "routes": routes}, "notes": notes}


def table(headers, rows):
    """Plain aligned text columns; no cell is truncated."""
    cells = [[str(c) for c in r] for r in rows]
    width = [max(len(h), *(len(r[i]) for r in cells)) if cells else len(h) for i, h in enumerate(headers)]
    fmt = lambda r: "  ".join(c.ljust(w) for c, w in zip(r, width)).rstrip()
    return [fmt(headers), fmt(["-" * w for w in width])] + [fmt(r) for r in cells]


def fmt_stat(name, st, unit=""):
    if not isinstance(st, dict):
        return f"{name}: {NO_MEASUREMENT}"
    return f"{name}: median {st['median']}{unit}, max {st['max']}{unit} (n={st['n']})"


def plan_text(data):
    """The human reading of plan_reading()'s result, as lines."""
    ev, owed, hist = data["evidence"], data["owed"], data["history"]
    out = [f"EVIDENCE: {len(ev)} briefed, unrun review(s), in the queue's own order (not a ranking)"]
    if ev:
        out += table(["repo", "item", "title", "fits"],
                     [[r["repo"], r["item"], r["title"], ", ".join(map(str, r.get("fits") or [])) or "-"]
                      for r in ev])
    out.append("")
    if owed is None:
        out.append("OWED, NOT YET BRIEFED: not read (queue.owed is not configured)")
    else:
        out.append(f"OWED, NOT YET BRIEFED: {len(owed)}")
        if owed:
            out += table(["repo", "item", "title", "why"],
                         [[r["repo"], r["item"], r["title"], r.get("why") or "-"] for r in owed])
    out += ["", f"COST HISTORY (from {hist['source']}/pass-*.out)"]
    for route, h in sorted(hist["routes"].items()):
        if not h.get("measured"):
            seen = f" ({h['passes_seen']} pass(es) seen, none clean with a cost)" if h.get("passes_seen") else ""
            out.append(f"  {route}: {NO_MEASUREMENT}{seen}")
            continue
        out.append(f"  {route}: {h['clean']} clean pass(es) of {h['passes_seen']} seen, "
                   f"{h.get('finished_later', 0)} more finished by a resume or fold; "
                   + "; ".join([fmt_stat("cost", h["cost_usd"], " USD"), fmt_stat("duration", h["duration_s"], " s"),
                                fmt_stat("turns", h["turns"])]))
        if h.get("what"):
            out.append(f"    what: {h['what']}")
        for key, head in (("by_repo", "by repo"), ("by_model", "by model (a reviewer on its own model is its share)")):
            if h.get(key):
                out.append(f"    {head}: " + "; ".join(fmt_stat(k, v, " USD") for k, v in h[key].items()))
        if h.get("subagents_spawned"):
            out.append("    " + fmt_stat("subagents spawned per pass", h["subagents_spawned"]))
        if h.get("cost_basis"):
            basis = h["cost_basis"]
            out.append(f"    cost basis: {', '.join(basis) if isinstance(basis, list) else basis} ({NOTIONAL})")
    out += [""] + [f"NOTE: {n}" for n in data["notes"]]
    return out


def dry_plan_lines(cfg):
    """What a dry drain prints of the plan, each line prefixed `DRY plan:`. A
    queue with no evidence command, or one that fails, is said and the
    rehearsal carries on: a rehearsal reports, it does not stop."""
    try:
        lines = plan_text(plan_reading(cfg))
    except Refusal as e:
        if e.code == EXIT_USAGE:
            return ["DRY plan: queue.evidence is not configured; no plan reading (carrying on)"]
        return [f"DRY plan: FAILED, no reading ({e}); carrying on"]
    return [f"DRY plan: {l}".rstrip() for l in lines]


def common_by(common):
    return common[common.index("--by") + 1] if "--by" in common else "unknown"


def ended_hooks(cfg, values, result, sid, log, item, brief):
    """After a pass, a resume or a fold ends: release the claim when the RESULT
    is in queue.release_on, checking the exit code, then call queue.ended if
    set. Nothing is called without an item. Returns False when a release was
    refused."""
    if not item:
        return True
    hv = {**values, "ITEM": item, "BRIEF": brief or "", "SESSION": sid, "RESULT": result, "LOG": log}
    ok = True
    if result in release_on(cfg):
        r = queue_call(cfg, "release", hv)
        if r.returncode:
            ok = False
            print(f"release refused rc={r.returncode}: {r.stdout.strip()} {r.stderr.strip()}".rstrip(), flush=True)
    if (cfg.get("queue") or {}).get("ended"):
        r = queue_call(cfg, "ended", hv)
        if r.returncode:
            print(f"queue.ended failed rc={r.returncode}: {r.stderr.strip()}".rstrip(), flush=True)
    return ok


def review_log(cfg, repo, item, legacy=False):
    """The pass's private review log: one path per repo and item, outside any
    repo, the same for a pass and its resume, so a revived reviewer finds it.
    The name carries a short hash of the exact repo and item, so two pairs
    that fold to the same characters (app-web + 010, app + web/010) never
    share a log. The hash is SHA-256 (PRINCIPLES §5, SHA-2 or better;
    `115/500`). `legacy` gives the earlier names a pass cut off before a
    change may have left: a list, hashless first, then the SHA-1 name."""
    d = os.path.join(cfg["kit_dir"], "review-logs")
    key = f"{repo}\0{item}".encode()
    if legacy:
        return [os.path.join(d, safe(f"{repo}-{item}") + ".md"),
                os.path.join(d, f"{safe(repo)}-{safe(item)}-"
                                f"{hashlib.new('sha1', key, usedforsecurity=False).hexdigest()[:8]}.md")]
    h = hashlib.sha256(key).hexdigest()[:8]
    return os.path.join(d, f"{safe(repo)}-{safe(item)}-{h}.md")


def set_aside_stale_log(cfg, path):
    """A fresh pass never inherits a log: one left at its path by an earlier
    pass (failed, un-claimed or withdrawn) is moved, dated, to
    review-logs/withdrawn/ (where the review run skill keeps a withdrawn
    pass's log), so the new reviewer is not handed an earlier reviewer's account."""
    if not os.path.exists(path):
        return
    d = os.path.join(cfg["kit_dir"], "review-logs", "withdrawn")
    os.makedirs(d, exist_ok=True)
    dest = os.path.join(d, f"{now_utc():%Y%m%dT%H%M%SZ}-{os.path.basename(path)}")
    os.replace(path, dest)
    print(f"STALE review log from an earlier pass moved to {dest}; this pass starts with none", flush=True)


def one_pass(cfg, repo, item, brief, by, dry):
    """One review pass: worktree, claim, the orchestrator session, release on a clean end."""
    template = cfg.get("pass_prompt")
    if not template:
        raise Refusal(EXIT_USAGE, "pass needs pass_prompt (the orchestrator prompt template) in the config")
    check_repo_name(repo)
    if not item.strip():
        raise Refusal(EXIT_USAGE, "pass needs an item")
    missing = [k for k in ("take", "release") if k not in (cfg.get("queue") or {})]
    if missing and not dry:
        # Refused before the worktree or the session (RK16): a pass with no
        # take cannot claim, and one with no release cannot finish.
        raise Refusal(EXIT_USAGE, "pass needs " + " and ".join(f"queue.{k}" for k in missing)
                      + " in the config")
    label = safe(f"{repo}-{item}")
    log_path = review_log(cfg, repo, item)

    def pre(values, log):
        r = queue_call(cfg, "take", {**values, "ITEM": item, "BRIEF": brief, "LOG": log})
        if r.returncode:
            print(f"claim refused: {r.stdout.strip()} {r.stderr.strip()}")
            return EXIT_CLAIM
        for p in (log_path, *review_log(cfg, repo, item, legacy=True)):
            set_aside_stale_log(cfg, p)
        return 0

    def post(values, result, sid, log):
        return ended_hooks(cfg, values, result, sid, log, item, brief)

    if not dry:
        os.makedirs(os.path.dirname(log_path), exist_ok=True)
    return run_one(cfg, repo, expand(template), label=label, model=cfg.get("pass_model"),
                   extra={"ITEM": item, "BRIEF": brief, "REVIEW_LOG": log_path}, by=by, dry=dry,
                   pre=None if dry else pre, post=None if dry else post, check_file=brief)[0]


def pass_log(cfg, repo, item):
    """The review log a pass on this item had: the current name, or an earlier
    one where only that exists (a pass cut off before a change), newest
    earlier name first."""
    path = review_log(cfg, repo, item)
    if os.path.exists(path):
        return path
    for old in reversed(review_log(cfg, repo, item, legacy=True)):
        if os.path.exists(old):
            return old
    return path


def resume(cfg, repo, wt, sid, template, item, extra, by):
    """Finish one pass a usage limit cut off: resume its own session, start nothing new.

    Refused, before anything runs, when the session still runs (its launcher
    died: RK4) and, with --item, when the config has no queue.release (RK16).
    Its verdict is written to the pass's own result file, the earlier end
    kept below it, so a count from the result files reads the pass as the
    resume ended it (RK6)."""
    check_repo_name(repo)
    if os.path.basename(wt) != repo or not os.path.isdir(wt):
        # The basename is the billing key, as for run --in.
        raise Refusal(EXIT_SETUP, f"the worktree must exist and its basename must be {repo}: {wt}")
    if not re.fullmatch(r"[A-Za-z0-9_-]+", sid or ""):
        raise Refusal(EXIT_USAGE, f"not a session id: {sid!r}")
    if item and "release" not in (cfg.get("queue") or {}):
        raise Refusal(EXIT_USAGE, "resume --item needs queue.release in the config")
    live = live_session(cfg, sid)
    if live:
        raise Refusal(EXIT_CLAIM, f"session {sid} still runs (pid {live}): its launcher died or still "
                                  f"watches it, and a resume beside it would take its worktree from under it. "
                                  f"Wait for it to end, or end it (kill -TERM -{live}; what it has not saved "
                                  f"is lost), then resume")
    refuse_live_worktree(cfg, wt)
    model = cfg.get("pass_model") or cfg["repos"].get(repo, {}).get("model") or cfg["default_model"]
    # Its visibility is looked up as the pass's was, so the resumed session is
    # handed the instructions (and their imports) the pass was (210/610).
    facts = repo_facts(cfg, repo, fetch=False, lookup=True)
    # With no remote the pass's worktree is on its own branch: the landing line
    # names it, and it is deleted with the worktree (RK17).
    branch_name = None if facts["remote"] else worktree_branch(wt)
    extra = {k: read_at_file(v) for k, v in extra.items()}
    if item:
        extra.setdefault("REVIEW_LOG", pass_log(cfg, repo, item))
        os.makedirs(os.path.dirname(extra["REVIEW_LOG"]), exist_ok=True)
    template_text = read_template(template)
    values = base_values(cfg, repo, facts, wt, by, {**extra, "SESSION": sid, "ITEM": item or ""},
                         template_text, branch_name)
    prompt = build_prompt(cfg, template, values, template_text)
    files = session_files(cfg, f"resume-{sid}-{now_utc():%H%M%S}", facts["visibility"])
    for d in ("logs", os.path.join("scratch", safe(repo))):
        os.makedirs(os.path.join(cfg["kit_dir"], d), exist_ok=True)
    # Two resumes of one session at once would write one conversation twice.
    with FileLock(os.path.join(cfg["kit_dir"], "locks", f"resume-{sid}.lock"),
                  f"another resume of session {sid}", EXIT_CLAIM):
        log = os.path.join(cfg["kit_dir"], "logs",
                           f"resume-{safe(repo + '-' + (item or sid))}-{now_utc():%Y%m%dT%H%M%S}.json")
        for line in repo_grants(wt):
            print(f"WIDENED by the repo's own {line} (it loads with the project; man ccfleet, THREATS)",
                  flush=True)
        print(f"START {now_utc():%Y-%m-%dT%H:%M:%SZ} resume {repo} {item or ''} of {sid} log={log}", flush=True)
        since = iso_now()
        rc = launch(cfg, session_argv(cfg, model, prompt, resume=sid, files=files), wt, log, sid=sid)
    known = release_on(cfg) + stop_on(cfg)
    text, new_sid, result = harvest(log, since, rc, known=known, stops=stop_on(cfg))
    if result in release_on(cfg):
        text, result = unlanded_verdict(wt, facts, branch_name, result, text)
    out = pass_result_path(cfg, safe(f"{repo}-{item}") if item else safe(f"resume-{repo}-{sid}"))
    write_result(out, new_sid or sid, rc, result, f"(resumed session {sid})\n{text}")
    shape = result_line(text, known, stop_on(cfg))
    end_line(log, f"END {now_utc():%Y-%m-%dT%H:%M:%SZ} rc={rc} result={result} session={new_sid or sid} "
                  f"models={models_used(log)} review_model={told_review_model(values, template_text)} "
                  f"result_line={shape} out={out}")
    if not item:
        print(f"no --item: no queue command called; worktree kept: {wt}", flush=True)
        return 0
    released = ended_hooks(cfg, values, result, new_sid or sid, log, item, "")
    if not released:
        print(f"the claim on {repo}:{item} is still held; worktree kept: {wt}", flush=True)
        return EXIT_CLAIM
    if result in release_on(cfg):
        remove_worktree(facts, wt, branch_name)
    return 0


