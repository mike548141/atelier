class ProtoError(Exception):
    """The bytes are not a well-formed protobuf message (truncated, bad tag)."""


def _varint(buf: bytes, i: int):
    result = shift = 0
    while True:
        if i >= len(buf) or shift > 63:
            raise ProtoError("bad varint")
        b = buf[i]
        i += 1
        result |= (b & 0x7F) << shift
        if not b & 0x80:
            return result, i
        shift += 7


def _proto_fields(buf: bytes):
    """Yield (field_number, wire_type, value) for each top-level field of a
    protobuf message. value is an int for varints, else raw bytes. Groups
    (wire types 3/4) are not used by Notes and raise ProtoError."""
    i = 0
    while i < len(buf):
        key, i = _varint(buf, i)
        field, wire = key >> 3, key & 7
        if field == 0:
            raise ProtoError("field number 0")
        if wire == 0:
            value, i = _varint(buf, i)
        elif wire == 2:
            n, i = _varint(buf, i)
            if i + n > len(buf):
                raise ProtoError("truncated field")
            value, i = buf[i:i + n], i + n
        elif wire in (1, 5):
            n = 8 if wire == 1 else 4
            if i + n > len(buf):
                raise ProtoError("truncated field")
            value, i = buf[i:i + n], i + n
        else:
            raise ProtoError("unsupported wire type %d" % wire)
        yield field, wire, value


def _first_bytes(buf: bytes, field: int) -> Optional[bytes]:
    for f, w, v in _proto_fields(buf):
        if f == field and w == 2:
            return v
    return None


def decode_note_body(zdata: Optional[bytes]) -> Optional[str]:
    """Plain text of one note from ZICNOTEDATA.ZDATA, or None if it cannot be
    decoded (empty, not gzip, not protobuf, path absent). Path: gunzip, then
    root.2.3.2 (see the module docstring). Never called on a locked note."""
    if not zdata:
        return None
    try:
        gz = zlib.decompressobj(wbits=31)  # 16+15: a gzip wrapper, nothing else
        raw = gz.decompress(bytes(zdata), MAX_NOTE_BYTES)
        if gz.unconsumed_tail:
            return None  # over the cap: refuse rather than hold it all
        doc = _first_bytes(raw, 2)
        note = _first_bytes(doc, 3) if doc is not None else None
        text = _first_bytes(note, 2) if note is not None else None
    except (zlib.error, ProtoError):
        return None
    if text is None:
        return None
    return text.decode("utf-8", errors="replace").replace("￼", "[attachment]")


def _find_folded(text: str, needle: str):
    """(start, end) of the first case- and accent-insensitive match of `needle`
    in `text`, as indexes into the ORIGINAL text; None if absent. Folding is done
    per character so positions survive 'ā' -> 'a' and similar."""
    folded: List[str] = []
    owner: List[int] = []
    for idx, ch in enumerate(text):
        f = fold(ch)
        folded.append(f)
        owner.extend([idx] * len(f))
    flat = "".join(folded)
    pos = flat.find(needle)
    if pos < 0 or not needle:
        return None
    return owner[pos], owner[pos + len(needle) - 1] + 1


def _snippet(body: Optional[str], title: Optional[str], needle: Optional[str]) -> Optional[str]:
    """A short extract: context around the first text match, else the opening
    of the body (minus a first line that just repeats the title)."""
    if not body:
        return None
    hit = _find_folded(body, needle) if needle else None
    if hit:
        lo, hi = max(0, hit[0] - SNIPPET_CONTEXT), min(len(body), hit[1] + SNIPPET_CONTEXT)
        return ("…" if lo else "") + " ".join(body[lo:hi].split()) + ("…" if hi < len(body) else "")
    first, _, rest = body.partition("\n")
    if title and first.strip() == title.strip() and rest.strip():
        body = rest
    return clip(body, 2 * SNIPPET_CONTEXT)


def _note_tables(con: sqlite3.Connection) -> dict:
    """Z_ENT numbers for notes and folders, by name (they differ by macOS version)."""
    ents = {r[0]: r[1] for r in con.execute("SELECT Z_NAME, Z_ENT FROM Z_PRIMARYKEY WHERE Z_NAME IN ('ICNote','ICFolder')")}
    if "ICNote" not in ents or "ICFolder" not in ents:
        raise sqlite3.DatabaseError("not a Notes store (no ICNote/ICFolder entity)")
    return ents


def _folder_paths(con, folder_ent: int) -> Dict[int, dict]:
    """folder pk -> {'path': 'Parent/Child', 'trash': bool}."""
    raw = {r["Z_PK"]: r for r in con.execute(
        "SELECT Z_PK, ZTITLE2, ZPARENT, ZFOLDERTYPE FROM ZICCLOUDSYNCINGOBJECT WHERE Z_ENT=?", (folder_ent,))}
    out: Dict[int, dict] = {}
    for pk, r in raw.items():
        parts, seen, cur = [], set(), r
        while cur is not None and cur["Z_PK"] not in seen:
            seen.add(cur["Z_PK"])
            parts.append(cur["ZTITLE2"] or "?")
            cur = raw.get(cur["ZPARENT"])
        out[pk] = {"path": "/".join(reversed(parts)), "trash": r["ZFOLDERTYPE"] == 1}
    return out


def locked_count(path) -> int:
    """How many locked notes exist: a count, no content."""
    con = open_ro(path)
    try:
        return con.execute("SELECT COUNT(*) FROM ZICCLOUDSYNCINGOBJECT WHERE Z_ENT=? AND ZISPASSWORDPROTECTED=1",
                           (_note_tables(con)["ICNote"],)).fetchone()[0]
    finally:
        con.close()


def search_notes(path, title=None, text=None, folder=None, since=None, until=None, note_id=None,
                 include_deleted=False, full=False, limit=DEFAULT_LIMIT) -> List[dict]:
    """Notes matching ALL the filters given, newest first.

    Locked notes are never opened: they come back flagged `locked` with no text
    when their title/folder/date match, but a --text search leaves them out
    (they cannot be searched; `locked_count` lets the caller say so).
    --full needs exactly one match; it fills `text` with the whole note."""
    if not any((title, text, folder, since, until, note_id)):
        raise UsageError("notes needs at least one of --title, --text, --folder, --since, --until, --id")
    lo = datetime_to_apple(parse_day(since)) if since else None
    hi = datetime_to_apple(parse_day(until, end_of_day=True)) if until else None
    n_title, n_text, n_folder = (fold(x) if x else None for x in (title, text, folder))
    con = open_ro(path)
    try:
        ents = _note_tables(con)
        folders = _folder_paths(con, ents["ICFolder"])
        sql = ("SELECT n.Z_PK AS id, n.ZTITLE1 AS title, n.ZMODIFICATIONDATE1 AS modified, n.ZFOLDER AS folder, "
               "n.ZISPASSWORDPROTECTED AS locked, n.ZMARKEDFORDELETION AS marked, d.ZDATA AS data "
               "FROM ZICCLOUDSYNCINGOBJECT n LEFT JOIN ZICNOTEDATA d ON d.Z_PK=n.ZNOTEDATA WHERE n.Z_ENT=?")
        args: list = [ents["ICNote"]]
        if note_id is not None:
            sql += " AND n.Z_PK=?"
            args.append(note_id)
        if lo is not None:
            sql += " AND n.ZMODIFICATIONDATE1 >= ?"
            args.append(lo)
        if hi is not None:
            sql += " AND n.ZMODIFICATIONDATE1 < ?"
            args.append(hi)
        sql += " ORDER BY n.ZMODIFICATIONDATE1 DESC"
        rows: List[dict] = []
        for r in con.execute(sql, args):
            f = folders.get(r["folder"])
            trashed = bool(r["marked"]) or bool(f and f["trash"])
            if trashed and not include_deleted:
                continue
            if n_folder and n_folder not in fold(f["path"] if f else ""):
                continue
            if n_title and n_title not in fold(r["title"]):
                continue
            locked = bool(r["locked"])
            if locked and n_text:
                continue  # cannot be searched, so it cannot be a hit; main() says how many were skipped
            body = None if locked else decode_note_body(r["data"])  # a locked ZDATA is never touched
            if n_text and (body is None or _find_folded(body, n_text) is None):
                continue
            row = {
                "id": r["id"],
                "title": r["title"],
                "folder": f["path"] if f else None,
                "modified": fmt_when(r["modified"]),
                "locked": locked,
                "deleted": trashed,
                "decoded": locked or body is not None,
            }
            if full:
                row["text"] = body
            else:
                row["snippet"] = _snippet(body, r["title"], n_text)
            rows.append(row)
            if len(rows) >= (2 if full else limit):  # --full only needs to know "one, or more than one"
                break
        if full:
            if len(rows) != 1:
                raise UsageError("--full prints one note: this search matched %d (narrow it, or use --id)" % len(rows))
            if rows[0]["locked"]:
                raise UsageError("that note is locked; it is never decrypted here")
        return rows[:limit]
    finally:
        con.close()


