class UsageError(Exception):
    """A bad invocation (exit 2): no filter given, bad date, unknown person."""


# ---------------------------------------------------------------- opening ----

def open_ro(path: str) -> sqlite3.Connection:
    """Open a store read-only, no lock, no WAL. The single door to every store."""
    uri = "file:%s?mode=ro&immutable=1" % quote(os.path.abspath(path), safe="/")
    con = sqlite3.connect(uri, uri=True)
    con.execute("PRAGMA query_only=ON")
    con.row_factory = sqlite3.Row
    return con


def resolve_paths(app: str, override: Optional[Sequence[str]] = None) -> List[str]:
    """The store files for one app: --db if given, else the default glob."""
    if override:
        return list(override)
    found: List[str] = []
    for pattern in DEFAULT_PATTERNS[app]:
        found.extend(sorted(glob.glob(pattern)))
    return found


def _tables(con: sqlite3.Connection) -> set:
    return {r[0] for r in con.execute("SELECT name FROM sqlite_master WHERE type='table'")}


# ------------------------------------------------------------------ times ----

def ts_to_datetime(value) -> Optional[datetime]:
    """Apple-epoch value -> aware UTC datetime. Seconds, or nanoseconds if the
    magnitude says so (Messages switched to ns; 1e11 s is year 5000, so any
    larger number is not seconds)."""
    if value is None:
        return None
    v = float(value)
    if abs(v) >= 1e11:
        v /= 1e9
    try:
        return APPLE_EPOCH + timedelta(seconds=v)
    except OverflowError:
        return None


def datetime_to_apple(dt: datetime) -> float:
    return (dt - APPLE_EPOCH).total_seconds()


def parse_day(text: str, end_of_day: bool = False) -> datetime:
    """YYYY-MM-DD in LOCAL time -> aware datetime at that midnight (or the next
    one, for an inclusive --until). YYYYMMDD is accepted too: ccrepo and
    cctranscript spell their --since/--until that way, and one word should mean
    one thing across the instruments."""
    try:
        d = datetime.strptime(text, "%Y%m%d" if re.fullmatch(r"\d{8}", text) else "%Y-%m-%d")
    except ValueError:
        raise UsageError("bad date %r (want YYYY-MM-DD or YYYYMMDD)" % text) from None
    if end_of_day:
        d += timedelta(days=1)
    return d.astimezone()  # naive -> local


def fmt_when(value, all_day: bool = False) -> Optional[str]:
    dt = ts_to_datetime(value)
    if dt is None:
        return None
    if all_day:
        return dt.strftime("%Y-%m-%d")
    return dt.astimezone().strftime("%Y-%m-%d %H:%M")


# ----------------------------------------------------------------- helpers ----

def fold(text: Optional[str]) -> str:
    """Case- and accent-insensitive form, so 'maori' finds 'Māori'."""
    if not text:
        return ""
    nfd = unicodedata.normalize("NFD", text)
    return "".join(c for c in nfd if not unicodedata.combining(c)).casefold()


def digits(text: Optional[str]) -> str:
    return re.sub(r"\D", "", text or "")


def handle_key(handle: Optional[str]) -> str:
    """Normalise a phone number or email so Contacts and Messages agree.
    Phones compare on their last 9 digits (country code and trunk zero vary);
    emails on lower case."""
    if not handle:
        return ""
    if "@" in handle:
        return handle.strip().lower()
    d = digits(handle)
    return d[-9:] if len(d) >= 9 else d


def looks_like_handle(person: str) -> bool:
    if "@" in person:
        return True
    d = digits(person)
    letters = re.sub(r"[\d\s+()\-.]", "", person)
    return len(d) >= 5 and not letters


def clip(text: Optional[str], width: int = TEXT_WIDTH) -> Optional[str]:
    if text is None:
        return None
    text = " ".join(text.split())
    return text if len(text) <= width else text[: width - 1] + "…"


def decode_attributed_body(blob: Optional[bytes]) -> Optional[str]:
    """Best-effort plain text from a Messages `attributedBody` typedstream.

    Layout (observed on modern macOS): ... "NSString" 0x01 0x94/0x95 0x84 0x01
    '+' <length> <utf-8 bytes> ... where <length> is one byte (< 0x80), or
    0x81 + u16 LE, 0x82 + u32 LE, 0x83 + u64 LE. Returns None when the marker
    or a sane length is not found, rather than returning garbage."""
    if not blob:
        return None
    blob = bytes(blob)
    start = blob.find(b"NSString")
    if start < 0:
        return None
    i = start + len(b"NSString")
    plus = blob.find(b"\x2b", i, i + 12)  # the string tag follows within a few bytes
    if plus < 0:
        return None
    i = plus + 1
    if i >= len(blob):
        return None
    first = blob[i]
    if first == 0x81:
        width = 2
    elif first == 0x82:
        width = 4
    elif first == 0x83:
        width = 8
    else:
        width = 0
    if width:
        i += 1
        if i + width > len(blob):
            return None
        length = int.from_bytes(blob[i:i + width], "little")
        i += width
    else:
        length = first
        i += 1
    if length <= 0 or i + length > len(blob):
        return None
    return blob[i:i + length].decode("utf-8", errors="replace").strip("\x00") or None


# ---------------------------------------------------------------- contacts ----

def _display_name(first, middle, last, nick, org) -> str:
    name = " ".join(p for p in (first, last) if p)
    return name or nick or org or ""


def _clean_label(label: Optional[str]) -> Optional[str]:
    """Apple stores labels as '_$!<Mobile>!$_'."""
    if not label:
        return None
    m = re.match(r"_\$!<(.*)>!\$_$", label)
    return m.group(1) if m else label


def load_contacts(paths: Sequence[str]) -> List[dict]:
    """Every named record across all address-book sources, with phones/emails.
    Only used internally: the search functions filter it before anything is shown."""
    people: List[dict] = []
    for path in paths:
        con = open_ro(path)
        try:
            if "ZABCDRECORD" not in _tables(con):
                continue
            phones: Dict[int, list] = {}
            for r in con.execute("SELECT ZOWNER, ZFULLNUMBER, ZLABEL FROM ZABCDPHONENUMBER"):
                phones.setdefault(r["ZOWNER"], []).append({"label": _clean_label(r["ZLABEL"]), "number": r["ZFULLNUMBER"]})
            emails: Dict[int, list] = {}
            for r in con.execute("SELECT ZOWNER, ZADDRESS, ZLABEL FROM ZABCDEMAILADDRESS"):
                emails.setdefault(r["ZOWNER"], []).append({"label": _clean_label(r["ZLABEL"]), "address": r["ZADDRESS"]})
            for r in con.execute(
                "SELECT Z_PK, ZFIRSTNAME, ZMIDDLENAME, ZLASTNAME, ZNICKNAME, ZORGANIZATION, ZJOBTITLE "
                "FROM ZABCDRECORD WHERE ZFIRSTNAME IS NOT NULL OR ZLASTNAME IS NOT NULL "
                "OR ZORGANIZATION IS NOT NULL OR ZNICKNAME IS NOT NULL"
            ):
                people.append({
                    "name": _display_name(r["ZFIRSTNAME"], r["ZMIDDLENAME"], r["ZLASTNAME"], r["ZNICKNAME"], r["ZORGANIZATION"]),
                    "nickname": r["ZNICKNAME"],
                    "organisation": r["ZORGANIZATION"],
                    "job_title": r["ZJOBTITLE"],
                    "phones": phones.get(r["Z_PK"], []),
                    "emails": emails.get(r["Z_PK"], []),
                    "_haystack": fold(" ".join(p for p in (
                        r["ZFIRSTNAME"], r["ZMIDDLENAME"], r["ZLASTNAME"], r["ZNICKNAME"], r["ZORGANIZATION"]) if p)),
                })
        finally:
            con.close()
    return people


def _name_matches(person: dict, query: str) -> bool:
    return all(word in person["_haystack"] for word in fold(query).split())


def search_contacts(paths, name=None, phone=None, email=None, org=None, limit=DEFAULT_LIMIT) -> List[dict]:
    if not any((name, phone, email, org)):
        raise UsageError("contacts needs at least one of --name, --phone, --email, --org")
    out: List[dict] = []
    want_phone = digits(phone)
    if phone and not want_phone:
        raise UsageError("--phone needs some digits")
    for p in load_contacts(paths):
        if name and not _name_matches(p, name):
            continue
        if org and fold(org) not in fold(p["organisation"]):
            continue
        if want_phone and not any(want_phone in digits(x["number"]) or handle_key(x["number"]) == handle_key(phone)
                                  for x in p["phones"] if digits(x["number"])):
            continue
        if email and not any(email.lower() in (x["address"] or "").lower() for x in p["emails"]):
            continue
        out.append({k: v for k, v in p.items() if not k.startswith("_")})
        if len(out) >= limit:
            break
    return out


def contact_index(paths: Sequence[str]) -> Dict[str, str]:
    """handle_key -> display name, for turning Messages handles into names."""
    index: Dict[str, str] = {}
    for p in load_contacts(paths):
        for x in p["phones"]:
            k = handle_key(x["number"])
            if k:
                index.setdefault(k, p["name"])
        for x in p["emails"]:
            k = handle_key(x["address"])
            if k:
                index.setdefault(k, p["name"])
    return index


# ---------------------------------------------------------------- messages ----

def resolve_person(person: str, contact_paths: Sequence[str]) -> List[str]:
    """A name or handle -> handle keys. A name must match at least one contact
    with at least one phone/email, or it is a usage error (never a silent
    'no messages')."""
    if looks_like_handle(person):
        return [handle_key(person)]
    keys: List[str] = []
    for p in load_contacts(contact_paths):
        if _name_matches(p, person):
            keys.extend(handle_key(x["number"]) for x in p["phones"])
            keys.extend(handle_key(x["address"]) for x in p["emails"])
    keys = sorted({k for k in keys if k})
    if not keys:
        raise UsageError("no contact with a phone or email matches %r" % person)
    return keys


def search_messages(path, contact_paths=(), person=None, since=None, until=None, text=None,
                    limit=DEFAULT_LIMIT) -> List[dict]:
    if not any((person, since, until, text)):
        raise UsageError("messages needs at least one of --person, --since, --until, --text")
    lo = datetime_to_apple(parse_day(since)) if since else None
    hi = datetime_to_apple(parse_day(until, end_of_day=True)) if until else None
    keys = set(resolve_person(person, contact_paths)) if person else None
    names: Dict[str, str] = {}
    if contact_paths:
        try:
            names = contact_index(contact_paths)
        except sqlite3.Error:
            names = {}
    needle = fold(text) if text else None

    con = open_ro(path)
    try:
        handles = {r["ROWID"]: r["id"] for r in con.execute("SELECT ROWID, id FROM handle")}
        sql = ("SELECT m.ROWID, m.date, m.text, m.attributedBody, m.is_from_me, m.handle_id, m.service, "
               "m.cache_has_attachments, "
               "(SELECT c.display_name FROM chat_message_join j JOIN chat c ON c.ROWID=j.chat_id "
               " WHERE j.message_id=m.ROWID LIMIT 1) AS chat_name, "
               "(SELECT c.chat_identifier FROM chat_message_join j JOIN chat c ON c.ROWID=j.chat_id "
               " WHERE j.message_id=m.ROWID LIMIT 1) AS chat_ident "
               "FROM message m")
        where, args = [], []
        if keys is not None:
            ids = [rid for rid, h in handles.items() if handle_key(h) in keys]
            if not ids:
                return []
            marks = ",".join("?" * len(ids))
            # their own messages anywhere, plus every message in one-to-one chats with them
            where.append(
                "(m.handle_id IN (%s) OR m.ROWID IN (SELECT j.message_id FROM chat_message_join j "
                "WHERE j.chat_id IN (SELECT chj.chat_id FROM chat_handle_join chj WHERE chj.handle_id IN (%s) "
                "AND (SELECT COUNT(*) FROM chat_handle_join x WHERE x.chat_id=chj.chat_id)=1)))" % (marks, marks))
            args += ids + ids
        # dates in a message row may be seconds or nanoseconds; compare both forms
        if lo is not None:
            where.append("((m.date < 1e11 AND m.date >= ?) OR (m.date >= 1e11 AND m.date >= ?))")
            args += [lo, lo * 1e9]
        if hi is not None:
            where.append("((m.date < 1e11 AND m.date < ?) OR (m.date >= 1e11 AND m.date < ?))")
            args += [hi, hi * 1e9]
        if where:
            sql += " WHERE " + " AND ".join(where)
        sql += " ORDER BY m.date DESC"

        rows: List[dict] = []
        for r in con.execute(sql, args):
            body = r["text"] or decode_attributed_body(r["attributedBody"])
            if needle is not None and needle not in fold(body):
                continue
            h = handles.get(r["handle_id"])
            who = "me" if r["is_from_me"] else (names.get(handle_key(h)) or h or "unknown")
            rows.append({
                "id": r["ROWID"],
                "when": fmt_when(r["date"]),
                "from": who,
                "service": r["service"],
                "chat": r["chat_name"] or names.get(handle_key(r["chat_ident"])) or r["chat_ident"],
                "attachments": bool(r["cache_has_attachments"]),
                "text": body,
            })
            if len(rows) >= limit:
                break
        rows.reverse()  # newest N, shown oldest first so a thread reads in order
        return rows
    finally:
        con.close()


# ---------------------------------------------------------------- calendar ----

def search_calendar(path, since=None, until=None, calendar=None, text=None, limit=DEFAULT_LIMIT) -> List[dict]:
    if not any((since, until, calendar, text)):
        raise UsageError("calendar needs at least one of --since, --until, --calendar, --text")
    lo = datetime_to_apple(parse_day(since)) if since else None
    hi = datetime_to_apple(parse_day(until, end_of_day=True)) if until else None
    base = ("SELECT ci.ROWID AS id, ci.summary, ci.description, ci.start_date, ci.end_date, ci.all_day, "
            "ci.has_recurrences, c.title AS calendar, l.title AS location "
            "FROM CalendarItem ci LEFT JOIN Calendar c ON c.ROWID=ci.calendar_id "
            "LEFT JOIN Location l ON l.ROWID=ci.location_id WHERE ci.entity_type=2")
    plain, args = [base], []
    if calendar:
        plain.append("AND c.title LIKE ? ESCAPE '\\'")
        args.append("%" + calendar.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%")
    con = open_ro(path)
    try:
        events: List[dict] = []
        # one-off events: overlap the window directly
        q, a = list(plain), list(args)
        q.append("AND ci.has_recurrences=0")
        if hi is not None:
            q.append("AND ci.start_date < ?")
            a.append(hi)
        if lo is not None:
            q.append("AND COALESCE(ci.end_date, ci.start_date) >= ?")
            a.append(lo)
        for r in con.execute(" ".join(q), a):
            events.append(_event(r, r["start_date"], r["end_date"], repeats=False))
        # recurring series: occurrences from Calendar's own cache when a window is given,
        # else the master once
        if lo is None and hi is None:
            q, a = list(plain) + ["AND ci.has_recurrences=1"], list(args)
            for r in con.execute(" ".join(q), a):
                events.append(_event(r, r["start_date"], r["end_date"], repeats=True))
        elif "OccurrenceCache" in _tables(con):
            q = [base.replace("ci.start_date, ci.end_date", "oc.occurrence_start_date AS start_date, "
                              "oc.occurrence_end_date AS end_date")
                 .replace("FROM CalendarItem ci", "FROM OccurrenceCache oc JOIN CalendarItem ci ON ci.ROWID=oc.event_id"),
                 "AND ci.has_recurrences=1"]
            a = []
            if calendar:
                q.append("AND c.title LIKE ? ESCAPE '\\'")
                a.append(args[0])
            if hi is not None:
                q.append("AND oc.occurrence_start_date < ?")
                a.append(hi)
            if lo is not None:
                q.append("AND COALESCE(oc.occurrence_end_date, oc.occurrence_start_date) >= ?")
                a.append(lo)
            for r in con.execute(" ".join(q), a):
                events.append(_event(r, r["start_date"], r["end_date"], repeats=True))
    finally:
        con.close()
    if text:
        n = fold(text)
        events = [e for e in events if n in fold(e["title"]) or n in fold(e["notes"]) or n in fold(e["location"])]
    events.sort(key=lambda e: e["_sort"])
    if lo is None and hi is None:
        events.reverse()  # no window: show the most recent matches
    out = events[:limit]
    for e in out:
        e.pop("_sort")
    return out


def _event(r, start, end, repeats: bool) -> dict:
    all_day = bool(r["all_day"])
    return {
        "id": r["id"],
        "title": r["summary"],
        "calendar": r["calendar"],
        "start": fmt_when(start, all_day),
        "end": fmt_when(end, all_day),
        "all_day": all_day,
        "location": r["location"],
        "repeats": repeats,
        "notes": clip(r["description"]),
        "_sort": start if start is not None else 0,
    }


