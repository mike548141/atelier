def hap_service_label(blob) -> str:
    """16-byte HAP service UUID -> a name, or 0xNNN, or 'custom' for a non-HAP UUID."""
    if not blob or len(blob) != 16 or bytes(blob[4:]) != HAP_BASE_TAIL:
        return "custom"
    short = int.from_bytes(bytes(blob[:4]), "big")
    return HAP_SERVICES.get(short, "0x%X" % short)


def _entity_kind(name: Optional[str]) -> Optional[str]:
    """MKFHAPAccessory -> 'HAP', MKFAirPlayAccessory -> 'AirPlay', MKFEventTrigger -> 'Event'."""
    if not name:
        return None
    name = re.sub(r"^MKF", "", name)
    return re.sub(r"(Accessory|Trigger)$", "", name) or name


def _join_table(con, a_ent: int, a_tag: str, b_ent: int, b_tag: str):
    """Core Data names a many-to-many join table and its two columns from ENTITY
    NUMBERS (Z_<a_ent><a_tag>..., Z_<b_ent><b_tag>...), and those numbers move
    between macOS versions. Find it by looking for the table whose two columns
    carry exactly those prefixes. Returns (table, a_column, b_column) or None."""
    pa, pb = "Z_%d%s" % (a_ent, a_tag), "Z_%d%s" % (b_ent, b_tag)
    for (name,) in con.execute("SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'Z\\_%' ESCAPE '\\'"):
        cols = [r[1] for r in con.execute('PRAGMA table_info("%s")' % name.replace('"', ""))]
        a = [c for c in cols if c.startswith(pa)]
        b = [c for c in cols if c.startswith(pb)]
        if len(cols) == 2 and len(a) == 1 and len(b) == 1:
            return name, a[0], b[0]
    return None


def _ent(con, name: str) -> Optional[int]:
    row = con.execute("SELECT Z_ENT FROM Z_PRIMARYKEY WHERE Z_NAME=?", (name,)).fetchone()
    return row[0] if row else None


def _links(con, a_name, a_tag, b_name, b_tag) -> List[tuple]:
    """Pairs (a_pk, b_pk) from the join table between two entities, [] if there is none."""
    a_ent, b_ent = _ent(con, a_name), _ent(con, b_name)
    found = _join_table(con, a_ent, a_tag, b_ent, b_tag) if a_ent and b_ent else None
    if not found:
        return []
    table, ca, cb = found
    return [(r[0], r[1]) for r in con.execute('SELECT "%s", "%s" FROM "%s"' % (ca, cb, table))]


def _home_names(con) -> Dict[int, str]:
    return {r["Z_PK"]: r["ZNAME"] or "(unnamed home)" for r in con.execute("SELECT Z_PK, ZNAME FROM ZMKFHOME")}


def _room_names(con) -> Dict[int, str]:
    """Room pk -> name; a home's blank default room is called what Home calls it."""
    default = {r[0] for r in con.execute("SELECT ZDEFAULTROOM FROM ZMKFHOME WHERE ZDEFAULTROOM IS NOT NULL")}
    return {r["Z_PK"]: r["ZNAME"] or (DEFAULT_ROOM if r["Z_PK"] in default else "(unnamed room)")
            for r in con.execute("SELECT Z_PK, ZNAME FROM ZMKFROOM")}


def _hits(needle: Optional[str], *fields) -> bool:
    if not needle:
        return True
    n = fold(needle)
    return any(n in fold(f) for f in fields if f)


def search_home(path, mode, home=None, room=None, text=None, limit=DEFAULT_LIMIT) -> List[dict]:
    """One kind of thing from the Home layout: homes, rooms, zones, accessories,
    scenes or automations. The mode is the required filter (never a whole-house
    dump); --home / --room / --text narrow it. Every SELECT names its columns,
    so credential-shaped columns beside them are never read."""
    if mode not in HOME_MODES:
        raise UsageError("home mode must be one of %s" % ", ".join("--" + m for m in HOME_MODES))
    con = open_ro(path)
    try:
        homes, rooms = _home_names(con), _room_names(con)
        rows: List[dict] = []
        if mode == "homes":
            counts = {t: dict(con.execute("SELECT ZHOME, COUNT(*) FROM %s GROUP BY ZHOME" % t).fetchall())
                      for t in ("ZMKFROOM", "ZMKFZONE", "ZMKFACCESSORY", "ZMKFTRIGGER")}
            counts["ZMKFACTIONSET"] = dict(con.execute(
                "SELECT ZHOME, COUNT(*) FROM ZMKFACTIONSET WHERE COALESCE(ZTYPE,'')<>? GROUP BY ZHOME", (TRIGGER_OWNED,)).fetchall())
            for r in con.execute("SELECT Z_PK, ZNAME, ZOWNED, ZCREATIONDATE FROM ZMKFHOME ORDER BY ZNAME"):
                if not _hits(home, r["ZNAME"]):
                    continue
                n = lambda t: counts[t].get(r["Z_PK"], 0)
                rows.append({"name": homes[r["Z_PK"]], "owned": bool(r["ZOWNED"]), "created": fmt_when(r["ZCREATIONDATE"]),
                             "rooms": n("ZMKFROOM"), "zones": n("ZMKFZONE"), "accessories": n("ZMKFACCESSORY"),
                             "scenes": n("ZMKFACTIONSET"), "automations": n("ZMKFTRIGGER")})
        elif mode in ("rooms", "zones"):
            zone_names = {r["Z_PK"]: r["ZNAME"] or "(unnamed zone)" for r in con.execute("SELECT Z_PK, ZNAME FROM ZMKFZONE")}
            links = _links(con, "MKFRoom", "ROOMS", "MKFZone", "ZONES")
            acc_in_room: Dict[int, int] = dict(con.execute("SELECT ZROOM, COUNT(*) FROM ZMKFACCESSORY GROUP BY ZROOM").fetchall())
            if mode == "rooms":
                zones_of: Dict[int, List[str]] = {}
                for room_pk, zone_pk in links:
                    zones_of.setdefault(room_pk, []).append(zone_names.get(zone_pk, "?"))
                for r in con.execute("SELECT Z_PK, ZHOME FROM ZMKFROOM"):
                    if _hits(home, homes.get(r["ZHOME"])) and _hits(room, rooms[r["Z_PK"]]) and _hits(text, rooms[r["Z_PK"]]):
                        rows.append({"name": rooms[r["Z_PK"]], "home": homes.get(r["ZHOME"]),
                                     "zones": sorted(zones_of.get(r["Z_PK"], [])), "accessories": acc_in_room.get(r["Z_PK"], 0)})
            else:
                rooms_of: Dict[int, List[str]] = {}
                for room_pk, zone_pk in links:
                    rooms_of.setdefault(zone_pk, []).append(rooms.get(room_pk, "?"))
                for r in con.execute("SELECT Z_PK, ZNAME, ZHOME FROM ZMKFZONE"):
                    if _hits(home, homes.get(r["ZHOME"])) and _hits(text, r["ZNAME"]):
                        member = sorted(rooms_of.get(r["Z_PK"], []))
                        if _hits(room, *member):
                            rows.append({"name": zone_names[r["Z_PK"]], "home": homes.get(r["ZHOME"]), "rooms": member})
        elif mode == "accessories":
            kinds = {r[0]: _entity_kind(r[1]) for r in con.execute("SELECT Z_ENT, Z_NAME FROM Z_PRIMARYKEY")}
            by_acc: Dict[int, List[dict]] = {}
            for r in con.execute("SELECT ZACCESSORY, ZNAME, ZPROVIDEDNAME, ZSERVICETYPE FROM ZMKFSERVICE ORDER BY Z_PK"):
                by_acc.setdefault(r["ZACCESSORY"], []).append(
                    {"name": r["ZNAME"] or r["ZPROVIDEDNAME"], "type": hap_service_label(r["ZSERVICETYPE"])})
            names = {r[0]: r[1] or r[2] for r in con.execute("SELECT Z_PK, ZCONFIGUREDNAME, ZPROVIDEDNAME FROM ZMKFACCESSORY")}
            for r in con.execute("SELECT Z_PK, Z_ENT, ZCONFIGUREDNAME, ZPROVIDEDNAME, ZMANUFACTURER, ZMODEL, ZSERIALNUMBER, "
                                 "ZFIRMWAREVERSION, ZACCESSORYCATEGORY, ZROOM, ZHOME, ZHOSTACCESSORY FROM ZMKFACCESSORY "
                                 "ORDER BY ZHOME, ZROOM, Z_PK"):
                name = r["ZCONFIGUREDNAME"] or r["ZPROVIDEDNAME"]
                room_name = rooms.get(r["ZROOM"])
                if not (_hits(home, homes.get(r["ZHOME"])) and _hits(room, room_name)
                        and _hits(text, name, r["ZMANUFACTURER"], r["ZMODEL"], r["ZSERIALNUMBER"], room_name)):
                    continue
                cat = r["ZACCESSORYCATEGORY"]
                rows.append({"name": name or "(unnamed)", "kind": kinds.get(r["Z_ENT"]), "manufacturer": r["ZMANUFACTURER"],
                             "model": r["ZMODEL"], "serial": r["ZSERIALNUMBER"], "firmware": r["ZFIRMWAREVERSION"],
                             "category": cat, "category_name": HAP_CATEGORIES.get(cat), "room": room_name,
                             "home": homes.get(r["ZHOME"]), "bridged_by": names.get(r["ZHOSTACCESSORY"]),
                             "services": by_acc.get(r["Z_PK"], [])})
        else:  # scenes, automations
            sets = {r["Z_PK"]: r for r in con.execute("SELECT Z_PK, ZNAME, ZTYPE, ZHOME, ZLASTEXECUTIONDATE FROM ZMKFACTIONSET")}
            links = _links(con, "MKFActionSet", "ACTIONSETS", "MKFTrigger", "TRIGGERS")
            if mode == "scenes":
                autos_of: Dict[int, List[str]] = {}
                trig_names = {r[0]: r[1] for r in con.execute("SELECT Z_PK, ZNAME FROM ZMKFTRIGGER")}
                for set_pk, trig_pk in links:
                    autos_of.setdefault(set_pk, []).append(trig_names.get(trig_pk) or "?")
                for pk, r in sets.items():
                    if r["ZTYPE"] != TRIGGER_OWNED and _hits(home, homes.get(r["ZHOME"])) and _hits(text, r["ZNAME"]):
                        rows.append({"name": r["ZNAME"] or "(unnamed)", "type": re.sub(r"^HMActionSetType", "", r["ZTYPE"] or "") or None,
                                     "home": homes.get(r["ZHOME"]), "last_run": fmt_when(r["ZLASTEXECUTIONDATE"]),
                                     "automations": sorted(autos_of.get(pk, []))})
            else:
                scenes_of: Dict[int, List[str]] = {}
                for set_pk, trig_pk in links:
                    if set_pk in sets:
                        scenes_of.setdefault(trig_pk, []).append(sets[set_pk]["ZNAME"] or "?")
                kinds = {r[0]: _entity_kind(r[1]) for r in con.execute("SELECT Z_ENT, Z_NAME FROM Z_PRIMARYKEY")}
                for r in con.execute("SELECT Z_PK, Z_ENT, ZNAME, ZACTIVE, ZHOME, ZFIREDATE, ZMOSTRECENTFIREDATE FROM ZMKFTRIGGER ORDER BY ZNAME"):
                    if _hits(home, homes.get(r["ZHOME"])) and _hits(text, r["ZNAME"]):
                        rows.append({"name": r["ZNAME"] or "(unnamed)", "kind": kinds.get(r["Z_ENT"]), "active": bool(r["ZACTIVE"]),
                                     "home": homes.get(r["ZHOME"]), "next_fire": fmt_when(r["ZFIREDATE"]),
                                     "last_fired": fmt_when(r["ZMOSTRECENTFIREDATE"]), "scenes": sorted(scenes_of.get(r["Z_PK"], []))})
        return rows[:limit]
    finally:
        con.close()


def pending_wal_bytes(path: str) -> int:
    """Size of a non-empty write-ahead log beside the store, which immutable=1 does not read."""
    try:
        return os.path.getsize(path + "-wal")
    except OSError:
        return 0


