#!/bin/sh
# atelier leakscan pre-commit hook.
# Install:  cp tools/pre-commit.sample .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Blocks a commit that would introduce personal/estate data. Scans only the
# staged additions, so it is fast on the commit hot path. A hook protects only
# the machine it is installed on — pair it with the same scan in CI.

repo_root=$(git rev-parse --show-toplevel)
scanner="$repo_root/tools/leakscan.py"

if [ ! -f "$scanner" ]; then
    echo "leakscan: scanner not found at $scanner — skipping (is this an atelier-standard repo?)" >&2
    exit 0
fi

python3 "$scanner" --staged --root "$repo_root"
status=$?

if [ "$status" -ne 0 ]; then
    echo >&2
    echo "leakscan blocked this commit. Fix the finding above, or exempt a false" >&2
    echo "positive with '# leakscan:allow: <reason>' / .leakscanignore, then retry." >&2
    echo "To bypass in a genuine emergency (discouraged): git commit --no-verify" >&2
fi

exit "$status"
