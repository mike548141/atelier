def render_text(app: str, rows: List[dict]) -> str:
    if not rows:
        return "(no matches)"
    lines: List[str] = []
    for r in rows:
        if app == "contacts":
            head = r["name"] + (" (%s)" % r["organisation"] if r["organisation"] and r["organisation"] != r["name"] else "")
            lines.append(head)
            if r["job_title"]:
                lines.append("  title:  %s" % r["job_title"])
            for x in r["phones"]:
                lines.append("  phone:  %s%s" % (x["number"], " [%s]" % x["label"] if x["label"] else ""))
            for x in r["emails"]:
                lines.append("  email:  %s%s" % (x["address"], " [%s]" % x["label"] if x["label"] else ""))
        elif app == "messages":
            body = clip(r["text"]) if r["text"] else ("[attachment]" if r["attachments"] else "[no text decoded]")
            lines.append("%s  %s  (%s)  %s" % (r["when"], r["from"], r["chat"] or "?", body))
        elif app == "calendar":
            span = r["start"] if r["start"] == r["end"] or not r["end"] else "%s -> %s" % (r["start"], r["end"])
            extra = "".join((" @ %s" % r["location"] if r["location"] else "", " [repeats]" if r["repeats"] else ""))
            lines.append("%s  %s  [%s]%s" % (span, r["title"], r["calendar"], extra))
            if r["notes"]:
                lines.append("    %s" % r["notes"])
        elif app == "reminders":
            mark = "x" if r["done"] else " "
            due = "  due %s" % r["due"] if r["due"] else ""
            flag = "  !" if r["flagged"] else ""
            lines.append("[%s] %s  (%s)%s%s" % (mark, r["title"], r["list"], due, flag))
            if r["notes"]:
                lines.append("    %s" % r["notes"])
        elif app == "notes":
            flags = "".join((" [locked]" if r["locked"] else "", " [deleted]" if r["deleted"] else "",
                             "" if r["decoded"] else " [body not decoded]"))
            lines.append("#%s  %s  %s  (%s)%s" % (r["id"], r["modified"], r["title"] or "(untitled)", r["folder"] or "no folder", flags))
            if "text" in r:
                lines.append(r["text"] if r["text"] is not None else "    (no text)")
            elif r["snippet"]:
                lines.append("    %s" % r["snippet"])
        elif app == "photos":
            flags = " [deleted]" if r["deleted"] else ""
            lines.append("%s  %s  %s%s" % (r["date"], r["filename"] or "(no name)", r["uuid"], flags))
            lines.append("    original: %s" % ("on disk" if r["original_on_disk"] else "not on disk"))
            lines.append("    view:     %s" % ("%s  [%s]" % (r["viewable_path"], r["viewable_kind"]) if r["viewable_path"]
                                                else "(no file on disk)"))
            if r["gps"]:
                dist = "  (%s km)" % r["distance_km"] if "distance_km" in r else ""
                lines.append("    gps:      %s, %s%s" % (r["gps"]["lat"], r["gps"]["lon"], dist))
        elif app == "home":
            lines.extend(_render_home_row(r))
    return "\n".join(lines)


def _render_home_row(r: dict) -> List[str]:
    if "owned" in r:  # a home
        return ["%s%s  rooms=%d zones=%d accessories=%d scenes=%d automations=%d" % (
            r["name"], "" if r["owned"] else " [shared]", r["rooms"], r["zones"], r["accessories"],
            r["scenes"], r["automations"])]
    if "services" in r:  # an accessory
        make = " ".join(x for x in (r["manufacturer"], r["model"]) if x)
        head = "%s  (%s)  %s%s" % (r["name"], r["room"] or "no room", make or "unknown make",
                                   "  %s" % r["category_name"] if r["category_name"] else "")
        out = [head]
        bits = ["home: %s" % r["home"], "kind: %s" % r["kind"]]
        if r["serial"]:
            bits.append("serial: %s" % r["serial"])
        if r["firmware"]:
            bits.append("firmware: %s" % r["firmware"])
        if r["bridged_by"]:
            bits.append("via: %s" % r["bridged_by"])
        out.append("    " + "  ".join(bits))
        kinds: Dict[str, int] = {}
        for sv in r["services"]:
            kinds[sv["type"]] = kinds.get(sv["type"], 0) + 1
        if kinds:
            out.append("    services: " + ", ".join("%s x%d" % kv if kv[1] > 1 else kv[0] for kv in sorted(kinds.items())))
        return out
    if "last_run" in r:  # a scene
        return ["%s  [%s]  (%s)%s%s" % (r["name"], r["type"] or "?", r["home"],
                                         "  last run %s" % r["last_run"] if r["last_run"] else "",
                                         "  automations: %s" % ", ".join(r["automations"]) if r["automations"] else "")]
    if "active" in r:  # an automation
        return ["%s  [%s, %s]  (%s)%s%s%s" % (
            r["name"], r["kind"] or "?", "on" if r["active"] else "off", r["home"],
            "  next %s" % r["next_fire"] if r["next_fire"] else "", "  last %s" % r["last_fired"] if r["last_fired"] else "",
            "  scenes: %s" % ", ".join(r["scenes"]) if r["scenes"] else "")]
    if "rooms" in r:  # a zone
        return ["%s  (%s)  rooms: %s" % (r["name"], r["home"], ", ".join(r["rooms"]) or "none")]
    return ["%s  (%s)  accessories=%d%s" % (r["name"], r["home"], r["accessories"],
                                          "  zones: %s" % ", ".join(r["zones"]) if r["zones"] else "")]


def render_status(report: List[dict]) -> str:
    lines = []
    for e in report:
        state = "opens read-only" if e["opens_read_only"] else "CANNOT OPEN (%s)" % e.get("error", "?")
        lines.append("%-9s %s" % (e["app"], e["path"] or "-"))
        lines.append("          %s" % state)
        if e["counts"]:
            lines.append("          " + ", ".join("%s=%s" % kv for kv in e["counts"].items()))
    return "\n".join(lines)


# --------------------------------------------------------------------- CLI ----

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="ccapple",
        description="Read-only search of Apple Contacts, Messages, Calendar, Reminders, Notes, Photos and Home.",
        epilog="Every search needs at least one filter. Dates are YYYY-MM-DD (or YYYYMMDD), local time. "
               "Full manual: man ccapple")
    sub = p.add_subparsers(dest="cmd", required=True)

    def common(sp, many_db=False):
        sp.add_argument("--limit", type=int, default=DEFAULT_LIMIT, help="max results (default %d)" % DEFAULT_LIMIT)
        sp.add_argument("--json", action="store_true", help="JSON output")
        if many_db:
            sp.add_argument("--db", action="append", help="store path override (repeatable)")
        else:
            sp.add_argument("--db", help="store path override")

    sp = sub.add_parser("status", help="per store: path, opens read-only?, row counts only")
    sp.add_argument("--json", action="store_true")
    sp = sub.add_parser("contacts", help="find people by name / phone / email / organisation")
    sp.add_argument("--name"); sp.add_argument("--phone"); sp.add_argument("--email"); sp.add_argument("--org")
    common(sp, many_db=True)
    sp = sub.add_parser("messages", help="search iMessage/SMS by person, dates and text")
    sp.add_argument("--person", help="a contact name, or a phone/email handle")
    sp.add_argument("--since", help="YYYY-MM-DD"); sp.add_argument("--until", help="YYYY-MM-DD (inclusive)")
    sp.add_argument("--text", help="words to find in the message body")
    sp.add_argument("--contacts-db", action="append", help="Contacts store override (repeatable)")
    common(sp)
    sp = sub.add_parser("calendar", help="search events by dates, calendar and text")
    sp.add_argument("--since", help="YYYY-MM-DD"); sp.add_argument("--until", help="YYYY-MM-DD (inclusive)")
    sp.add_argument("--calendar", help="calendar name contains"); sp.add_argument("--text")
    common(sp)
    sp = sub.add_parser("reminders", help="search reminders by list, text, open state")
    sp.add_argument("--list", dest="list_name"); sp.add_argument("--text")
    sp.add_argument("--open-only", action="store_true")
    common(sp, many_db=True)
    sp = sub.add_parser("notes", help="search Apple Notes by title, text, folder, dates")
    sp.add_argument("--title", help="title contains"); sp.add_argument("--text", help="words to find in the note body")
    sp.add_argument("--folder", help="folder name contains")
    sp.add_argument("--since", help="modified on/after YYYY-MM-DD"); sp.add_argument("--until", help="modified up to YYYY-MM-DD (inclusive)")
    sp.add_argument("--id", type=int, dest="note_id", help="a note id from an earlier search")
    sp.add_argument("--include-deleted", action="store_true", help="also search Recently Deleted")
    sp.add_argument("--full", action="store_true", help="print one note's whole text (the search must match exactly one)")
    common(sp)
    sp = sub.add_parser("photos", help="search Photos by recognised text/caption, dates, place, album (paths, not images)")
    sp.add_argument("--text", help="words in the recognised text or caption (all required)")
    sp.add_argument("--since", help="taken on/after YYYY-MM-DD"); sp.add_argument("--until", help="taken up to YYYY-MM-DD (inclusive)")
    sp.add_argument("--near", help="LAT,LON[,KM] (KM defaults to %g)" % NEAR_DEFAULT_KM)
    sp.add_argument("--album", help="album name contains")
    sp.add_argument("--uuid", help="an asset UUID from an earlier search")
    sp.add_argument("--include-deleted", action="store_true", help="also match Recently Deleted")
    common(sp)
    sp = sub.add_parser("home", help="read the Apple Home layout: homes, rooms, zones, accessories, scenes, automations (no control)")
    for m in HOME_MODES:
        sp.add_argument("--" + m, dest="home_mode", action="append_const", const=m, help="list the %s" % m)
    sp.add_argument("--home", help="home name contains"); sp.add_argument("--room", help="room name contains")
    sp.add_argument("--text", help="name, make, model, serial or room contains")
    common(sp)
    return p


def _one(app, override):
    paths = resolve_paths(app, [override] if override else None)
    if not paths:
        raise sqlite3.OperationalError("%s store not found" % app)
    return paths[0]


def _glue_negative_near(argv: Sequence[str]) -> List[str]:
    """argparse reads `--near -41.2,174.7` as a flag; southern latitudes are
    negative, so glue the value on as `--near=-41.2,174.7`."""
    argv = list(argv)
    for i in range(len(argv) - 1):
        if argv[i] == "--near" and argv[i + 1].startswith("-"):
            argv[i:i + 2] = ["--near=" + argv[i + 1]]
            break
    return argv


def main(argv: Optional[Sequence[str]] = None, out=None) -> int:
    out = out or sys.stdout
    args = build_parser().parse_args(_glue_negative_near(sys.argv[1:] if argv is None else argv))
    try:
        if args.cmd == "status":
            report = status()
            print(json.dumps(report, indent=2) if args.json else render_status(report), file=out)
            return 0 if all(e["opens_read_only"] for e in report) else 1
        if args.limit < 1:
            raise UsageError("--limit must be at least 1")
        if args.cmd == "contacts":
            rows = search_contacts(resolve_paths("contacts", args.db), args.name, args.phone, args.email, args.org, args.limit)
        elif args.cmd == "messages":
            rows = search_messages(_one("messages", args.db), resolve_paths("contacts", args.contacts_db),
                                   args.person, args.since, args.until, args.text, args.limit)
        elif args.cmd == "calendar":
            rows = search_calendar(_one("calendar", args.db), args.since, args.until, args.calendar, args.text, args.limit)
        elif args.cmd == "notes":
            store = _one("notes", args.db)
            rows = search_notes(store, args.title, args.text, args.folder, args.since, args.until,
                                args.note_id, args.include_deleted, args.full, args.limit)
            if args.text and (n := locked_count(store)):
                print("ccapple: %d locked note(s) cannot be searched and were skipped" % n, file=sys.stderr)
        elif args.cmd == "home":
            modes = args.home_mode or []
            if len(modes) != 1:
                raise UsageError("home needs exactly one of %s (at least one is required)" % ", ".join("--" + m for m in HOME_MODES))
            store = _one("home", args.db)
            rows = search_home(store, modes[0], args.home, args.room, args.text, args.limit)
            if wal := pending_wal_bytes(store):
                print("ccapple: %s has %d KB of uncommitted changes in its write-ahead log that this read-only open "
                      "cannot see; a device or room changed in the last few days may be missing"
                      % (os.path.basename(store), wal // 1024), file=sys.stderr)
        elif args.cmd == "photos":
            rows = search_photos(_one("photos", args.db), args.text, args.since, args.until, args.near,
                                 args.album, args.uuid, args.include_deleted, args.limit)
        else:
            rows = search_reminders(resolve_paths("reminders", args.db), args.list_name, args.text, args.open_only, args.limit)
    except UsageError as exc:
        print("ccapple: %s" % exc, file=sys.stderr)
        return 2
    except sqlite3.Error as exc:
        print("ccapple: cannot read store: %s" % exc, file=sys.stderr)
        return 1
    print(json.dumps(rows, indent=2, ensure_ascii=False) if args.json else render_text(args.cmd, rows), file=out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
