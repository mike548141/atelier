#!/usr/bin/env node
/*
 * ccrepo — Claude Code usage totals, grouped and filtered any way you like.
 *
 * v2 reads the raw session logs under ~/.claude/projects/ directly and computes
 * cost itself, per message, from a local price table (five token classes incl.
 * the 5m/1h cache-write split). That message grain is what lets it group by
 * dimensions that vary *within* a session — branch, main-vs-subagent, entrypoint,
 * CC version, hour — not just repo/model/day.
 *
 * ccusage is no longer the cost source; it's the *oracle*. Every run reconciles
 * ccrepo's own total against `ccusage session` and reports the drift ($ and %),
 * so a stale price table announces itself instead of lying quietly.
 *
 * Grouping is an ordered list: -g repo,model or -g model,repo or -g month, any
 * subset of {repo, model, branch, kind, entrypoint, cc-version, agent, year,
 * month, week, day, hour}, nested left-to-right. Filters mirror that exact
 * vocabulary. Default is -g repo, cost-descending.
 *
 * Cost is an API-equivalent *estimate* (list prices, not your subscription bill).
 * A ~/.claude/ccrepo-billing.json plan config adds an Actual column, and a `spend`
 * block reconciles what you *genuinely pay* (plan tier × months, or invoiced/metered
 * figures) against that estimate — a footnote with the delta, the money-side analog
 * of the ccusage cross-check (see the billing model in instruments/README.md).
 * Absent ⇒ estimate-only. See --help for the full surface.
 *
 * By default it reads the live logs. --from-archive (or naming a --dest) reads
 * the compressed mirror ccarchive(1) maintains instead — same walk, transparent
 * gunzip — so totals reach back past Claude Code's prune horizon. Because ccrepo
 * reads *every* file, an iCloud-evicted mirror is skipped by default (reading it
 * would fault the bytes back down) and counted as a stated gap; --materialise
 * opts into reading them. The ccusage cross-check is off in archive mode: ccusage
 * reads the live store, which no longer holds the pruned sessions.
 */
const { execFileSync } = require('node:child_process');
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const zlib = require('node:zlib');

// Source selection (archive vs live), read straight off argv so the log-reading
// functions below can consult it. Module-load-inert — no output, no exit. --dest
// names the archive, so it implies --from-archive; resolution matches ccarchive
// (--dest, then $CCARCHIVE_DEST, then the iCloud Drive default) so one vocabulary
// points both tools at the same mirror. --materialise opts into reading evicted
// (dataless) mirrors, which ccrepo otherwise skips to avoid bulk-downloading.
const _srcArgv = process.argv.slice(2);
const destArg = _srcArgv.includes('--dest') ? _srcArgv[_srcArgv.indexOf('--dest') + 1] : null;
const fromArchive = _srcArgv.includes('--from-archive') || destArg != null;
const materialise = _srcArgv.includes('--materialise');

// Bare money marker per currency — the currency is named in the header + a
// footnote, not stamped on every figure. Dollar family → plain "$".
const SYMBOLS = { USD: '$', NZD: '$', AUD: '$', CAD: '$', GBP: '£', EUR: '€', JPY: '¥' };
const symbolFor = (code) => SYMBOLS[code] || '';

// --- pricing -------------------------------------------------------------
//
// USD list price per *million* input tokens, standard tier, keyed by short model
// name (claude- stripped) via longest-prefix match. The other four token classes
// derive from the input base by Anthropic's standard multipliers (output 5×,
// cache read 0.1×, cache write-5m 1.25×, cache write-1h 2×). Snapshot 2026-07-17;
// each base was cross-checked against ccusage's own per-model cost on real logs
// and came out to a clean round number, so the multiplier model is exact. Update
// here (or drop ~/.claude/ccrepo-pricing.json to override) when list prices move;
// the reconciliation footnote tells you when they have.
//
// A price is effective from a date to a date. An entry is EITHER a bare number,
// meaning "this price, always" — the original form, still legal, still what most
// entries are — OR a list of { from, to, base } intervals: ISO calendar dates,
// UTC, both ends INCLUSIVE, either end omitted for open-ended. The interval is an
// object rather than a tuple so a per-period multiplier can join it later without
// moving the schema again.
//
// Why it matters: without this, a message sent in 2026-06 is priced at *today's*
// rate and nothing in the tool can say otherwise. A rate change silently rewrites
// history.
//
// A timestamp that falls inside no interval is UNPRICED — it takes the same
// path as an unknown model (cost 0 + the ⚠ footnote), never a snap to the nearest
// interval. A price we don't have is not a price we can infer; the footnote
// distinguishes the two gaps so the fix it names is the right one.
//
// One entry is dated, and it is the reason this shape exists:
//   opus-5   — added 2026-07-26 from Anthropic's published list ($5/$25 per MTok,
//              same as opus-4-8). Before this, opus-5 fell through unpriced and
//              1,314 messages in one live drive counted at $0 — the ⚠ footnote
//              was firing, which is how it surfaced.
//   sonnet-5 — $2 is the INTRODUCTORY rate, published as running through
//              2026-08-31; the standard rate is $3 from 2026-09-01. Both are
//              entered, each correct on its own side of the date, so the revert
//              needs nobody to remember it. Published numbers, not fitted ones.
const PRICING = {
  'opus-5': 5,
  'opus-4-8': 5,
  'fable-5': 10,
  'sonnet-5': [
    { to: '2026-08-31', base: 2 },      // introductory rate
    { from: '2026-09-01', base: 3 },    // standard rate
  ],
  'sonnet-4': 3,
  'haiku-4-5': 1,
};
const MULT = { output: 5, cacheRead: 0.1, write5m: 1.25, write1h: 2 };

// Load a machine-local price override, merged over the built-in table. Never in
// a repo (list prices aren't secret, but the override path keeps corrections out
// of the tool). Malformed ⇒ ignored with a warning, never fatal.
const ISO_DAY = /^\d{4}-\d{2}-\d{2}$/;
// One interval of a time-bounded price. `base` is required and positive; the two
// bounds are optional but, when present, must be ISO calendar dates — a bound the
// tool can't compare is worse than no bound, so it's rejected rather than skipped.
function validInterval(iv) {
  if (!iv || typeof iv !== 'object' || Array.isArray(iv)) return false;
  if (typeof iv.base !== 'number' || !(iv.base > 0)) return false;
  for (const b of ['from', 'to']) if (iv[b] !== undefined && !ISO_DAY.test(String(iv[b]))) return false;
  return true;
}

// Load a machine-local price override, merged over the built-in table. Never in
// a repo (list prices aren't secret, but the override path keeps corrections out
// of the tool). Malformed ⇒ ignored with a warning, never fatal.
//
// An override entry takes either form the built-in table does. A bad entry is
// dropped *by name* rather than sinking the file: one mistyped model shouldn't
// cost you the other five corrections in the same file.
function loadPricing(file) {
  const p = file || path.join(os.homedir(), '.claude', 'ccrepo-pricing.json');
  let raw;
  try { raw = fs.readFileSync(p, 'utf8'); } catch { return { ...PRICING }; }
  try {
    const over = JSON.parse(raw);
    const merged = { ...PRICING };
    for (const [k, v] of Object.entries(over)) {
      const key = k.toLowerCase().replace(/^claude-/, '');
      if (typeof v === 'number') { if (v > 0) merged[key] = v; continue; }
      if (Array.isArray(v) && v.length && v.every(validInterval)) { merged[key] = v; continue; }
      console.error(`Ignoring price for '${k}' in ${p}: want a positive number, or a non-empty list of {from,to,base} intervals with ISO dates.`);
    }
    return merged;
  } catch (e) { console.error(`Ignoring ${p}: not valid JSON (${e.message}).`); return { ...PRICING }; }
}

// The price entry for a short model name by longest-prefix match, or null if the
// model isn't in the table at all. Split out from priceBase so the unpriced
// footnote can tell "no such model" from "no price on that date" — different
// gaps, different fixes.
function priceEntry(short, table) {
  const t = table || PRICING;
  const n = (short || '').toLowerCase();
  let best = null;
  for (const key of Object.keys(t)) {
    if (n === key || n.startsWith(key)) {
      if (best === null || key.length > best.length) best = key;
    }
  }
  return best === null ? null : t[best];
}
// The base price in force at `ts`, or null. A bare number is always in force. For
// an interval list, the first interval containing the timestamp's UTC *date*
// wins; the log stamps are Z, so a date slice is the comparison, not a guess at a
// local day. No timestamp against a dated entry is null on purpose — an undated
// lookup can't be answered from a table that varies by date, and answering it
// with "today" would reintroduce exactly the bug this shape fixes.
function baseAt(entry, ts) {
  if (typeof entry === 'number') return entry;
  if (!Array.isArray(entry) || !ts) return null;
  const day = String(ts).slice(0, 10);
  if (!ISO_DAY.test(day)) return null;
  for (const iv of entry) {
    if (!validInterval(iv)) continue;
    if (iv.from !== undefined && day < iv.from) continue;
    if (iv.to !== undefined && day > iv.to) continue;
    return iv.base;
  }
  return null;
}
// Longest-prefix base price for a short model name at a timestamp, or null if
// unpriced (unknown model, or a date no interval covers).
function priceBase(short, table, ts) {
  const entry = priceEntry(short, table);
  return (entry === null || entry === undefined) ? null : baseAt(entry, ts);
}
// Cost of one message's five token classes, USD. { cost, priced } — priced=false
// (cost 0) for synthetic/unknown models and for dates outside every interval,
// both surfaced in the drift report.
function messageCost(short, t, table, ts) {
  const base = priceBase(short, table, ts);
  if (base === null) return { cost: 0, priced: false };
  const cost = (
    (t.input || 0) * base +
    (t.output || 0) * base * MULT.output +
    (t.cacheRead || 0) * base * MULT.cacheRead +
    (t.write5m || 0) * base * MULT.write5m +
    (t.write1h || 0) * base * MULT.write1h
  ) / 1e6;
  return { cost, priced: true };
}

// --- dimensions ----------------------------------------------------------

const shortModel = (m) => m ? m.replace(/^claude-/, '') : 'unknown';

// Local-time bucket key for a timestamp at a given granularity. Local tz on
// purpose (a day/hour means the local one); 'unknown' for a missing/bad stamp.
function timeBucket(iso, gran) {
  if (!iso) return 'unknown';
  const d = new Date(iso);
  if (isNaN(d)) return 'unknown';
  const Y = d.getFullYear();
  const M = String(d.getMonth() + 1).padStart(2, '0');
  const D = String(d.getDate()).padStart(2, '0');
  const H = String(d.getHours()).padStart(2, '0');
  switch (gran) {
    case 'year': return String(Y);
    case 'month': return `${Y}-${M}`;
    case 'day': return `${Y}-${M}-${D}`;
    case 'hour': return `${Y}-${M}-${D} ${H}h`;
    case 'week': return isoWeek(d);
    default: return 'unknown';
  }
}
// ISO-8601 week key (YYYY-Www), local. Weeks start Monday; week 1 holds Jan 4.
function isoWeek(d) {
  const t = new Date(d.getFullYear(), d.getMonth(), d.getDate());
  const dow = (t.getDay() + 6) % 7;       // Mon=0..Sun=6
  t.setDate(t.getDate() - dow + 3);        // move to the Thursday of this week
  const firstThu = new Date(t.getFullYear(), 0, 4);
  const fdow = (firstThu.getDay() + 6) % 7;
  firstThu.setDate(firstThu.getDate() - fdow + 3);
  const week = 1 + Math.round((t - firstThu) / (7 * 86400000));
  return `${t.getFullYear()}-W${String(week).padStart(2, '0')}`;
}

// Every dimension the report can group or filter by. A getter maps one event to
// its key string; empty optional fields collapse to '—' so a group/filter has a
// stable bucket. Keep this list and HELP + README in step.
const DIMS = {
  repo: (e) => e.repo || '—',
  // A session key is the full UUID — never a synthetic ordinal, which the design
  // permits only as a display label. The row *shows* a short prefix (see
  // sessionLabel); grouping on the prefix would silently merge two sessions that
  // happened to share eight characters.
  session: (e) => e.session || '—',
  model: (e) => e.model || 'unknown',
  branch: (e) => e.branch || '—',
  kind: (e) => e.kind || '—',
  entrypoint: (e) => e.entrypoint || '—',
  'cc-version': (e) => e.version || '—',
  agent: (e) => e.agent || '—',
  year: (e) => timeBucket(e.ts, 'year'),
  month: (e) => timeBucket(e.ts, 'month'),
  week: (e) => timeBucket(e.ts, 'week'),
  day: (e) => timeBucket(e.ts, 'day'),
  hour: (e) => timeBucket(e.ts, 'hour'),
};
const TIME_DIMS = new Set(['year', 'month', 'week', 'day', 'hour']);
// How a group key is *shown* in the human table. Only session differs: a full
// UUID is 36 columns of mostly-noise in a table already fighting for width, and
// the prefix is what you paste back into --session anyway. Human output only —
// --json/--csv keep the whole key, because a truncated id you can't look up is
// worse than a wide one you can.
const SESSION_LABEL_CHARS = 8;
function dispLabel(dim, value) {
  if (dim !== 'session' || typeof value !== 'string') return value;
  return value.length > SESSION_LABEL_CHARS ? value.slice(0, SESSION_LABEL_CHARS) : value;
}
const SORT_KEYS = new Set(['cost', 'tokens', 'count', 'name', 'time']);

// --- aggregates ----------------------------------------------------------

const zeroAgg = () => ({
  messages: 0, inputTokens: 0, outputTokens: 0,
  cacheCreationTokens: 0, cacheReadTokens: 0, totalTokens: 0, cost: 0,
  coveredTokens: 0, uncoveredCost: 0,
});
function addTo(agg, v) {
  agg.messages += v.messages || 0;
  agg.inputTokens += v.inputTokens || 0;
  agg.outputTokens += v.outputTokens || 0;
  agg.cacheCreationTokens += v.cacheCreationTokens || 0;
  agg.cacheReadTokens += v.cacheReadTokens || 0;
  agg.totalTokens += v.totalTokens || 0;
  agg.cost += v.cost || 0;
  agg.coveredTokens += v.coveredTokens || 0;
  agg.uncoveredCost += v.uncoveredCost || 0;
}
// Share of prompt-side tokens served from cache: read / (input + create + read).
// null when there were no prompt-side tokens at all.
function cacheHitRate(agg) {
  const denom = (agg.inputTokens || 0) + (agg.cacheCreationTokens || 0) + (agg.cacheReadTokens || 0);
  return denom ? (agg.cacheReadTokens || 0) / denom : null;
}

// --- context size --------------------------------------------------------
//
// Context is the one metric here that must NOT be summed. Every message carries
// the whole cached prefix, so adding message context sizes counts the same window
// over and over — a session's "total context" is a meaningless multiple of itself.
// The two figures that do mean something are computed over *per-session peaks*:
//
//   max    — the worst window any session in the group reached (the alarm)
//   median — what a typical session in the group weighs (the habit)
//
// Neither alone is honest. A group of 11 sessions with one 578k blow-out and a
// 108k median reads as dangerous on max and calm on median; both together say
// "usually fine, once wasn't" — which is the actual situation. (Measured on live
// logs 2026-07-26; that pair is a real repo, not a hypothetical.)
//
// Peak *per session*, not per message: every session ramps from near-empty, so a
// message-grain median understates the weight sessions actually reach (122k vs
// 168k across the live set). Same definition cctranscript(1) headlines per
// session, so the two tools agree on what "context" means.
// Linear-interpolated quantile over an ascending array (numpy's default method),
// so the median is the usual average-of-the-two-middles and p90 doesn't jump in
// steps on small groups. `sorted` must already be ascending.
function quantile(sorted, p) {
  if (!sorted.length) return null;
  const idx = (sorted.length - 1) * p;
  const lo = Math.floor(idx), hi = Math.ceil(idx);
  return lo === hi ? sorted[lo] : sorted[lo] + (sorted[hi] - sorted[lo]) * (idx - lo);
}
// Every context figure for a node, from its session→peak map. The table shows
// median and max; --json/--csv carry the whole distribution, because a terminal
// column is width-bound and a data file isn't — p90 is what tells you whether a
// high max is one outlier or a fat tail, and mean-vs-median is the skew tell.
// All-zero peaks (a slice with no usage record) report null, never a fake 0.
function contextStats(sessions) {
  const peaks = [...sessions.values()].filter((v) => v > 0).sort((a, b) => a - b);
  if (!peaks.length) {
    return { sessions: 0, min: null, p25: null, median: null, p75: null, p90: null, max: null, mean: null };
  }
  return {
    sessions: peaks.length,
    min: peaks[0],
    p25: quantile(peaks, 0.25),
    median: quantile(peaks, 0.5),
    p75: quantile(peaks, 0.75),
    p90: quantile(peaks, 0.9),
    max: peaks[peaks.length - 1],
    mean: peaks.reduce((s, x) => s + x, 0) / peaks.length,
  };
}

// --- context-size filter (--context) --------------------------------------
//
// The first filter whose unit isn't the message. Context is a per-session
// PEAK (see above), so --context selects SESSIONS whose peak falls in the
// band and admits all of their messages — never a per-message test. A
// message-grain reading would be near-meaningless: every session ramps
// through every band below its peak, so almost every session would match
// almost every band. See ccrepo.design.md §4 / --help / man ccrepo.

// A bare amount: an integer or decimal, optionally suffixed k (×1e3) or m
// (×1e6) — same scale steps fmtTokens renders back out.
const CONTEXT_AMOUNT = /^(\d+(?:\.\d+)?)([km])?$/i;
function parseContextAmount(s) {
  const m = CONTEXT_AMOUNT.exec(s);
  if (!m) return null;
  const n = Number(m[1]);
  if (!Number.isFinite(n)) return null;
  const mult = m[2] ? (m[2].toLowerCase() === 'k' ? 1e3 : 1e6) : 1;
  return n * mult;
}
// Parse a `--context` spec — MIN-MAX, MIN-, or -MAX (k/m suffixes) — into
// { min, max } in raw tokens (either null ⇒ open-ended), or { error } for a
// malformed spec. Rejected outright rather than silently matching everything:
// no dash, neither bound present, an unparsable bound, or min > max.
function parseContextRange(spec) {
  const s = String(spec == null ? '' : spec).trim();
  const parts = s.split('-');
  if (parts.length !== 2) {
    return { error: `malformed --context range '${spec}': want MIN-MAX, MIN-, or -MAX, e.g. 100k-500k, 400k-, -100k` };
  }
  const [loRaw, hiRaw] = parts.map((p) => p.trim());
  const min = loRaw === '' ? null : parseContextAmount(loRaw);
  const max = hiRaw === '' ? null : parseContextAmount(hiRaw);
  if (loRaw !== '' && min === null) {
    return { error: `malformed --context lower bound '${loRaw}' in '${spec}': want a number with an optional k/m suffix` };
  }
  if (hiRaw !== '' && max === null) {
    return { error: `malformed --context upper bound '${hiRaw}' in '${spec}': want a number with an optional k/m suffix` };
  }
  if (min === null && max === null) return { error: `--context '${spec}' has no bound on either side` };
  if (min !== null && max !== null && min > max) {
    return { error: `--context '${spec}': lower bound ${min} exceeds upper bound ${max}` };
  }
  return { min, max };
}
// Per-session peak context over a set of events (reuses the same bumpPeak the
// tree nodes use, over a flat Map rather than a node). The caller decides the
// scope: main() computes this over the date-scoped (not yet dimension- or
// context-filtered) event set, so --context reads as "peak within the range
// you're viewing", consistent with how --since/--until already bound scope
// before the other filters apply.
function sessionPeaks(events) {
  const m = new Map();
  for (const e of events) bumpPeak(m, e.session, e.context);
  return m;
}
// Session-grain predicate: keep an event iff its session's peak (from a
// pre-computed `peaks` map) falls in `range`. No range ⇒ everything passes.
function buildContextFilter(range, peaks) {
  if (!range) return () => true;
  return (e) => {
    const p = peaks.get(e.session);
    if (p === undefined) return false;
    if (range.min !== null && p < range.min) return false;
    if (range.max !== null && p > range.max) return false;
    return true;
  };
}

// --- N-level grouping ----------------------------------------------------

const node = () => ({ agg: zeroAgg(), sessions: new Map(), children: new Map() });

// Raise a session's high-water context mark within one node. A Map keyed by
// session gives the distinct Sessions count (.size, exactly as the old Set did)
// AND the per-session peaks the context column needs, for one entry per session
// per node — bounded by session count, not message count.
function bumpPeak(sessions, session, context) {
  const prev = sessions.get(session);
  if (prev === undefined || (context || 0) > prev) sessions.set(session, context || 0);
}

// Fold events into a tree keyed by the ordered `keys`. Every node (root included)
// carries its own rolled-up agg and a Map of distinct session IDs → peak context —
// so a "Sessions" count is always distinct, never a sum of child slices, and the
// context figures are peaks-of-peaks rather than a nonsense sum. keys=[] ⇒ just
// the root (a single grand total).
function groupTree(events, keys) {
  const root = node();
  for (const e of events) {
    addTo(root.agg, e); bumpPeak(root.sessions, e.session, e.context);
    let cur = root;
    for (const k of keys) {
      const kv = String(DIMS[k] ? DIMS[k](e) : '—');
      let ch = cur.children.get(kv);
      if (!ch) { ch = node(); cur.children.set(kv, ch); }
      addTo(ch.agg, e); bumpPeak(ch.sessions, e.session, e.context);
      cur = ch;
    }
  }
  return root;
}

// Children of a node, sorted for a level. Default: time dims chronological
// ascending, everything else by cost descending. `spec` is a within-level chain
// — an array of {key,dir}, primary key first, later entries breaking ties —
// null/empty falls back to the one default. `--sort cost+name` and the like:
// the comma in --sort stays positional per -g level (decided, not re-opened);
// `+` is purely additive within a level, so `--sort cost` (a single key, no
// `+`) is just a one-element chain and behaves exactly as before.
function sortedEntries(nd, dimName, spec) {
  const entries = [...nd.children.entries()];
  const chain = (spec && spec.length ? spec : [null]).map((s) => {
    const key = (s && s.key) || (TIME_DIMS.has(dimName) ? 'time' : 'cost');
    const dir = (s && s.dir) || (key === 'name' || key === 'time' ? 'asc' : 'desc');
    return { key, dir };
  });
  const val = (key, k, n) => {
    switch (key) {
      case 'cost': return n.agg.cost;
      case 'tokens': return n.agg.totalTokens;
      case 'count': return n.sessions.size;
      default: return k;                    // name | time
    }
  };
  entries.sort((a, b) => {
    for (const { key, dir } of chain) {
      const va = val(key, a[0], a[1]), vb = val(key, b[0], b[1]);
      const c = typeof va === 'string' ? va.localeCompare(vb) : va - vb;
      if (c !== 0) return dir === 'asc' ? c : -c;
    }
    return 0;
  });
  return entries;
}

// A level's sorted children, truncated to the first `topN` after sorting
// (falsy topN ⇒ no truncation). Shared by treeRows/leafRows so both walks
// apply --top identically: per level, not just at the leaves — a subtree's own
// subtotal is still the true total for everything under it (computed by
// groupTree over the whole event set, untouched here); --top only shortens
// which of its children get *listed*, never the number they carry.
function topEntries(nd, dimName, spec, topN) {
  const entries = sortedEntries(nd, dimName, spec);
  return topN ? entries.slice(0, topN) : entries;
}

// Pre-order rows for the indented tree: one row per node with its depth. Rows
// carry the session→peak map itself, not just its size, so the renderer can ask
// for the context figures (and the richer JSON distribution) without re-walking.
function treeRows(root, keys, specs, topN) {
  const rows = [];
  (function walk(nd, depth) {
    if (depth >= keys.length) return;
    for (const [k, child] of topEntries(nd, keys[depth], specs[depth], topN)) {
      rows.push({ depth: depth + 1, label: k, sessions: child.sessions.size, peaks: child.sessions, agg: child.agg });
      walk(child, depth + 1);
    }
  })(root, 0);
  return rows;
}
// Leaf rows (full key path) for flat / JSON / CSV — no subtotals.
function leafRows(root, keys, specs, topN) {
  const out = [];
  if (!keys.length) { out.push({ path: [], sessions: root.sessions.size, peaks: root.sessions, agg: root.agg }); return out; }
  (function walk(nd, depth, path) {
    if (depth >= keys.length) { out.push({ path, sessions: nd.sessions.size, peaks: nd.sessions, agg: nd.agg }); return; }
    for (const [k, child] of topEntries(nd, keys[depth], specs[depth], topN)) walk(child, depth + 1, [...path, k]);
  })(root, 0, []);
  return out;
}

// --- filters -------------------------------------------------------------

const escapeRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
// One filter term against one value. '*' globs; else session=prefix,
// model=substring, everything else=exact. All case-insensitive.
function globMatch(pattern, value, dim) {
  const p = pattern.toLowerCase(), v = String(value).toLowerCase();
  if (p.includes('*')) return new RegExp('^' + p.split('*').map(escapeRe).join('.*') + '$').test(v);
  if (dim === 'session') return v.startsWith(p);
  if (dim === 'model') return v.includes(p);
  return v === p;
}
// Build an AND-of-dimensions predicate from {dim: "a,b,!c"} specs. Comma = OR
// within a dimension; a leading '!' on a term excludes.
function buildDimFilter(specs) {
  const preds = [];
  for (const [dim, raw] of Object.entries(specs)) {
    // `session` used to need its own getter here because it was a filter without
    // being a dimension. It is a dimension now, so DIMS covers it — one getter,
    // no chance of the filter and the grouping disagreeing about what a session
    // key is. globMatch still gives it prefix semantics, which is the half that
    // was always filter-specific.
    const getter = DIMS[dim];
    if (!getter) continue;
    const inc = [], exc = [];
    for (const term of String(raw).split(',').map((s) => s.trim()).filter(Boolean)) {
      if (term.startsWith('!')) exc.push(term.slice(1)); else inc.push(term);
    }
    preds.push((e) => {
      const v = getter(e);
      if (exc.some((p) => globMatch(p, v, dim))) return false;
      if (inc.length && !inc.some((p) => globMatch(p, v, dim))) return false;
      return true;
    });
  }
  return (e) => preds.every((p) => p(e));
}

// --- reading the raw logs ------------------------------------------------

const projectsDir = path.join(os.homedir(), '.claude', 'projects');

// The ccarchive mirror location, resolved exactly as ccarchive does, and the
// live-vs-archive source root the walk reads. LOG_EXT is the on-disk suffix in
// each store (.jsonl live, .jsonl.gz in the mirror).
function defaultArchiveDest(home) {
  return path.join(home, 'Library', 'Mobile Documents', 'com~apple~CloudDocs', 'cc-transcripts');
}
function archiveRoot() {
  return destArg || process.env.CCARCHIVE_DEST || defaultArchiveDest(os.homedir());
}
function sourceRoot() { return fromArchive ? archiveRoot() : projectsDir; }
const LOG_EXT = fromArchive ? '.jsonl.gz' : '.jsonl';

function isDir(p) { try { return fs.statSync(p).isDirectory(); } catch { return false; } }

// iCloud's "Optimise Mac Storage" can evict an archived .gz to a dataless
// placeholder; *reading* one faults the bytes back down. ccrepo reads every file
// to sum spend, so a whole-archive run over an evicted mirror would bulk-download
// the history — skipped by default (counted as a gap), --materialise opts in.
// Ported from ccarchive: same SF_DATALESS signal, same CCARCHIVE_SIMULATE_DATALESS
// test seam (an eviction can't be forced on demand); its comments hold the full
// why (stat is metadata-only and never faults a file back).
const SF_DATALESS = 0x40000000;
function isDatalessFlags(flags) {
  return Number.isFinite(flags) && (flags & SF_DATALESS) !== 0;
}
function statFlags(p) {
  if (process.platform !== 'darwin') return null;
  try {
    const n = Number(execFileSync('stat', ['-f', '%f', p], { encoding: 'utf8' }).trim());
    return Number.isFinite(n) ? n : null;
  } catch { return null; }
}
function isDataless(p) {
  const sim = process.env.CCARCHIVE_SIMULATE_DATALESS;
  if (sim) return sim.split(',').some((s) => s !== '' && p.includes(s));
  const flags = statFlags(p);
  return flags === null ? false : isDatalessFlags(flags);
}

// Read a log's full text, transparently gunzipping an archived .gz mirror — the
// walk below stays blind to which store the bytes came from.
function readLogText(file) {
  const raw = fs.readFileSync(file);
  return file.endsWith('.gz') ? zlib.gunzipSync(raw).toString('utf8') : raw.toString('utf8');
}

// --- rollup precompute ledger (the speed layer) --------------------------
//
// A wide --from-archive run re-walks and re-gunzips *every* mirror file each
// time — the archive is the durable substrate, so the numbers already survive
// pruning; what hurts is recomputing them from ~1 GB of gzip on every run. The
// ledger caches the *parsed, priced events* per source file so a warm run only
// gunzips files that are genuinely new.
//
// Why cache per FILE, not per month/quarter (the design's first framing): a
// month rollup can't be fingerprinted without first reading files to learn each
// message's timestamp (chicken-and-egg), and a session that straddles a month
// boundary would be misassigned by any file-level date proxy (mtime ≠ the
// message timestamps ccrepo buckets by) — which would break the rollup==recompute
// floor. File-grain keying sidesteps both: events are cached exactly as parsed,
// and month/quarter/any grouping is computed downstream from true timestamps,
// identical to an uncached run. The archive is append-only, so an old file's
// (mtime,size) never changes ⇒ always a hit; a new file lands ⇒ one miss, read
// once. That is precisely "valid until new files land under that period."
//
// Correctness: a cached event round-trips through JSON bit-identically (integers
// exact; IEEE-754 doubles are shortest-round-trippable), and feeds the very same
// grouping/filter/reconcile code an uncached event does — so the cache changes
// speed, never a displayed number. Cost and the covered/uncovered split are baked
// per event, so they depend on the price table and the billing covers-list; both
// are folded into a recipe signature and a change to either rebuilds the whole
// ledger (rare, and exactly when you *want* a recompute). Machine-local, never in
// a repo — the same class as ~/.claude/ccrepo-pricing.json / ccrepo-billing.json.
// Bump this whenever a cached event gains or changes a FIELD. A ledger written by
// an older schema is discarded wholesale rather than read: the fingerprint check
// only proves the source file is unchanged, so a cached event missing a new field
// would sail through as valid and report a confident zero. (/2 added `context`;
// without the bump, every warm archive run would have shown 0 context forever.)
// The recipe signature is the other half of this — it catches changed *values*
// (price table, covers list); the schema catches changed *shape*.
const ROLLUP_SCHEMA = 'ccrepo-rollup/2';
function rollupFile() {
  return process.env.CCREPO_ROLLUP || path.join(os.homedir(), '.claude', 'ccrepo-rollup.json');
}
// A file's cheap validity fingerprint: mtime + size. Append-only ⇒ stable.
function fileFingerprint(st) { return `${Math.round(st.mtimeMs)}:${st.size}`; }
// Stable JSON (object keys sorted) so a recipe signature is order-insensitive.
function stableStringify(o) {
  return JSON.stringify(o, (_k, v) =>
    (v && typeof v === 'object' && !Array.isArray(v))
      ? Object.fromEntries(Object.keys(v).sort().map((k) => [k, v[k]]))
      : v);
}
// Everything that changes an event's stored *values* (cost, covered split): the
// merged price table and the billing covers descriptor. Anything else (grouping,
// filters, dates, FX) is applied downstream over the cached events, so it never
// belongs here. A signature mismatch ⇒ the ledger for that root is rebuilt whole.
function recipeSig(pricing, coversDesc) {
  return stableStringify({ pricing: pricing || {}, covers: coversDesc || null });
}
// Load the ledger, or a fresh empty one. Malformed / wrong-schema ⇒ fresh (with a
// warning), never fatal — a corrupt speed cache must never break the tool.
function loadRollup(file) {
  let raw;
  try { raw = fs.readFileSync(file, 'utf8'); } catch { return { schema: ROLLUP_SCHEMA, roots: {} }; }
  try {
    const led = JSON.parse(raw);
    if (!led || led.schema !== ROLLUP_SCHEMA || typeof led.roots !== 'object') {
      return { schema: ROLLUP_SCHEMA, roots: {} };
    }
    return led;
  } catch (e) {
    console.error(`Ignoring ${file}: not valid rollup JSON (${e.message}); rebuilding.`);
    return { schema: ROLLUP_SCHEMA, roots: {} };
  }
}
// Persist the ledger. Best-effort: a write failure warns and is swallowed — the
// run already has its (freshly computed) numbers, only the next run's speed-up is
// lost. Never fatal.
function saveRollup(file, led) {
  try {
    fs.mkdirSync(path.dirname(file), { recursive: true });
    fs.writeFileSync(file, JSON.stringify(led));
  } catch (e) {
    console.error(`Couldn't write rollup ledger ${file}: ${e.message} (speed cache only; numbers unaffected).`);
  }
}

// The folder name dash-mangles every '/', '.', '_' alike, so the true repo name
// is unrecoverable from it — the logs record the real cwd, so read it from there.
function cwdFromLog(file) {
  let chunk;
  try {
    if (file.endsWith('.gz')) {
      // gzip has no cheap partial read; these logs are small enough that a full
      // gunzip for the 64 KB cwd sniff is fine.
      chunk = zlib.gunzipSync(fs.readFileSync(file)).toString('utf8', 0, 65536);
    } else {
      const fd = fs.openSync(file, 'r');
      const buf = Buffer.alloc(65536);
      const n = fs.readSync(fd, buf, 0, buf.length, 0);
      fs.closeSync(fd);
      chunk = buf.toString('utf8', 0, n);
    }
  } catch { return null; }
  const m = chunk.match(/"cwd"\s*:\s*"((?:[^"\\]|\\.)*)"/);
  if (!m) return null;
  try { return JSON.parse(`"${m[1]}"`); } catch { return null; }
}
// Prefer the exact logged name; else dash-decode the folder's last segment.
function label(encoded, labels) {
  if (labels.has(encoded)) return labels.get(encoded);
  const seg = String(encoded).split('-').filter(Boolean);
  return seg[seg.length - 1] || encoded;
}

// Yield every .jsonl under a repo dir with its owning session + whether it's a
// subagent log. Layout: <repo>/<uuid>.jsonl is a main session (session=uuid);
// <repo>/<uuid>/subagents/agent-*.jsonl is that session's subagent (session=uuid,
// sub=true) — real spend ccusage folds into the parent, so it must be read too.
function* walkSessionFiles(dir, session) {
  let entries;
  try { entries = fs.readdirSync(dir); } catch { return; }
  for (const entry of entries) {
    const p = path.join(dir, entry);
    if (isDir(p)) {
      // At the repo root, a subdir is named for its parent session UUID; anything
      // below that (session != null) is a subagent log owned by that session.
      yield* walkSessionFiles(p, session || entry);
    } else if (entry.endsWith(LOG_EXT)) {
      // LOG_EXT is .jsonl live, .jsonl.gz in the archive; strip whichever for the
      // session id. Archived tool-result sidecars mirror to <name>.gz (not
      // .jsonl.gz), so they fall through here just as they do live.
      yield { full: p, session: session || entry.slice(0, -LOG_EXT.length), sub: session != null };
    }
  }
}

// Parse one already-JSON.parsed assistant log record into an event, or null if
// it isn't a priced assistant message. `covers` (or null) classifies the model
// for the billing split. Pure over its inputs — the tests drive it directly.
function eventFrom(o, ctx) {
  if (!o || o.type !== 'assistant') return null;
  const msg = o.message || {};
  const u = msg.usage || {};
  const cc = u.cache_creation || {};
  const w5 = cc.ephemeral_5m_input_tokens || 0;
  const w1 = cc.ephemeral_1h_input_tokens || 0;
  const input = u.input_tokens || 0;
  const output = u.output_tokens || 0;
  const cacheRead = u.cache_read_input_tokens || 0;
  const create = (w5 + w1) || (u.cache_creation_input_tokens || 0);
  const total = input + output + cacheRead + create;
  const model = shortModel(msg.model);
  // Context size at the moment of this request: everything the model was *sent*,
  // however it was billed — the cached prefix (cache_read) and freshly-cached
  // blocks (cache_creation) are in the window just as much as fresh input is.
  // Output is excluded: it isn't in the window the request was served against.
  // (Same definition cctranscript(1) reports per session, deliberately.)
  const context = input + cacheRead + create;
  const { cost, priced } = messageCost(model, { input, output, cacheRead, write5m: w5, write1h: w1 }, ctx && ctx.pricing, o.timestamp);
  const covered = ctx && ctx.covers ? ctx.covers(model) : false;
  return {
    // Falsy when the repo label isn't known yet (e.g. a subagent log walked
    // before its dir's main file) — readAllEvents resolves it after the walk.
    // A truthy placeholder here would lock in and skip that resolution.
    repo: (ctx && ctx.repo) || '',
    session: (ctx && ctx.session) || o.sessionId || '—',
    model,
    branch: o.gitBranch || '',
    kind: (o.isSidechain || (ctx && ctx.sub)) ? 'subagent' : 'main',
    entrypoint: o.entrypoint || '',
    version: o.version || '',
    agent: o.agent || '',
    ts: o.timestamp || '',
    priced, total, context,
    messages: 1,               // one event = one (deduped) assistant message
    inputTokens: input, outputTokens: output,
    cacheCreationTokens: create, cacheReadTokens: cacheRead,
    totalTokens: total, cost,
    coveredTokens: covered ? total : 0,
    uncoveredCost: covered ? 0 : cost,
  };
}

// Keep the richest record for a dedup key: the one with the most tokens wins
// (max-total-wins). Claude Code re-emits the same (message.id, requestId) on more
// than one JSONL line — a streaming/replay artefact — and the copies can differ:
// an earlier line carries the complete usage, a trailing line carries partial or
// zeroed counts. Last-wins takes that trailing line and undercounts; first-wins
// undercounts the other way (~4% on partial-first streams). The complete line is
// always the max, so max-total-wins recovers it in both directions — and matches
// ccusage exactly (measured $0.00 per-model on the static matched set; last-wins
// left sonnet-5 short by ~1.5% via zero/partial-tail duplicate lines). For the
// ordinary single-copy or ascending-stream case the final line already *is* the
// max, so this is identical to last-wins there. Mutates `map`; returns nothing.
function keepRicher(map, key, e) {
  const prev = map.get(key);
  if (!prev || (e.total || 0) > (prev.total || 0)) map.set(key, e);
}

// Parse one session log's whole text into its list of (pre-dedup) events, each
// tagged with its encoded-dir and dedup key. Pulled out of the walk so a cached
// file can skip it entirely — this gunzip+JSON.parse loop is the expensive work
// the rollup ledger exists to avoid re-running. Repo is left unresolved ('') and
// filled in after the walk from the dir labels, exactly as before.
function parseFileEvents(full, enc, session, sub, covers, pricing) {
  const out = [];
  let content;
  try { content = readLogText(full); } catch { return out; }
  for (const line of content.split('\n')) {
    if (!line) continue;
    let o;
    try { o = JSON.parse(line); } catch { continue; }
    if (o.type !== 'assistant') continue;
    const e = eventFrom(o, { repo: '', session, sub, covers, pricing });
    if (!e) continue;
    e._enc = enc;
    const mid = (o.message && o.message.id) || '';
    e._key = mid ? mid + '|' + (o.requestId || '') : null;
    out.push(e);
  }
  return out;
}

// Walk every session log, emit one event per priced assistant message. Dedups on
// (message.id, requestId) via keepRicher (max-total-wins, see above). A message
// with no id is always kept. Returns events + encoded→label map + unpriced tally.
//
// `rollup` (archive mode only; null disables) is the speed layer: { path, sig }.
// Each source file's parsed events are cached under its (mtime,size) fingerprint,
// so a warm run gunzips only genuinely new files. The cache is a pure speed
// memoisation — the assembled event set is identical to an uncached walk (see the
// ledger comment above), so grouping/filters/reconcile downstream see no
// difference. Returns a `rollup` stats block ({ path, hits, misses }) for the
// footnote; null when the ledger is off.
function readAllEvents(covers, pricing, rollup) {
  const byKey = new Map();     // (message.id|requestId) -> event, richest wins
  const noKey = [];            // events with no message.id
  const repoLabels = new Map();
  let evicted = 0;             // archive mirrors skipped (dataless); a stated gap
  const root = sourceRoot();

  // Ledger: per archive-root, a recipe signature + per-file {fp, events} and the
  // dir→label map. A signature mismatch (price table or covers changed) rebuilds
  // the root's slice whole, since the baked cost/covered would otherwise be stale.
  let ledger = null, rootEntry = null, dirty = false, hits = 0, misses = 0;
  if (rollup) {
    ledger = loadRollup(rollup.path);
    rootEntry = ledger.roots[root];
    if (!rootEntry || rootEntry.sig !== rollup.sig) {
      rootEntry = { sig: rollup.sig, labels: {}, files: {} };
      ledger.roots[root] = rootEntry;
      dirty = true;
    }
  }

  let dirs;
  try { dirs = fs.readdirSync(root); }
  catch { return { events: [], repoLabels, unpriced: new Map(), evicted, rollup: rollup ? { path: rollup.path, hits, misses } : null }; }
  for (const enc of dirs) {
    // _external is ccarchive's reserved home for the archived history.jsonl, not a
    // repo folder — never a session log to price.
    if (fromArchive && enc === '_external') continue;
    const dir = path.join(root, enc);
    if (!isDir(dir)) continue;
    // Seed the label from the ledger when we have it — a cached dir then needs no
    // main-file read at all. cwd is written once at session start, so the cached
    // label stays valid for the life of the file.
    let lab = (rootEntry && rootEntry.labels[enc]) || null;
    for (const { full, session, sub } of walkSessionFiles(dir, null)) {
      // An evicted archive mirror is skipped, not read: ccrepo reads every file,
      // so reading it would fault its bytes back from iCloud. Counted as a gap;
      // --materialise opts into reading (and thus re-downloading) them. Checked
      // before the cache so eviction handling is byte-identical with the ledger
      // on or off (a dataless file is a gap either way, never served from cache).
      if (fromArchive && !materialise && isDataless(full)) { evicted++; continue; }

      let fileEvents;
      if (rollup) {
        let st;
        try { st = fs.statSync(full); } catch { continue; }
        const fp = fileFingerprint(st);
        const cached = rootEntry.files[path.relative(root, full)];
        if (cached && cached.fp === fp) {
          fileEvents = cached.events;          // hit — no gunzip, no parse
          hits++;
        } else {
          // Miss: repo label from a main (non-subagent) file's cwd — a subagent
          // may run in a worktree whose basename isn't the repo's.
          if (lab === null && !sub) { const cwd = cwdFromLog(full); if (cwd) lab = path.basename(cwd); }
          fileEvents = parseFileEvents(full, enc, session, sub, covers, pricing);
          rootEntry.files[path.relative(root, full)] = { fp, events: fileEvents };
          dirty = true;
          misses++;
        }
      } else {
        if (lab === null && !sub) { const cwd = cwdFromLog(full); if (cwd) lab = path.basename(cwd); }
        fileEvents = parseFileEvents(full, enc, session, sub, covers, pricing);
      }

      for (const e of fileEvents) {
        if (e._key) keepRicher(byKey, e._key, e); else noKey.push(e);
      }
    }
    if (lab) {
      repoLabels.set(enc, lab);
      if (rootEntry && rootEntry.labels[enc] !== lab) { rootEntry.labels[enc] = lab; dirty = true; }
    }
  }

  if (rollup && dirty) saveRollup(rollup.path, ledger);

  const events = [...byKey.values(), ...noKey];
  const unpriced = new Map();
  // Why a message is unpriced decides what you do about it, so the tally carries
  // the reason. A model absent from the table needs a price added; a model that
  // *is* in the table needs an interval widened to cover that date. Derived here
  // rather than stored on the event: it's a pure re-lookup over inputs the walk
  // already has, and a new cached field would cost a ROLLUP_SCHEMA bump for
  // something only the footnote reads.
  for (const e of events) {
    if (!e.repo) e.repo = label(e._enc, repoLabels);
    if (!e.priced && e.total > 0) {
      const reason = priceEntry(e.model, pricing) === null ? 'model' : 'date';
      const prev = unpriced.get(e.model) || { messages: 0, reason };
      prev.messages += 1;
      unpriced.set(e.model, prev);
    }
  }
  return { events, repoLabels, unpriced, evicted, rollup: rollup ? { path: rollup.path, hits, misses } : null };
}

// --- reconciliation against ccusage --------------------------------------

function runCcusage(passthrough) {
  try {
    const out = execFileSync('ccusage', ['session', '--json', ...passthrough], {
      encoding: 'utf8', maxBuffer: 64 * 1024 * 1024,
    });
    return JSON.parse(out).session;
  } catch { return null; }
}

// Compare ccrepo's own per-session/per-model cost against ccusage's. Pure — the
// tests drive it with fixture arrays. Returns null when ccusage is unavailable.
function reconcile(myEvents, ccuSessions) {
  if (!Array.isArray(ccuSessions)) return null;
  const myP = new Map();
  for (const e of myEvents) myP.set(e.session, (myP.get(e.session) || 0) + e.cost);
  const cuP = new Map();
  for (const s of ccuSessions) cuP.set(s.period, (cuP.get(s.period) || 0) + (s.totalCost || 0));
  // A session is comparable only when BOTH sides carry it. Everything — the total
  // AND the per-model breakdown — is scoped to that matched set; a session only
  // one side has (date-clip at the window edge, log pruning) is reported as a
  // scope gap (myOnly/cuOnly), never smeared into a per-model delta. Scoping the
  // total but not the per-model was the bug that made a handful of edge sessions
  // read as "fable +8.9%, opus +7.0%" phantom drift.
  const matchedSet = new Set();
  let myTot = 0, cuTot = 0, myOnly = 0, cuOnly = 0;
  for (const p of new Set([...myP.keys(), ...cuP.keys()])) {
    const a = myP.get(p), b = cuP.get(p);
    if (a != null && b != null) { myTot += a; cuTot += b; matchedSet.add(p); }
    else if (a != null) myOnly++;
    else cuOnly++;
  }
  const myM = new Map(), cuM = new Map();
  for (const e of myEvents) if (matchedSet.has(e.session)) myM.set(e.model, (myM.get(e.model) || 0) + e.cost);
  for (const s of ccuSessions) {
    if (!matchedSet.has(s.period)) continue;
    for (const mb of s.modelBreakdowns || []) {
      const m = shortModel(mb.modelName);
      cuM.set(m, (cuM.get(m) || 0) + (mb.cost || 0));
    }
  }
  const models = [...new Set([...myM.keys(), ...cuM.keys()])].map((m) => {
    const a = myM.get(m) || 0, b = cuM.get(m) || 0;
    return { model: m, mine: a, ccu: b, delta: a - b, pct: b ? (a - b) / b : (a ? Infinity : 0) };
  }).sort((x, y) => Math.abs(y.delta) - Math.abs(x.delta));
  return { myTot, cuTot, delta: myTot - cuTot, pct: cuTot ? (myTot - cuTot) / cuTot : 0, matched: matchedSet.size, myOnly, cuOnly, models };
}

// --- billing model (Actual vs Est) ---------------------------------------

// Normalise the optional `spend` block — the genuine-outlay source for the
// actual-spend-vs-estimate reconciliation (the money-side analog of the ccusage
// cross-check). Two modes:
//   plan  (default): genuine outlay = plan fee × months-in-scope + uncovered spend.
//   usage          : genuine outlay = sum of invoiced/metered figures per month.
// Absent ⇒ plan mode with no periods, so any pre-spend config gets the plan-mode
// comparison for free (backwards compatible). A bad mode falls back to plan with a
// warning; non-'YYYY-MM' or non-finite period entries are dropped, never fatal.
function normaliseSpend(raw, srcPath) {
  const out = { mode: 'plan', periods: {} };
  if (raw == null || typeof raw !== 'object') return out;
  if (raw.mode != null) {
    const m = String(raw.mode).toLowerCase();
    if (m === 'plan' || m === 'usage') out.mode = m;
    else console.error(`Ignoring spend.mode '${raw.mode}' in ${srcPath}: expected 'plan' or 'usage'; using plan.`);
  }
  if (raw.periods != null && typeof raw.periods === 'object') {
    for (const [k, v] of Object.entries(raw.periods)) {
      if (/^\d{4}-\d{2}$/.test(k) && Number.isFinite(v) && v >= 0) out.periods[k] = v;
      else console.error(`Ignoring spend.periods["${k}"] in ${srcPath}: need a "YYYY-MM" key and a finite amount ≥ 0.`);
    }
  }
  return out;
}

function loadBilling(file) {
  const p = file || path.join(os.homedir(), '.claude', 'ccrepo-billing.json');
  let raw;
  try { raw = fs.readFileSync(p, 'utf8'); } catch { return null; }
  let cfg;
  try { cfg = JSON.parse(raw); }
  catch (e) { console.error(`Ignoring ${p}: not valid JSON (${e.message}).`); return null; }
  if (!cfg || typeof cfg !== 'object' || !cfg.plan || !(cfg.plan.monthlyCost > 0)) {
    console.error(`Ignoring ${p}: needs plan.monthlyCost > 0.`);
    return null;
  }
  return {
    currency: (cfg.currency || 'USD').toUpperCase(),
    plan: {
      name: cfg.plan.name || 'plan',
      monthlyCost: cfg.plan.monthlyCost,
      covers: Array.isArray(cfg.plan.covers) ? cfg.plan.covers.map((s) => String(s).toLowerCase()) : [],
    },
    perTokenModels: Array.isArray(cfg.perTokenModels) ? cfg.perTokenModels.map((s) => String(s).toLowerCase()) : [],
    spend: normaliseSpend(cfg.spend, p),
  };
}
function coversPredicate(billing) {
  if (!billing) return null;
  const { covers } = billing.plan;
  const carve = billing.perTokenModels;
  const hit = (list, n) => list.some((c) => n === c || n.startsWith(c));
  return (shortName) => {
    const n = (shortName || '').toLowerCase();
    return hit(covers, n) && !hit(carve, n);
  };
}
function actualFor(agg, { monthlyCostUSD, totalCovered, totalAllTokens }) {
  const useCovered = totalCovered > 0;
  const basis = useCovered ? (agg.coveredTokens || 0) : (agg.totalTokens || 0);
  const denom = useCovered ? totalCovered : totalAllTokens;
  const share = denom ? monthlyCostUSD * basis / denom : 0;
  return (agg.uncoveredCost || 0) + share;
}

// Actual spend vs the API-list-price estimate — the money-side analog of the
// ccusage cross-check. Pure over its inputs (the tests drive it with fixture
// arrays); everything is folded in USD, the display rate applies at render. Like
// the ccusage reconciliation it works over the whole date-comparable scope, not a
// dimension-filtered slice: the subscription fee is global, so comparing a per-repo
// estimate against the whole plan fee would be apples-to-oranges. Returns null when
// there is no billing config; { available:false, reason } when the config can't
// answer for the range (degrade honestly, never fabricate a figure).
//   plan mode : billed = plan fee × distinct months in scope + uncovered per-token
//               spend (the "true outlay = months × fee" the Actual column footnote
//               only gestures at, made observable and reconciled).
//   usage mode: billed = Σ invoiced/metered figures for the months in scope; a month
//               with no figure is a stated gap, not smeared into the delta.
function reconcileSpend(events, spend, { monthlyCostUSD, planName, periodsUSD }) {
  if (!spend) return null;
  const months = new Set();
  let estimate = 0, uncovered = 0;
  for (const e of events) {
    estimate += e.cost || 0;
    uncovered += e.uncoveredCost || 0;
    const m = timeBucket(e.ts, 'month');
    if (m !== 'unknown') months.add(m);
  }
  const monthList = [...months].sort();
  const withDelta = (billed, extra) => ({
    available: true, mode: spend.mode, billed, estimate,
    delta: billed - estimate, pct: estimate ? (billed - estimate) / estimate : (billed ? Infinity : 0),
    months: monthList, ...extra,
  });
  if (spend.mode === 'usage') {
    const covered = [], gaps = [];
    let billed = 0;
    for (const m of monthList) {
      if (periodsUSD && periodsUSD[m] != null) { billed += periodsUSD[m]; covered.push(m); }
      else gaps.push(m);
    }
    if (!covered.length) {
      const reason = monthList.length
        ? `spend.mode is 'usage' but no spend.periods figure covers any month in range (${monthList.join(', ')})`
        : 'no usage in range to compare';
      return { available: false, mode: 'usage', reason, estimate, months: monthList, gaps };
    }
    return withDelta(billed, { covered, gaps });
  }
  // plan mode
  if (!monthList.length) return { available: false, mode: 'plan', reason: 'no usage in range to compare', estimate, months: monthList, planName };
  const planTotal = monthlyCostUSD * monthList.length;
  return withDelta(planTotal + uncovered, { planName, monthlyCostUSD, monthsCount: monthList.length, planTotal, uncovered });
}

async function fetchUsdRates() {
  try {
    const res = await fetch('https://open.er-api.com/v6/latest/USD', { signal: AbortSignal.timeout(4000) });
    const data = await res.json();
    if (data && data.rates) return data.rates;
  } catch { /* offline — caller degrades honestly */ }
  return null;
}

// --- CLI parsing (pure at load; no output/exit until main → checkArgs) ----

const argv = process.argv.slice(2);
const has = (f) => argv.includes(f);
function takeValue(...flags) {
  for (const f of flags) { const i = argv.indexOf(f); if (i !== -1) return argv[i + 1]; }
  return null;
}

const asJson = has('--json');
const asCsv = has('--csv');
const flat = has('--flat');
const noBilling = has('--no-billing');
const noReconcile = has('--no-reconcile');
const noRollup = has('--no-rollup');

let fxCode = takeValue('--fx'); fxCode = fxCode ? fxCode.toUpperCase() : null;
const currency = fxCode || 'NZD';
const converted = currency !== 'USD';
const forcedRate = has('--rate') ? Number(takeValue('--rate')) : null;

const groupArg = (takeValue('-g', '--group') || 'repo').trim();
const keys = (groupArg === '' || groupArg === 'total') ? [] : groupArg.split(',').map((s) => s.trim()).filter(Boolean);

const FILTER_FLAGS = {
  '--repo': 'repo', '--model': 'model', '--branch': 'branch', '--kind': 'kind',
  '--entrypoint': 'entrypoint', '--cc-version': 'cc-version', '--agent': 'agent', '--session': 'session',
};
const filterSpecs = {};
for (const [flag, dim] of Object.entries(FILTER_FLAGS)) { const v = takeValue(flag); if (v != null) filterSpecs[dim] = v; }

const since = takeValue('--since');
const until = takeValue('--until');
const tz = takeValue('-z', '--timezone');

// --context is session-grain (see the comment above buildContextFilter), not a
// FILTER_FLAGS entry: it needs a precomputed peaks map, not a plain per-message
// getter. Parsed once here so a malformed spec fails in checkArgs like every
// other bad argument, not deep inside main().
const contextArg = takeValue('--context');
const contextRange = contextArg != null ? parseContextRange(contextArg) : null;

const topArg = takeValue('--top');
const topN = topArg != null ? Number(topArg) : null;

// A --sort level is a within-level CHAIN: key[+key2...][:asc|desc]. The comma
// stays positional per -g level (decided 2026-07-26 — not re-opened); `+` is
// purely additive, chosen against the punctuation already in the flag (`,`
// separates levels, `:` separates direction, so `+` was the one gap left) —
// so `--sort cost` is unaffected, just a one-element chain at every level.
function parseSortLevel(p) {
  return p.split('+').map((sub) => {
    const [k, dir] = sub.split(':');
    return { key: (k || '').trim(), dir: dir ? dir.trim() : null };
  }).filter((s) => s.key);
}
function parseSort(arg, ks) {
  if (!arg) return ks.map(() => null);
  const parts = arg.split(',').map((s) => s.trim()).filter(Boolean).map(parseSortLevel);
  if (parts.length === 1) return ks.map(() => parts[0]);
  return ks.map((_, i) => parts[i] || null);
}
const sortSpecs = parseSort(takeValue('--sort'), keys);

// Section names + membership are Mike's call (ROADMAP v3 ask 5), not ccrepo's
// invention: SELECT/SHAPE/OUTPUT/SOURCE/PRICING/META. Line budget: the old
// single-OPTIONS digest was 39 real lines; six named headers replacing that one
// header add 5, and the two new flags (--context, --top) add 2 more — 46 real
// lines, not fitted after the fact. See the --help line-count test (which
// counts split('\n').length, one more than the real line count) for the guard.
const HELP = `ccrepo — Claude Code usage totals, grouped and filtered any way you like

USAGE
  ccrepo [options]

SELECT
  --repo <list>          Filter by repo, e.g. ros,faves   '!scanme' excludes
  --model <list>         Filter by model (substring), e.g. opus
  --branch <list>        Filter by branch (glob), e.g. 'client-*'
  --kind <list>          main | subagent
  --entrypoint <list>    cli | claude-vscode
  --cc-version <list>    e.g. 2.1.209
  --agent <list>         Agent type
  --session <list>       Session UUID prefix, e.g. 01c3,ff97
  --since <YYYYMMDD>     On or after this local date
  --until <YYYYMMDD>     On or before this local date
  --context <range>      SESSION peak (not per-message): 100k-500k, 400k-, -100k
SHAPE
  -g, --group <list>     Ordered dims, nested left→right (default repo)
                         repo · session · model · branch · kind · entrypoint ·
                         cc-version · agent · year|month|week|day|hour · total
  --sort <list>          Per level (aligned to -g); + chains keys within a level
                         cost·tokens·count·name·time, optional :asc/:desc
  --top <n>              Keep only the first n rows per level, after sorting
  --flat                 One column per group level (spreadsheet shape)
OUTPUT
  --json                 Tidy JSON, one record per leaf
  --csv                  Same shape as CSV
  --fx <code>            Convert to an ISO-4217 currency (default nzd; usd=raw)
  --rate <n>             Force the USD→<code> rate instead of fetching
SOURCE
  --from-archive         Read ccarchive's mirror, not the live logs (pruned history)
  --dest <dir>           Where the archive lives (implies --from-archive)
  --materialise          With --from-archive, also read iCloud-evicted files
  --no-rollup            With --from-archive, ignore the rollup cache (full re-walk)
PRICING
  --no-billing           Ignore ~/.claude/ccrepo-billing.json; estimate only
  --no-reconcile         Skip the ccusage cross-check (faster / offline)
META
  -z, --timezone <tz>    Timezone for the ccusage cross-check
  -h, --help             This summary

Totals usage from ~/.claude/projects/ logs, priced per message and reconciled
against ccusage. Cost is an API-equivalent estimate (list prices), NZD by
default, not your bill. Context med/max = median and largest per-session peak
window, never summed; --json/--csv carry the full distribution.  man ccrepo`;

function checkArgs() {
  if (has('-h') || has('--help')) { console.log(HELP); process.exit(0); }
  const badDim = keys.find((k) => !DIMS[k]);
  if (badDim) {
    console.error(`Unknown group dimension '${badDim}'. Valid: ${Object.keys(DIMS).join(', ')}, total.`);
    process.exit(2);
  }
  for (const spec of sortSpecs) {
    if (!spec) continue;
    for (const s of spec) {
      if (!SORT_KEYS.has(s.key)) {
        console.error(`Unknown --sort key '${s.key}'. Valid: ${[...SORT_KEYS].join(', ')} (+ :asc/:desc, + chains within a level).`);
        process.exit(2);
      }
      if (s.dir && s.dir !== 'asc' && s.dir !== 'desc') {
        console.error(`--sort direction must be asc or desc, got '${s.dir}'.`);
        process.exit(2);
      }
    }
  }
  if (contextRange && contextRange.error) { console.error(contextRange.error); process.exit(2); }
  if (topArg != null && !(Number.isInteger(topN) && topN > 0)) {
    console.error(`--top must be a positive integer, got '${topArg}'.`);
    process.exit(2);
  }
  if (asJson && asCsv) { console.error('--json and --csv are mutually exclusive; pick one.'); process.exit(2); }
  if (forcedRate !== null && !converted) {
    console.error('--rate has no effect on USD figures; drop it or pick a non-USD currency.');
    process.exit(2);
  }
  if (forcedRate !== null && !(forcedRate > 0)) { console.error('--rate must be a positive number.'); process.exit(2); }
}

// --- output --------------------------------------------------------------

// Short token count for the context column — full digits would make the widest
// column in the table out of a figure read at a glance. Same scale steps as
// cctranscript(1)'s, so a peak reads identically in both tools.
function fmtTokens(n) {
  if (!Number.isFinite(n) || n <= 0) return null;
  if (n >= 1e6) return `${(n / 1e6).toFixed(1)}M`;
  if (n >= 1e4) return `${Math.round(n / 1e3)}k`;
  if (n >= 1e3) return `${(n / 1e3).toFixed(1)}k`;
  return String(n);
}

function fmts(rate, currency) {
  const sym = symbolFor(currency);
  return {
    n: (x) => (x || 0).toLocaleString('en-NZ'),
    money: (usd) => sym + ((usd || 0) * rate).toLocaleString('en-NZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
    pct: (x) => x === null ? '—' : (x * 100).toFixed(1) + '%',
    // "179k/528k" — the group's typical session weight and its worst one. Both,
    // because either alone misreads (see the contextStats comment).
    ctx: (st) => st.max === null ? '—' : `${fmtTokens(st.median) || '0'}/${fmtTokens(st.max) || '0'}`,
  };
}

function metricHeads(currency, billing) {
  const h = [
    { head: 'Sessions', align: 'r' }, { head: 'Messages', align: 'r' }, { head: 'Input', align: 'r' }, { head: 'Output', align: 'r' },
    { head: 'Cache Create', align: 'r' }, { head: 'Cache Read', align: 'r' }, { head: 'Cache Hit', align: 'r' },
    { head: 'Total Tokens', align: 'r' }, { head: 'Context med/max', align: 'r' },
    { head: billing ? `Est (${currency})` : `Cost (${currency})`, align: 'r' },
  ];
  if (billing) h.push({ head: `Actual (${currency})`, align: 'r' });
  return h;
}

function printMatrix(cols, dataRows, totalRow) {
  const all = [...dataRows.map((r) => r.cells), totalRow.cells];
  const w = cols.map((c, i) => Math.max(c.head.length, ...all.map((cells) => String(cells[i] == null ? '' : cells[i]).length)));
  const pad = (s, i) => cols[i].align === 'l' ? String(s == null ? '' : s).padEnd(w[i]) : String(s == null ? '' : s).padStart(w[i]);
  const line = (l, m, r) => l + w.map((x) => '─'.repeat(x + 2)).join(m) + r;
  const rowStr = (cells) => '│ ' + cells.map((s, i) => pad(s, i)).join(' │ ') + ' │';
  const headStr = '│ ' + cols.map((c, i) => c.align === 'l' ? c.head.padEnd(w[i]) : c.head.padStart(w[i])).join(' │ ') + ' │';
  console.log();
  console.log(line('┌', '┬', '┐'));
  console.log(headStr);
  console.log(line('├', '┼', '┤'));
  dataRows.forEach((r, i) => { if (r.rule && i > 0) console.log(line('├', '┼', '┤')); console.log(rowStr(r.cells)); });
  if (dataRows.length) console.log(line('├', '┼', '┤'));
  console.log(rowStr(totalRow.cells));
  console.log(line('└', '┴', '┘'));
}

// The actual-spend-vs-estimate footnote — a peer of the ccusage line, but for
// dollars genuinely billed rather than a second cost oracle. Observable by design:
// it shows its inputs (what makes up "billed", the months in scope, the estimate)
// so the delta can be re-derived from the line, not just trusted.
function spendFootnote(sr, billing, money) {
  if (!sr.available) {
    console.log(`  Actual spend vs estimate: unavailable — ${sr.reason}.`);
    return;
  }
  const s = sr.delta >= 0 ? '+' : '−';
  const pctStr = isFinite(sr.pct) ? `${sr.pct >= 0 ? '+' : ''}${(sr.pct * 100).toFixed(2)}%` : 'n/a';
  let basis;
  if (sr.mode === 'plan') {
    basis = `${billing.name}, ${money(sr.monthlyCostUSD)}/mo × ${sr.monthsCount} mo`;
    if (sr.uncovered > 0.005) basis += ` + ${money(sr.uncovered)} uncovered per-token`;
  } else {
    const span = sr.covered.length > 1 ? `${sr.covered[0]}…${sr.covered[sr.covered.length - 1]}` : sr.covered[0];
    basis = `${sr.covered.length} invoiced period(s): ${span}`;
  }
  console.log(`  Actual spend vs estimate: ${money(sr.billed)} billed (${basis}) vs ${money(sr.estimate)} API-list-price estimate — Δ ${s}${money(Math.abs(sr.delta))} (${pctStr}) over ${sr.months.length} month(s).`);
  if (sr.mode === 'usage' && sr.gaps && sr.gaps.length) {
    console.log(`  ⚠ Actual-spend comparison partial: no billed figure for ${sr.gaps.join(', ')} (${sr.gaps.length} month(s) uncovered); delta covers ${sr.covered.length} of ${sr.months.length}.`);
  }
}

function renderHuman(root, ctx) {
  const { keys, currency, rate, converted, rateSource, billing, actualUSD, unpriced, recon, spendRecon } = ctx;
  const { n, money, pct, ctx: fctx } = fmts(rate, currency);
  const mHeads = metricHeads(currency, billing);
  const mCells = (sessions, agg, peaks) => {
    const c = [n(sessions), n(agg.messages), n(agg.inputTokens), n(agg.outputTokens), n(agg.cacheCreationTokens),
      n(agg.cacheReadTokens), pct(cacheHitRate(agg)), n(agg.totalTokens), fctx(contextStats(peaks)), money(agg.cost)];
    if (billing) c.push(money(actualUSD(agg) || 0));
    return c;
  };

  let cols, dataRows;
  if (flat && keys.length) {
    cols = [...keys.map((k) => ({ head: k, align: 'l' })), ...mHeads];
    dataRows = leafRows(root, keys, ctx.sortSpecs, ctx.top).map((lf) => {
      const pathCells = keys.map((k, i) => lf.path[i] == null ? '' : dispLabel(k, lf.path[i]));
      return { cells: [...pathCells, ...mCells(lf.sessions, lf.agg, lf.peaks)] };
    });
  } else {
    const head = keys.length ? keys.join(' › ') : 'Total';
    cols = [{ head, align: 'l' }, ...mHeads];
    dataRows = treeRows(root, keys, ctx.sortSpecs, ctx.top).map((r) => ({
      cells: ['· '.repeat(r.depth - 1) + dispLabel(keys[r.depth - 1], r.label), ...mCells(r.sessions, r.agg, r.peaks)],
      rule: r.depth === 1 && keys.length > 1,
    }));
  }
  const totalLeft = flat && keys.length ? ['TOTAL', ...Array(keys.length - 1).fill('')] : ['TOTAL'];
  const totalRow = { cells: [...totalLeft, ...mCells(root.sessions.size, root.agg, root.sessions)] };
  printMatrix(cols, dataRows, totalRow);

  // Footnotes.
  console.log(`  All amounts shown in ${currency}.`);
  if (ctx.top) {
    console.log(`  --top ${ctx.top}: showing at most ${ctx.top} row(s) per group level (post-sort); ` +
      `TOTAL still reflects the full, untruncated data.`);
  }
  if (converted) console.log(`  Rate: 1 USD = ${rate.toFixed(4)} ${currency} — ${rateSource}`);
  if (ctx.source === 'archive') {
    console.log(`  Source: ccarchive archive at ${ctx.archiveRoot} (past Claude Code's prune horizon).`);
    if (ctx.evicted) {
      console.log(`  ⚠ ${ctx.evicted} archived session file(s) skipped (evicted — bytes in iCloud, not local); ` +
        `their spend is NOT counted. Re-run with --materialise to read them (re-downloads).`);
    }
    if (ctx.rollupStats) {
      const rs = ctx.rollupStats, total = rs.hits + rs.misses;
      console.log(`  Rollup ledger: ${rs.hits}/${total} archive file(s) from cache` +
        `${rs.misses ? `, ${rs.misses} re-read (new/changed)` : ' (all warm)'} — ${rs.path}.`);
    } else if (ctx.rollupOff) {
      console.log(`  Rollup ledger bypassed (--no-rollup) — every archive file re-read.`);
    }
  }
  if (recon) {
    const d = recon;
    const s = d.delta >= 0 ? '+' : '−';
    console.log(`  Reconciled vs ccusage: ${money(d.myTot)} mine vs ${money(d.cuTot)} ccusage — Δ ${s}${money(Math.abs(d.delta))} (${d.pct >= 0 ? '+' : ''}${(d.pct * 100).toFixed(2)}%) over ${d.matched} session(s).`);
    const worst = d.models.filter((m) => Math.abs(m.pct) > 0.01 && Math.abs(m.delta) > 0.005 && isFinite(m.pct)).slice(0, 3);
    if (worst.length) console.log(`  Largest per-model Δ: ${worst.map((m) => `${m.model} ${m.pct >= 0 ? '+' : ''}${(m.pct * 100).toFixed(1)}%`).join(', ')}.`);
    if (d.myOnly || d.cuOnly) console.log(`  ${d.myOnly} session(s) only in logs, ${d.cuOnly} only in ccusage (scope/pruning differences).`);
  } else if (ctx.source === 'archive') {
    console.log(`  ccusage cross-check off in archive mode — ccusage reads the live store, which no longer holds the pruned sessions.`);
  } else if (!noReconcile) {
    console.log(`  Reconciliation skipped — ccusage unavailable (cost is unchecked against it).`);
  }
  if (unpriced && unpriced.size) {
    // Two gaps, two fixes — say which, because "add to the price table" is wrong
    // advice for a model that is already in it.
    const say = (r) => [...unpriced].filter(([, v]) => v.reason === r).map(([m, v]) => `${m} (${v.messages} msgs)`);
    const noModel = say('model'), noDate = say('date');
    if (noModel.length) console.log(`  ⚠ Unpriced model(s): ${noModel.join(', ')} — counted at $0; add to the price table.`);
    if (noDate.length) console.log(`  ⚠ Priced model(s) with uncovered dates: ${noDate.join(', ')} — counted at $0; widen an interval to cover them.`);
  }
  if (billing) {
    const covers = billing.covers.length ? billing.covers.join(', ') : '(none listed)';
    const basisLabel = billing.basis === 'covered' ? 'covered-token share' : 'total-token share (no covered-model usage in range)';
    console.log(`  Est is the API-equivalent estimate; Actual applies your plan: ${billing.name}, ${money(billing.monthlyCostUSD)}/mo covering ${covers}.`);
    console.log(`  Covered-model tokens cost $0 marginal; the flat plan fee is apportioned by ${basisLabel}, plus any uncovered per-token spend.`);
    console.log(`  Plan fee shown is one month; over a multi-month range true outlay is (months × fee).`);
    if (spendRecon) spendFootnote(spendRecon, billing, money);
    if (billing.caveat) console.log(`  Note: ${billing.caveat}.`);
  } else {
    console.log(`  Cost is an API-equivalent estimate (list prices), not your subscription bill.`);
  }
  console.log(`  Cache Hit = cache reads ÷ (input + cache create + cache read).`);
  console.log(`  Context med/max = median and largest per-session peak window (input + cache create + cache read at one request); never summed — every message carries the whole cached prefix.`);
  console.log(`  Context has no % — the logs record the model but not its window size (200k vs 1M variants log identically), so a share-of-window figure would be a guess. --json carries the full distribution.`);
  console.log(`  Sessions is a distinct count at every level; Messages counts (deduped) assistant messages. Branch/kind/version are attributed per message.`);
  if (ctx.unmatchedNote) console.log(`  ${ctx.unmatchedNote}`);
  console.log();
}

// One row's metrics for --json/--csv. Deliberately WIDER than the table: the
// terminal is width-bound and a data file isn't, so everything computed that a
// consumer could want ships here even when no column fits it — the whole context
// distribution (the table shows two of its seven figures), and, under a billing
// config, the covered/uncovered split the Actual figure is derived from, so the
// apportionment can be re-derived rather than taken on trust.
//
// Flat keys, not nested objects: the design's tidy-shape promise (one record per
// leaf, straight into jq/pandas/sqlite) is what makes --csv a free by-product of
// the same builder. A `context` sub-object would break that for no gain.
function metricObj(agg, sessions, ctx, peaks) {
  const round2 = (x) => Math.round((x || 0) * 100) / 100;
  const cs = contextStats(peaks || new Map());
  const tok = (x) => x === null ? null : Math.round(x);
  const o = {
    sessions, messages: agg.messages,
    inputTokens: agg.inputTokens, outputTokens: agg.outputTokens,
    cacheCreationTokens: agg.cacheCreationTokens, cacheReadTokens: agg.cacheReadTokens,
    cacheHitRate: cacheHitRate(agg), totalTokens: agg.totalTokens,
    // Per-session peak windows. contextSessions can be < sessions when a slice
    // holds messages with no usage record — stated, not silently folded in.
    contextSessions: cs.sessions,
    contextMin: tok(cs.min), contextP25: tok(cs.p25), contextMedian: tok(cs.median),
    contextP75: tok(cs.p75), contextP90: tok(cs.p90), contextMax: tok(cs.max),
    contextMean: tok(cs.mean),
    cost: round2(agg.cost * ctx.rate),
  };
  if (ctx.billing) {
    o.actual = round2((ctx.actualUSD(agg) || 0) * ctx.rate);
    // The two inputs behind `actual`: tokens on plan-covered models (which cost
    // $0 marginal and set the apportionment basis) and the per-token spend on
    // models the plan doesn't cover (which is added on top, not apportioned).
    o.coveredTokens = agg.coveredTokens || 0;
    o.uncoveredCost = round2((agg.uncoveredCost || 0) * ctx.rate);
  }
  return o;
}

function buildMeta(ctx) {
  const filters = {};
  for (const [dim, v] of Object.entries(ctx.filterSpecs)) filters[dim] = v;
  if (ctx.since || ctx.until) filters.date = { since: ctx.since || null, until: ctx.until || null };
  if (ctx.contextArg != null) filters.context = ctx.contextArg;    // session-peak spec, verbatim
  return {
    currency: ctx.currency,
    rate: ctx.converted ? ctx.rate : null,
    rateSource: ctx.rateSource,
    source: ctx.source,
    archiveRoot: ctx.archiveRoot || null,
    evicted: ctx.source === 'archive' ? ctx.evicted : null,
    rollup: ctx.rollupStats ? { hits: ctx.rollupStats.hits, misses: ctx.rollupStats.misses } : null,
    group: ctx.keys,
    top: ctx.top || null,     // per-level row cap after sorting; TOTAL always covers everything
    filters,
    range: ctx.range,
    billing: ctx.billing || null,
    reconciliation: ctx.recon ? {
      mine: Math.round(ctx.recon.myTot * 100) / 100,
      ccusage: Math.round(ctx.recon.cuTot * 100) / 100,
      delta: Math.round(ctx.recon.delta * 100) / 100,
      deltaPct: Math.round(ctx.recon.pct * 10000) / 100,
      sessions: ctx.recon.matched,
      basis: 'USD',
    } : null,
    spendReconciliation: spendMeta(ctx),
    unpriced: ctx.unpriced ? [...ctx.unpriced].map(([m, v]) => ({ model: m, messages: v.messages, reason: v.reason })) : [],
  };
}

// Machine-readable form of the actual-spend footnote (display currency). Carries
// the same inputs the human footnote shows, so a script can re-derive the delta.
function spendMeta(ctx) {
  const sr = ctx.spendRecon;
  if (!sr) return null;
  const r2 = (x) => Math.round((x || 0) * ctx.rate * 100) / 100;
  if (!sr.available) return { mode: sr.mode, available: false, reason: sr.reason, months: sr.months };
  return {
    mode: sr.mode, available: true,
    billed: r2(sr.billed), estimate: r2(sr.estimate), delta: r2(sr.delta),
    deltaPct: isFinite(sr.pct) ? Math.round(sr.pct * 10000) / 100 : null,
    months: sr.months,
    ...(sr.mode === 'plan'
      ? { monthlyCost: r2(sr.monthlyCostUSD), monthsCount: sr.monthsCount, uncovered: r2(sr.uncovered) }
      : { covered: sr.covered, gaps: sr.gaps }),
  };
}

function outputJson(root, ctx) {
  const rows = leafRows(root, ctx.keys, ctx.sortSpecs, ctx.top).map((lf) => {
    const o = {};
    ctx.keys.forEach((k, i) => { o[k] = lf.path[i]; });
    Object.assign(o, metricObj(lf.agg, lf.sessions, ctx, lf.peaks));
    return o;
  });
  // The grand total as its own record, not a row: --json promises one record per
  // leaf with no subtotals mixed in (a machine re-aggregates), but the whole-set
  // context distribution can't be re-aggregated from leaves — peaks-of-peaks
  // don't recompose once sessions are split across groups. So it ships in meta.
  const total = metricObj(root.agg, root.sessions.size, ctx, root.sessions);
  console.log(JSON.stringify({ meta: { ...buildMeta(ctx), total }, rows }, null, 2));
}

function outputCsv(root, ctx) {
  const metricCols = ['sessions', 'messages', 'inputTokens', 'outputTokens', 'cacheCreationTokens',
    'cacheReadTokens', 'cacheHitRate', 'totalTokens',
    'contextSessions', 'contextMin', 'contextP25', 'contextMedian', 'contextP75', 'contextP90', 'contextMax', 'contextMean',
    'cost', ...(ctx.billing ? ['actual', 'coveredTokens', 'uncoveredCost'] : [])];
  const header = [...ctx.keys, ...metricCols];
  const esc = (v) => {
    const s = v == null ? '' : String(v);
    return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
  };
  const lines = [header.map(esc).join(',')];
  for (const lf of leafRows(root, ctx.keys, ctx.sortSpecs, ctx.top)) {
    const m = metricObj(lf.agg, lf.sessions, ctx, lf.peaks);
    const row = [...ctx.keys.map((_, i) => lf.path[i]), ...metricCols.map((k) => m[k])];
    lines.push(row.map(esc).join(','));
  }
  console.log(lines.join('\n'));
}

// --- main ----------------------------------------------------------------

async function main() {
  checkArgs();
  const billing = noBilling ? null : loadBilling();
  const covers = coversPredicate(billing);
  const pricing = loadPricing();

  // The rollup ledger is a --from-archive-only speed layer: the live logs are a
  // small, ever-changing window that re-reads cheaply and still runs the ccusage
  // cross-check, so there's nothing to precompute there. Transparent by default
  // (auto-used when present, self-invalidating on new files or a recipe change),
  // bypassed with --no-rollup for a from-scratch re-walk.
  const rollup = (fromArchive && !noRollup)
    ? { path: rollupFile(), sig: recipeSig(pricing, billing ? { covers: billing.plan.covers, perTokenModels: billing.perTokenModels } : null) }
    : null;
  const { events, unpriced, evicted, rollup: rollupStats } = readAllEvents(covers, pricing, rollup);

  const dimFilter = buildDimFilter(filterSpecs);
  const dayNum = (ts) => timeBucket(ts, 'day').replace(/-/g, '');
  const dateOk = (e) => {
    if (!since && !until) return true;
    const d = dayNum(e.ts);
    if (d === 'unknown') return false;
    if (since && d < since) return false;
    if (until && d > until) return false;
    return true;
  };
  const reconEvents = events.filter(dateOk);            // ccusage-comparable scope

  // --context is session-grain: peaks are computed once over reconEvents (the
  // date-scoped set, same scope --since/--until already bound), THEN a session
  // qualifies or not as a whole — never a per-message test, and never scoped by
  // the OTHER filters (a --kind main run still judges a session by its real,
  // whole peak). See buildContextFilter's comment and ccrepo.design.md §4.
  const contextPeaks = contextArg != null ? sessionPeaks(reconEvents) : null;
  const contextFilter = buildContextFilter(contextRange, contextPeaks);
  const dispEvents = reconEvents.filter((e) => dimFilter(e) && contextFilter(e)); // fully filtered for display

  // FX rate.
  let rate = 1, rateSource = 'native', usdRates = null;
  if (converted) {
    if (forcedRate !== null) { rate = forcedRate; rateSource = 'manual'; }
    else {
      usdRates = await fetchUsdRates();
      const r = usdRates && usdRates[currency];
      if (!r) {
        console.error(`Couldn't fetch USD→${currency} rate (offline?). Pass --rate <n> to force one, or --fx usd.`);
        process.exit(1);
      }
      rate = r; rateSource = 'live (open.er-api.com)';
    }
  }

  // Plan fee and any invoiced spend figures in USD (folded in USD; the display
  // rate applies uniformly at the end). The plan fee and spend.periods amounts are
  // both quoted in billing.currency, so they share one conversion.
  let monthlyCostUSD = 0, planCaveat = null;
  const periodsUSD = {};
  if (billing) {
    let toUSD = (x) => x;
    if (billing.currency !== 'USD') {
      if (!usdRates) usdRates = await fetchUsdRates();
      const pr = usdRates && usdRates[billing.currency];
      if (pr) toUSD = (x) => x / pr;
      else planCaveat = `plan/spend cost read as USD — couldn't fetch USD→${billing.currency} rate`;
    }
    monthlyCostUSD = toUSD(billing.plan.monthlyCost);
    for (const [m, amt] of Object.entries(billing.spend.periods)) periodsUSD[m] = toUSD(amt);
  }
  const totalCovered = dispEvents.reduce((s, e) => s + (e.coveredTokens || 0), 0);
  const totalAllTokens = dispEvents.reduce((s, e) => s + (e.totalTokens || 0), 0);
  const actualParams = { monthlyCostUSD, totalCovered, totalAllTokens };
  const actualUSD = (agg) => (billing ? actualFor(agg, actualParams) : null);

  const root = groupTree(dispEvents, keys);

  // Reconcile over the date-comparable scope (ccusage can't honour the other
  // filters, so comparing the fully-filtered set would be apples-to-oranges).
  // Off in archive mode: ccusage reads the live store, which no longer holds the
  // pruned sessions the archive is here to surface — the comparison would be
  // structurally short, not a real drift.
  let recon = null;
  if (!noReconcile && !fromArchive) {
    const passthrough = [];
    if (since) passthrough.push('--since', since);
    if (until) passthrough.push('--until', until);
    if (tz) passthrough.push('-z', tz);
    recon = reconcile(reconEvents, runCcusage(passthrough));
  }

  const days = dispEvents.map((e) => timeBucket(e.ts, 'day')).filter((d) => d !== 'unknown').sort();
  const range = days.length ? [days[0], days[days.length - 1]] : [null, null];

  // Actual-spend-vs-estimate reconciliation, over the date-comparable scope (like
  // the ccusage cross-check — the plan fee is global, not per-repo/model).
  const spendRecon = billing
    ? reconcileSpend(reconEvents, billing.spend, { monthlyCostUSD, planName: billing.plan.name, periodsUSD })
    : null;

  const billingView = billing ? {
    name: billing.plan.name, covers: billing.plan.covers,
    monthlyCostUSD,                     // in USD; money() converts once at render
    basis: totalCovered > 0 ? 'covered' : 'total', caveat: planCaveat,
  } : null;

  const ctx = {
    keys, sortSpecs, top: topN, currency, rate, converted, rateSource,
    billing: billingView, actualUSD, unpriced, recon, spendRecon, filterSpecs, contextArg, since, until, range,
    source: fromArchive ? 'archive' : 'live', archiveRoot: fromArchive ? archiveRoot() : null,
    evicted, materialise, rollupStats, rollupOff: fromArchive && noRollup,
  };

  if (asJson) return outputJson(root, ctx);
  if (asCsv) return outputCsv(root, ctx);
  renderHuman(root, ctx);
}

if (require.main === module) {
  main().catch((e) => { console.error(e && e.stack || String(e)); process.exit(1); });
}

module.exports = {
  symbolFor, shortModel, timeBucket, isoWeek,
  PRICING, priceBase, priceEntry, baseAt, messageCost, loadPricing,
  zeroAgg, addTo, cacheHitRate, label,
  quantile, contextStats, bumpPeak, fmtTokens,
  parseContextAmount, parseContextRange, sessionPeaks, buildContextFilter,
  DIMS, TIME_DIMS, globMatch, buildDimFilter,
  groupTree, sortedEntries, topEntries, treeRows, leafRows,
  parseSortLevel, parseSort,
  eventFrom, keepRicher, readAllEvents, reconcile,
  loadBilling, coversPredicate, actualFor, normaliseSpend, reconcileSpend,
  defaultArchiveDest, readLogText, isDatalessFlags,
  loadRollup, saveRollup, recipeSig, fileFingerprint, stableStringify,
};
