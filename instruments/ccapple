def psi_uuid(uuid_0: int, uuid_1: int) -> str:
    """psi.sqlite's two signed 64-bit halves -> the asset UUID string. The 16 bytes
    are little-endian (measured: ZASSET.ZUUID matches this and not big-endian)."""
    return str(_uuid.UUID(bytes=struct.pack("<qq", uuid_0, uuid_1))).upper()


def psi_search_uuids(psi_path: str, text: str) -> set:
    """UUIDs of assets whose recognised text or caption contains EVERY word of
    `text` (substring, case- and accent-insensitive; psi stores folded strings)."""
    words = fold(text).split()
    if not words:
        raise UsageError("--text is empty")
    cats = ",".join(str(c) for c in PSI_TEXT_CATEGORIES)  # integers from our own constant
    con = open_ro(psi_path)
    try:
        found: Optional[set] = None
        for w in words:
            pat = "%" + w.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%"
            hit = {psi_uuid(a, b) for a, b in con.execute(
                "SELECT DISTINCT a.uuid_0, a.uuid_1 FROM groups g JOIN ga ON ga.groupid=g.rowid "
                "JOIN assets a ON a.rowid=ga.assetid WHERE g.category IN (%s) AND g.normalized_string LIKE ? ESCAPE '\\'" % cats,
                (pat,))}
            found = hit if found is None else found & hit
            if not found:
                break
        return found or set()
    finally:
        con.close()


def parse_near(text: str):
    """'LAT,LON' or 'LAT,LON,KM' -> (lat, lon, km)."""
    try:
        parts = [float(x) for x in text.split(",")]
    except ValueError:
        raise UsageError("bad --near %r (want LAT,LON or LAT,LON,KM)" % text) from None
    if len(parts) == 2:
        parts.append(NEAR_DEFAULT_KM)
    if len(parts) != 3:
        raise UsageError("bad --near %r (want LAT,LON or LAT,LON,KM)" % text)
    lat, lon, km = parts
    if not (-90 <= lat <= 90 and -180 <= lon <= 180 and km > 0):
        raise UsageError("bad --near %r (latitude -90..90, longitude -180..180, KM above 0)" % text)
    return lat, lon, km


def haversine_km(lat1, lon1, lat2, lon2) -> float:
    p1, p2 = math.radians(lat1), math.radians(lat2)
    a = math.sin((p2 - p1) / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(math.radians(lon2 - lon1) / 2) ** 2
    return 6371.0088 * 2 * math.asin(min(1.0, math.sqrt(a)))


def _has_gps(lat, lon) -> bool:
    return (lat is not None and lon is not None and lat != NO_LOCATION and lon != NO_LOCATION
            and -90 <= lat <= 90 and -180 <= lon <= 180)


def _photo_ents(con: sqlite3.Connection) -> Dict[str, int]:
    """Entity numbers for Asset and Album, by name (they move between macOS versions)."""
    ents = {r[0]: int(r[1]) for r in con.execute("SELECT Z_NAME, Z_ENT FROM Z_PRIMARYKEY WHERE Z_NAME IN ('Asset','Album')")}
    if len(ents) != 2:
        raise sqlite3.OperationalError("Photos entity table not as expected (no Asset/Album in Z_PRIMARYKEY)")
    return ents


def best_viewable(library: str, uuid: str) -> Optional[str]:
    """The largest image among an asset's derivatives, or None."""
    d = uuid[:1].upper()
    root = os.path.join(library, "resources", "derivatives")
    found: List[str] = []
    for pat in (os.path.join(glob.escape(root), d, glob.escape(uuid) + "*"),
                os.path.join(glob.escape(root), "masters", d, glob.escape(uuid) + "*"),
                os.path.join(glob.escape(root), "cvt", d, glob.escape(uuid), "*")):
        found.extend(f for f in glob.glob(pat) if f.lower().endswith(IMAGE_SUFFIXES))
    best, best_size = None, -1
    for f in found:
        try:
            size = os.path.getsize(f)
        except OSError:
            continue
        if size > best_size:
            best, best_size = f, size
    return best


def search_photos(path, text=None, since=None, until=None, near=None, album=None, uuid=None,
                  include_deleted=False, limit=DEFAULT_LIMIT, psi_path=None, library=None) -> List[dict]:
    """Photos assets matching ALL the filters given, newest first.

    `path` is Photos.sqlite; the search index and the files are found beside it
    (<library>/database/search/psi.sqlite, <library>/originals, <library>/resources)
    unless `psi_path` / `library` say otherwise. Paths come back as plain strings:
    nothing is converted, copied or opened here."""
    if not any((text, since, until, near, album, uuid)):
        raise UsageError("photos needs at least one of --text, --since, --until, --near, --album, --uuid")
    library = library or os.path.dirname(os.path.dirname(os.path.abspath(path)))
    psi_path = psi_path or os.path.join(os.path.dirname(os.path.abspath(path)), "search", "psi.sqlite")
    lo = datetime_to_apple(parse_day(since)) if since else None
    hi = datetime_to_apple(parse_day(until, end_of_day=True)) if until else None
    centre = parse_near(near) if near else None
    wanted = psi_search_uuids(psi_path, text) if text else None
    if wanted is not None and not wanted:
        return []
    want_uuid = uuid.strip("{} ").upper() if uuid else None
    con = open_ro(path)
    try:
        sql = ("SELECT a.Z_PK AS pk, a.ZUUID AS uuid, a.ZDATECREATED AS created, a.ZDIRECTORY AS dir, a.ZFILENAME AS stored, "
               "a.ZLATITUDE AS lat, a.ZLONGITUDE AS lon, a.ZTRASHEDSTATE AS trashed, x.ZORIGINALFILENAME AS filename "
               "FROM ZASSET a LEFT JOIN ZADDITIONALASSETATTRIBUTES x ON x.ZASSET=a.Z_PK WHERE 1=1")
        args: list = []
        if not include_deleted:
            sql += " AND COALESCE(a.ZTRASHEDSTATE,0)=0"
        if want_uuid:
            sql += " AND a.ZUUID=?"
            args.append(want_uuid)
        if lo is not None:
            sql += " AND a.ZDATECREATED >= ?"
            args.append(lo)
        if hi is not None:
            sql += " AND a.ZDATECREATED < ?"
            args.append(hi)
        if centre:
            lat, lon, km = centre
            dlat = km / 111.0
            dlon = km / (111.0 * max(math.cos(math.radians(lat)), 0.01))
            sql += " AND a.ZLATITUDE BETWEEN ? AND ? AND a.ZLONGITUDE BETWEEN ? AND ?"
            args += [lat - dlat, lat + dlat, lon - dlon, lon + dlon]
        if album:
            ents = _photo_ents(con)
            n_album = fold(album)
            pks = [r["Z_PK"] for r in con.execute(
                "SELECT Z_PK, ZTITLE FROM ZGENERICALBUM WHERE Z_ENT=? AND COALESCE(ZTRASHEDSTATE,0)=0", (ents["Album"],))
                if r["ZTITLE"] and n_album in fold(r["ZTITLE"])]
            if not pks:
                return []
            sql += (" AND a.Z_PK IN (SELECT j.Z_%dASSETS FROM Z_%dASSETS j WHERE j.Z_%dALBUMS IN (%s))"
                    % (ents["Asset"], ents["Album"], ents["Album"], ",".join("?" * len(pks))))
            args += pks
        sql += " ORDER BY a.ZDATECREATED DESC"
        rows: List[dict] = []
        for r in con.execute(sql, args):
            if wanted is not None and r["uuid"] not in wanted:
                continue
            gps = _has_gps(r["lat"], r["lon"])
            dist = None
            if centre:
                if not gps:
                    continue
                dist = haversine_km(centre[0], centre[1], r["lat"], r["lon"])
                if dist > centre[2]:
                    continue
            original = os.path.join(library, "originals", r["dir"], r["stored"]) if r["dir"] and r["stored"] else None
            on_disk = bool(original) and os.path.isfile(original)
            viewable, kind = (original, "original") if on_disk else (best_viewable(library, r["uuid"]), "derivative")
            row = {
                "uuid": r["uuid"],
                "date": fmt_when(r["created"]),
                "filename": r["filename"] or r["stored"],
                "original_on_disk": on_disk,
                "viewable_path": viewable,
                "viewable_kind": kind if viewable else None,
                "gps": {"lat": round(r["lat"], 6), "lon": round(r["lon"], 6)} if gps else None,
                "deleted": bool(r["trashed"]),
            }
            if dist is not None:
                row["distance_km"] = round(dist, 3)
            rows.append(row)
            if len(rows) >= limit:
                break
        return rows
    finally:
        con.close()


def photos_extra_counts(path) -> Dict[str, Optional[int]]:
    """Counts that need the filesystem or the second database: originals present
    on disk, and assets in the search index. Numbers only."""
    library = os.path.dirname(os.path.dirname(os.path.abspath(path)))
    out: Dict[str, Optional[int]] = {"originals_on_disk": None, "indexed_assets": None}
    try:
        con = open_ro(path)
        try:
            out["originals_on_disk"] = sum(
                1 for d, f in con.execute("SELECT ZDIRECTORY, ZFILENAME FROM ZASSET WHERE COALESCE(ZTRASHEDSTATE,0)=0")
                if d and f and os.path.isfile(os.path.join(library, "originals", d, f)))
        finally:
            con.close()
    except sqlite3.Error:
        pass
    try:
        con = open_ro(os.path.join(os.path.dirname(os.path.abspath(path)), "search", "psi.sqlite"))
        try:
            out["indexed_assets"] = _count(con, "SELECT COUNT(*) FROM assets")
        finally:
            con.close()
    except sqlite3.Error:
        pass
    return out


