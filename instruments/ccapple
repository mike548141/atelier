def status(overrides: Optional[Dict[str, Sequence[str]]] = None) -> List[dict]:
    """Per store: path, whether it opens read-only, row counts. No content."""
    overrides = overrides or {}
    report: List[dict] = []
    for app in ("contacts", "messages", "calendar", "reminders", "notes", "photos", "home"):
        paths = resolve_paths(app, overrides.get(app))
        if not paths:
            report.append({"app": app, "path": None, "opens_read_only": False, "error": "store not found", "counts": {}})
        for path in paths:
            entry = {"app": app, "path": path, "opens_read_only": False, "counts": {}}
            try:
                con = open_ro(path)
                try:
                    con.execute("SELECT 1 FROM sqlite_master LIMIT 1").fetchone()
                    entry["opens_read_only"] = True
                    entry["counts"] = {k: _count(con, q) for k, q in STATUS_COUNTS[app].items()}
                    if app == "photos":
                        entry["counts"].update(photos_extra_counts(path))
                finally:
                    con.close()
            except sqlite3.Error as exc:
                entry["error"] = str(exc)
            report.append(entry)
    return report


