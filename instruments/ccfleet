def check_settings(cfg):
    """Say what a session's settings are: the user-level grants left out, what
    is kept from that file, and each kept hook (a guard, or a grant if it
    approves calls in a script ccfleet cannot read)."""
    try:
        settings, notes = session_settings(cfg)
    except Refusal as e:
        print(f"GRANT: REFUSED. {e}")
        return
    upath = user_settings_path()
    left = "; ".join(notes["grants"]) or "nothing (it grants nothing)"
    perms = settings.get("permissions") if isinstance(settings.get("permissions"), dict) else {}
    kept = [f"{k} {len(perms[k])} rule(s)" for k in ("deny", "ask") if isinstance(perms.get(k), list)]
    kept += [f"{len(notes['kept_hooks'])} hook command(s)"]
    kept += [k for k in sorted(settings) if k not in ("permissions", "hooks")]
    print(f"GRANT: the config is the whole grant. No user-level settings load (--setting-sources "
          f"{SETTING_SOURCES}); a session gets {upath} less its grants, with the config's `settings` on "
          f"top. Left out: {left}. Kept: {', '.join(kept)}.")
    for k in sorted(set(settings) & set(WIDENING_KEPT)):
        print(f"WIDENS: {k} is kept: {WIDENING_KEPT[k]}. Override it in the config's `settings` to narrow it "
              f"(man ccfleet, THREATS).")
    user = read_settings(upath, required=False) or {}
    for k in sorted(set(user) - set(WIDENING_KEPT) - NARROW_KEPT):
        print(f"KEPT, not classified: {k}. ccfleet does not know whether it widens what a session may do; "
              f"override it in the config's `settings` if it might (man ccfleet, THREATS).")
    print("MANAGED: managed (policy) settings always load and can widen the grant; ccfleet does not read "
          "them (man ccfleet, THREATS).")
    for h in notes["dropped_hooks"]:
        print(f"HOOK dropped: {h}")
    for h in notes["kept_hooks"]:
        print(f"HOOK kept: {h}")
    if notes["kept_hooks"]:
        print("HOOKS: a kept hook runs with its full power; one whose script answers allow still grants "
              "(ccfleet reads only the command line). Name it in drop_hooks to leave it out.")
    umd = user_instructions_path()
    if os.path.isfile(umd):
        try:
            _, _, found, inline = read_instructions("PRIVATE")
        except OSError as e:
            found, inline = [("?", umd, f"cannot be read ({e.strerror})")], []
        print(f"INSTRUCTIONS: {umd} is appended to every session's system prompt (no user source loads it). "
              f"A private repo's session gets it with each @-import on a line of its own inlined; a "
              f"public or unknown-visibility repo's gets it with each import line withheld (a note that names no "
              f"path), each import inside a line of text withheld too, no imported file, and a deny rule "
              f"for Read of each file listed here. "
              + (f"Imports found: {len(found) + len(inline)}." if found or inline else "It imports nothing."))
        # Each line says what each visibility's session gets (DP18).
        for raw, target, what in found + inline:
            print(f"INSTRUCTIONS IMPORT: @{raw} -> {target}: {what} for a private repo's session; withheld, "
                  f"and Read of it denied, for a public or unknown one's")
    else:
        print(f"INSTRUCTIONS: no {umd}; nothing is appended.")
    hits = instruction_hits(cfg, "UNKNOWN")
    if hits:
        then = ("a public or unknown-visibility repo's launch is refused (instructions_guard refuse)"
                if cfg.get("instructions_guard", "refuse") == "refuse" else
                "it is appended to a public or unknown-visibility repo's session anyway, with a line per name "
                "at launch (instructions_guard warn)")
        print(f"INSTRUCTIONS GUARD: it names private name(s) {', '.join(hits)}: {then}.")
    print("REPO SETTINGS: a repo's own .claude/settings.json and .claude/settings.local.json still load, "
          "with its CLAUDE.md; each launch prints a WIDENED line for what they grant (man ccfleet, THREATS).")


def forge_slug(cfg, repo):
    """The repo's OWNER/NAME on the forge: its `github`, else its primary
    checkout's origin when that is a github.com remote; None otherwise."""
    rc = cfg["repos"].get(repo, {})
    if rc.get("github"):
        return rc["github"]
    primary = os.path.join(cfg["repos_root"], repo)
    if not os.path.isdir(primary):
        return None
    remote = git("remote", "get-url", "origin", cwd=primary, check=False)
    m = re.search(r"github\.com[:/](.+?)(?:\.git)?$", remote or "")
    return m.group(1) if m else None


def check_visibility(cfg):
    """Where gh is on the path, each repo whose config states its visibility
    is compared with the forge's answer: the config's wins at launch, so a repo
    made public and still marked private would get the private imports
    (PK20). A mismatch is a warning line; a repo the forge does not answer
    for is said."""
    if not shutil.which("gh"):
        print("VISIBILITY: gh is not on the path; the configured visibility is not compared with the forge")
        return
    for repo in sorted(cfg["repos"]):
        stated = str(cfg["repos"][repo].get("visibility") or "").upper()
        slug = forge_slug(cfg, repo) if stated else None
        if not slug:
            continue
        try:
            r = subprocess.run(["gh", "repo", "view", slug, "--json", "visibility", "-q", ".visibility"],
                               capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
            forge = r.stdout.strip().upper() if r.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired):
            forge = ""
        if not forge:
            print(f"VISIBILITY: {repo}: the forge did not answer for {slug}; the config's {stated} stands")
        elif forge != stated:
            print(f"VISIBILITY MISMATCH: {repo} is {stated} in the config and {forge} on the forge ({slug}); "
                  f"the config's wins at launch, so fix it (man ccfleet, THREATS)")


def check_queue_route(cfg):
    """Say when the config's queue.next names no route (DP7). ccfleet passes
    none itself: the route a drain takes is whatever queue.next's own
    arguments say (the example passes --route local), else the queue's own
    default."""
    nxt = (cfg.get("queue") or {}).get("next")
    if nxt and not any("route" in str(a).lower() for a in nxt):
        print("QUEUE ROUTE: queue.next names no route. ccfleet passes none itself, so which route a drain "
              "takes is your queue's own default; every pass ccfleet starts is a local session. Pass it "
              "in queue.next (the example: --route local).")


def check(cfg, prompts, sets):
    """Print what the config resolves to, any permission widening, and the
    placeholders in the pass prompt (and each --prompt) that nothing fills.
    Returns 5 when a template has one, else 0."""
    print(json.dumps({k: v for k, v in cfg.items() if k not in ("vars", "env")}, indent=1))
    print(f"vars: {', '.join(sorted(cfg['vars'])) or 'none'}; env: {', '.join(sorted(cfg['env'])) or 'none'} "
          f"(+ {CEILING_VAR}=0); reset reached: {reset_reached(cfg)}")
    perms, bypass = permission_args(cfg)
    if bypass:
        print(f"PERMISSIONS: BYPASS. Every session starts with {'; '.join(perms)}: no tool call is asked "
              f"about, unattended, with your git and gh credentials. Anything that steers a session (a "
              f"repo's instruction files, a pull request's text, a CI log; man ccfleet, THREATS) acts "
              f"unchecked. Use the narrowest mode that does the work.")
    elif perms:
        print(f"PERMISSIONS: every session starts with {'; '.join(perms)} (see man ccfleet, THREATS)")
    else:
        print("NO GRANT: neither claude_args nor the config's settings set a permission mode or an allow "
              "rule, so a session runs in the default mode, where nobody is there to ask: every call that "
              "would ask (an edit, most shell commands) is refused. Grant the narrowest that does the work, "
              "or confirm the sessions need only what the default allows (a repo's own settings aside).")
    check_settings(cfg)
    check_visibility(cfg)
    check_queue_route(cfg)
    have = set(cfg["vars"]) | set(sets)
    # What fills a template depends on the command that launches it: `pass`
    # fills {ITEM} {BRIEF} {REVIEW_LOG}, and only ever for pass_prompt; a
    # resume (with --item) and a fold (run --in WT --item ITEM) fill {ITEM}
    # and {REVIEW_LOG}; a plain run fills neither.
    pass_prompt = expand(cfg["pass_prompt"]) if cfg.get("pass_prompt") else None
    templates = ([(cfg["pass_prompt"], PASS_FILLED)] if pass_prompt else []) + \
                [(t, PASS_FILLED if expand(t) == pass_prompt else set()) for t in prompts]
    unset_any = False
    for path, filled_here in templates:
        try:
            text = read_template(path)
        except OSError as e:
            print(f"PROMPT {path}: cannot read it ({e.strerror or e})")
            unset_any = True
            continue
        names = set(PLACEHOLDER.findall(text))
        later = sorted((names & RESUME_FILLED) - filled_here - have)
        unset = sorted(names - ALWAYS_FILLED - filled_here - have - set(later))
        line = f"PROMPT {path}: {len(names)} placeholder(s)"
        if later:
            line += (f"; filled only by resume --item or a fold (run --in WT --item ITEM): "
                     f"{' '.join('{' + n + '}' for n in later)} (set them for any other launch)")
        if unset:
            unset_any = True
            line += (f"; UNSET: {' '.join('{' + n + '}' for n in unset)} (set them in the config's vars, "
                     f"or per job as KEY=VALUE or --set; a launch refuses them with exit 5)")
        print(line)
    return EXIT_GUARD if unset_any else 0


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="ccfleet", formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Run headless Claude Code sessions across a fleet of repos, each started inside a\n"
                    "worktree named for its repo (so per-repo cost tools bill that repo), and only\n"
                    "while the machine has headroom.",
        epilog="Every estate value (repos, tiers, queue, reset time) comes from a JSON config:\n"
               "--config PATH or $CCFLEET_CONFIG. `run`, `drive`, `drain`, `pass` and `resume`\n"
               "start real sessions; --dry-run prints the launch instead; `plan` only reads. One driver (drive or\n"
               "drain) per kit_dir; a jobs file's labels must not repeat.\n"
               "Exit: 0 ran, 1 setup failed (or not ranked), 2 claim or release refused,\n"
               "3 reset reached, 4 queue empty, 5 private name or unfilled placeholder, 64 usage.\n"
               "Needs Python 3.8+ (tested on 3.9, 3.14), git, nice, ps; memory_pressure on macOS.\n"
               "Full manual: man ccfleet")
    ap.add_argument("--config", metavar="PATH", help="the JSON config (else $CCFLEET_CONFIG)")
    ap.add_argument("--by", metavar="ID", default=os.environ.get("CCFLEET_BY", "unknown"),
                    help="the orchestrating session's id, filled into prompts as {BY}")
    ap.add_argument("--doc", action="store_true", help="print the long reference text and exit")
    sub = ap.add_subparsers(dest="cmd", metavar="COMMAND")
    p = sub.add_parser("check", help="validate the config; name unset placeholders")
    p.add_argument("--prompt", action="append", default=[], metavar="FILE",
                   help="also check this template's placeholders (repeatable)")
    p.add_argument("--set", action="append", default=[], metavar="K=V", help="a value a job will supply")
    sub.add_parser("gate", help="print the headroom reading; exit 0 if a start may go now")
    p = sub.add_parser("run", help="one headless session for REPO in a fresh worktree")
    p.add_argument("repo"); p.add_argument("--prompt", required=True, metavar="FILE", help="prompt template")
    p.add_argument("--label", help="names the worktree, log and result file")
    p.add_argument("--model", help="the model (else job MODEL=, repo model, default_model)")
    p.add_argument("--set", action="append", default=[], metavar="K=V", help="fill {K} in the template")
    p.add_argument("--keep", action="store_true", help="keep the worktree afterwards")
    p.add_argument("--in", dest="existing", metavar="WT", help="adopt an existing worktree (kept)")
    p.add_argument("--item", help="with --in (a fold): on a clean end release ITEM's claim and remove WT")
    p.add_argument("--dry-run", action="store_true", help="print the launch, start nothing")
    p = sub.add_parser("drive", help="run a jobs file under the headroom gate")
    p.add_argument("jobs", help="TSV: repo, label (unique), prompt, then KEY=VALUE fields")
    p.add_argument("--max", type=int, help="most jobs at once (else config max_concurrent)")
    p.add_argument("--serial-per-repo", action="store_true", help="never two jobs of one repo at once")
    p.add_argument("--day", metavar="YYYY-MM-DD", help="the results day (default today, UTC)")
    p.add_argument("--dry-run", action="store_true", help="print the launches, start nothing")
    p = sub.add_parser("drain", help="keep review passes running from the config's queue")
    p.add_argument("--max", type=int, help="most passes at once (else config max_concurrent)")
    p.add_argument("--dry-run", action="store_true", help="print the launches, start nothing")
    p = sub.add_parser("plan", help="read the review queue and the cost history; start nothing")
    p.add_argument("--json", action="store_true", help="print JSON for an agent, not a table")
    p.add_argument("--fetch", action="store_true", help="have the queue read each repo's remote first")
    p = sub.add_parser("pass", help="one drain pass (drain starts these)")
    p.add_argument("repo"); p.add_argument("item"); p.add_argument("brief")
    p.add_argument("--dry-run", action="store_true", help="print the launch, start nothing")
    p = sub.add_parser("resume", help="finish a cut-off pass in its own session")
    p.add_argument("repo"); p.add_argument("worktree"); p.add_argument("session")
    p.add_argument("--prompt", required=True, metavar="FILE", help="prompt template")
    p.add_argument("--item", help="the queue item; released when the pass ends clean (queue.release_on)")
    p.add_argument("--set", action="append", default=[], metavar="K=V", help="fill {K} in the template")
    a = ap.parse_args(argv)
    if a.doc:
        print(__doc__)
        return 0
    if not a.cmd:
        ap.print_help()
        return EXIT_USAGE
    try:
        cfg = load_config(a.config)
        common = (["--config", a.config] if a.config else []) + ["--by", a.by]
        sets = parse_sets(getattr(a, "set", []) or [])
        max_n = getattr(a, "max", None)
        if max_n is not None and max_n < 0:
            raise Refusal(EXIT_USAGE, "--max must be 0 or more")
        if max_n is None:
            max_n = cfg["max_concurrent"]  # --max 0 is a ceiling of 0, never the config's
        if a.cmd == "check":
            return check(cfg, [expand(t) for t in a.prompt], sets)
        if a.cmd == "gate":
            reading = read_headroom(cfg)
            ok = gate_ok(cfg["gate"], reading)
            print(f"{'go' if ok else 'hold'}: {describe(reading)} (gate {cfg['gate']})")
            return 0 if ok else 1
        if a.cmd == "run":
            post = None
            if a.item:
                if not a.existing:
                    raise Refusal(EXIT_USAGE, "--item needs --in: it puts away an adopted worktree (a fold)")
                if not cfg.get("queue") or "release" not in cfg["queue"]:
                    raise Refusal(EXIT_USAGE, "--item needs queue.release in the config")
                post = lambda values, result, sid, log: ended_hooks(cfg, values, result, sid, log, a.item, "")
                # The fold gets the pass's own item and review log, as a resume does.
                check_repo_name(a.repo)
                sets.setdefault("ITEM", a.item)
                sets.setdefault("REVIEW_LOG", pass_log(cfg, a.repo, a.item))
            # A fold's result is its pass's own file (label <repo>-<item>), so
            # two folds in one repo never write one file (RK6).
            label = a.label or (safe(f"{a.repo}-{a.item}") if a.item else None)
            return run_one(cfg, a.repo, a.prompt, label=label, model=a.model, extra=sets, by=a.by,
                           dry=a.dry_run, keep=a.keep, existing=a.existing, post=post,
                           remove_adopted=bool(a.item), item=a.item)[0]
        if a.cmd == "drive":
            if a.day and not re.fullmatch(r"\d{4}-\d{2}-\d{2}", a.day):
                raise Refusal(EXIT_USAGE, f"--day must be YYYY-MM-DD, not {a.day!r}")
            jobs = read_jobs(a.jobs)  # refused before the lock or any start
            with DriverLock(cfg["kit_dir"]):
                drive(cfg, jobs, common, max_n, a.serial_per_repo, a.dry_run, a.day)
            return 0
        if a.cmd == "drain":
            with DriverLock(cfg["kit_dir"]):
                return drain(cfg, common, max_n, a.dry_run)
        if a.cmd == "plan":
            data = plan_reading(cfg, fetch=a.fetch)
            print(json.dumps(data, indent=2, ensure_ascii=False) if a.json else "\n".join(plan_text(data)))
            return 0
        if a.cmd == "pass":
            return one_pass(cfg, a.repo, a.item, a.brief, a.by, a.dry_run)
        if a.cmd == "resume":
            return resume(cfg, a.repo, expand(a.worktree), a.session, a.prompt, a.item, sets, a.by)
    except Refusal as e:
        print(f"ccfleet: {e}", file=sys.stderr)
        return e.code
    return EXIT_USAGE


if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    sys.exit(main())
